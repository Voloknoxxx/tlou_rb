string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX83"><Properties><string name="Name">TLoU</string></Properties><Item class="Folder" referent="RBX82"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">Config</string><ProtectedString name="Source">--!strict
--[[
	Config
	Central tuning table for the TLoU-style mechanics pack.
	Every value here is data only - no logic - so designers can tweak
	feel without touching controllers.
]]

local Config = {}

-- Movement -------------------------------------------------------------
Config.Movement = {
	WalkSpeed = 14,
	RunSpeed = 22,
	CrouchSpeed = 7,
	ProneSpeed = 3,
	SprintSpeed = 24,

	JumpPower = 42,

	-- Stamina is a 0..100 resource.
	MaxStamina = 100,
	StaminaDrainSprint = 14, -- per second
	StaminaDrainJump = 12, -- flat cost
	StaminaRegen = 10, -- per second
	StaminaRegenDelay = 1.1, -- seconds after last drain
	ExhaustedThreshold = 5, -- cannot sprint below this

	-- Lean / peek
	LeanAngle = 18, -- degrees
	LeanSpeed = 9,
	LeanOffset = 1.4, -- studs sideways camera shift

	-- Vault / climb
	VaultMinHeight = 2.5,
	VaultMaxHeight = 7,
	VaultSpeed = 22,
	ClimbSpeed = 16,
}

-- Camera ---------------------------------------------------------------
Config.Camera = {
	ShoulderOffset = Vector3.new(1.6, 1.6, 0), -- right, up, forward
	AimOffset = Vector3.new(1.15, 1.35, 0),
	FOV = 78,
	AimFOV = 52,
	SprintFOV = 86,
	FOVLerp = 7,

	BobFrequency = 8.5,
	BobAmplitude = 0.14,
	SwayAmount = 0.55,
	SwaySmoothing = 6,

	RecoilKick = 1.5, -- degrees per shot
	RecoilRecovery = 9,
	MaxRecoil = 6,

	MinPitch = -80,
	MaxPitch = 80,
}

-- Combat ---------------------------------------------------------------
Config.Combat = {
	HeadshotMultiplier = 2.5,
	LimbMultiplier = 0.75,
	MaxRange = 400,

	HitScanStepStuds = 0.6, -- raycast resolution for hit verification
	FriendlyFire = false,

	BleedOutTime = 12,
	DownedHealth = 100,
	DownedReviveTime = 3.5,
	MaxHealth = 100,

	-- Noise made by actions, drives stealth AI interest
	Noise = {
		Walk = 8,
		Run = 26,
		Sprint = 40,
		Crouch = 2,
		Prone = 0,
		Gunshot = 120,
		Silenced = 18,
		Melee = 12,
	},
}

-- Inventory ------------------------------------------------------------
Config.Inventory = {
	MaxSlots = 4,
	MaxThrowables = 3,
	SwapTime = 0.45,
	DropOnDeath = true,
}

-- Input ----------------------------------------------------------------
Config.Keys = {
	Fire = Enum.UserInputType.MouseButton1,
	Aim = Enum.UserInputType.MouseButton2,
	Reload = Enum.KeyCode.R,
	Melee = Enum.KeyCode.F,
	Throw = Enum.KeyCode.G,
	Sprint = Enum.KeyCode.LeftShift,
	Crouch = Enum.KeyCode.LeftControl,
	Prone = Enum.KeyCode.Z,
	LeanLeft = Enum.KeyCode.Q,
	LeanRight = Enum.KeyCode.E,
	Swap = Enum.KeyCode.Tab,
	Heal = Enum.KeyCode.H,
}

-- Visual ---------------------------------------------------------------
Config.Visual = {
	MuzzleFlashTime = 0.045,
	TracerTime = 0.06,
	HitDecalLifetime = 12,
	BloodTime = 0.5,
	ShellEjectSpeed = 18,
	CameraShakeIntensity = 0.6,
}

return Config
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">Net</string><ProtectedString name="Source">--!strict
--[[
	Net
	Thin wrapper over a folder of RemoteEvents. The server creates them
	on demand; the client waits for them. This keeps the wire protocol in
	one place instead of scattered Instance lookups.
]]

local RunService = game:GetService(&quot;RunService&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local IS_SERVER = RunService:IsServer()

local EVENTS = {
	&quot;Ready&quot;, -- client -&gt; server: client finished loading, resend state
	&quot;Fire&quot;, -- client -&gt; server: request shot
	&quot;FireResult&quot;, -- server -&gt; client: confirmed shot (for tracer/recoil)
	&quot;Reload&quot;, -- client -&gt; server
	&quot;ReloadResult&quot;, -- server -&gt; client
	&quot;Swap&quot;, -- client -&gt; server
	&quot;SwapResult&quot;, -- server -&gt; client
	&quot;Melee&quot;, -- client -&gt; server
	&quot;Throw&quot;, -- client -&gt; server
	&quot;StateUpdate&quot;, -- client -&gt; server: movement state (crouch/lean/etc.)
	&quot;HitFeedback&quot;, -- server -&gt; client: damage numbers / hitmarker
	&quot;Health&quot;, -- server -&gt; client: health &amp; downed state
	&quot;Noise&quot;, -- server -&gt; client: noise ping for stealth UI
	&quot;Effect&quot;, -- server -&gt; all: cosmetic effect request
	&quot;Inventory&quot;, -- server -&gt; client: authoritative inventory sync
	&quot;Heal&quot;, -- client -&gt; server
}

local Net = {}

local folder: Folder

if IS_SERVER then
	folder = ReplicatedStorage:FindFirstChild(&quot;TLoUNet&quot;) :: Folder
	if not folder then
		folder = Instance.new(&quot;Folder&quot;)
		folder.Name = &quot;TLoUNet&quot;
		folder.Parent = ReplicatedStorage
	end

	for _, name in ipairs(EVENTS) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new(&quot;RemoteEvent&quot;)
			remote.Name = name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild(&quot;TLoUNet&quot;) :: Folder
end

function Net.get(name: string): RemoteEvent
	local remote = folder:WaitForChild(name, 10)
	assert(remote, &quot;Missing RemoteEvent: &quot; .. name)
	return remote :: RemoteEvent
end

-- Convenience: server -&gt; one player
function Net.toPlayer(player: Player, name: string, ...)
	Net.get(name):FireClient(player, ...)
end

-- Convenience: server -&gt; everyone
function Net.toAll(name: string, ...)
	Net.get(name):FireAllClients(...)
end

-- Convenience: client -&gt; server
function Net.toServer(name: string, ...)
	Net.get(name):FireServer(...)
end

return Net
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Util</string><ProtectedString name="Source">--!strict
--[[
	Util
	Shared helpers used by both server and client controllers.
]]

local Players = game:GetService(&quot;Players&quot;)

local Util = {}

local HEAD_NAMES = { Head = true }
local LIMB_NAMES = { [&quot;Left Arm&quot;] = true, [&quot;Right Arm&quot;] = true, [&quot;Left Leg&quot;] = true, [&quot;Right Leg&quot;] = true, [&quot;LeftHand&quot;] = true, [&quot;RightHand&quot;] = true, [&quot;LeftFoot&quot;] = true, [&quot;RightFoot&quot;] = true }

--- Returns the body-part category for a hit part: &quot;Head&quot; | &quot;Limb&quot; | &quot;Torso&quot;
function Util.partCategory(part: BasePart): string
	local name = part.Name
	if HEAD_NAMES[name] then
		return &quot;Head&quot;
	elseif LIMB_NAMES[name] then
		return &quot;Limb&quot;
	end
	return &quot;Torso&quot;
end

--- Applies the right damage multiplier for a hit location.
function Util.locationMultiplier(part: BasePart, headMul: number, limbMul: number): number
	local cat = Util.partCategory(part)
	if cat == &quot;Head&quot; then
		return headMul
	elseif cat == &quot;Limb&quot; then
		return limbMul
	end
	return 1
end

--- Walks up from an instance to the player who owns the character, if any.
function Util.playerFromPart(part: BasePart?): (Player?, Model?)
	if not part then
		return nil, nil
	end
	local character = part:FindFirstAncestorOfClass(&quot;Model&quot;)
	while character do
		local humanoid = character:FindFirstChildOfClass(&quot;Humanoid&quot;)
		if humanoid then
			local player = Players:GetPlayerFromCharacter(character)
			return player, character
		end
		character = character:FindFirstAncestorOfClass(&quot;Model&quot;)
	end
	return nil, nil
end

--- Deep-copies a table (arrays/maps of primitives and nested tables).
function Util.deepCopy&lt;T&gt;(source: T): T
	if type(source) ~= &quot;table&quot; then
		return source
	end
	local copy = {}
	for key, value in pairs(source :: any) do
		copy[key] = Util.deepCopy(value)
	end
	return copy :: T
end

--- Linearly interpolates between two Vector3s.
function Util.lerpVector(a: Vector3, b: Vector3, alpha: number): Vector3
	return a + (b - a) * alpha
end

--- Frame-rate independent smoothing factor.
function Util.damp(deltaTime: number, speed: number): number
	return 1 - math.exp(-speed * deltaTime)
end

--- Clamps a number between min and max.
function Util.clamp(value: number, min: number, max: number): number
	return math.max(min, math.min(max, value))
end

--- Converts a mouse/keyboard keycode list into a readable prompt.
function Util.keyLabel(key: Enum.KeyCode): string
	return key.Name
end

return Util
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">WeaponModels</string><ProtectedString name="Source">--!strict
--[[
	WeaponModels
	Builds every weapon out of plain Parts at runtime. No imported meshes,
	no asset ids - so the pack drops into any place and works immediately.
	The same builder is used for the client viewmodel and for any world
	models (dropped weapons, NPC gear), which keeps them consistent.

	Each weapon is assembled from named segments so the animation code can
	find the muzzle, the bolt/slide, the magazine, and the grip.
]]

local Weapons = require(script.Parent.Weapons)

local WeaponModels = {}

local function part(
	name: string,
	size: Vector3,
	cframe: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local p = Instance.new(&quot;Part&quot;)
	p.Name = name
	p.Size = size
	p.CFrame = cframe
	p.Color = color
	p.Material = material or Enum.Material.Metal
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanQuery = false
	p.Massless = true
	return p
end

local function weldTo(model: Model, child: BasePart, parent: BasePart, offset: CFrame)
	child.CFrame = parent.CFrame * offset
	local weld = Instance.new(&quot;WeldConstraint&quot;)
	weld.Part0 = parent
	weld.Part1 = child
	weld.Parent = child
end

--- Creates a barrel along the -Z axis of the weapon root.
local function addBarrel(root: Part, length: number, radius: number, color: Color3, suppressor: boolean)
	local barrel = part(&quot;Barrel&quot;, Vector3.new(radius * 2, radius * 2, length), CFrame.new(0, 0, -length / 2), color, Enum.Material.Metal)
	weldTo(root.Parent :: Model, barrel, root, CFrame.new(0, 0, -length / 2))
	barrel.CFrame = root.CFrame * CFrame.new(0, 0, -length / 2)

	if suppressor then
		local can = part(
			&quot;Suppressor&quot;,
			Vector3.new(radius * 3.2, radius * 3.2, length * 0.42),
			root.CFrame * CFrame.new(0, 0, -(length + length * 0.21)),
			Color3.fromRGB(24, 24, 26),
			Enum.Material.Metal
		)
		can.Parent = root.Parent
		weldTo(root.Parent :: Model, can, root, CFrame.new(0, 0, -(length + length * 0.21)))
	end
end

local function addMuzzle(root: Part, data): Part
	local muzzle = Instance.new(&quot;Part&quot;)
	muzzle.Name = &quot;Muzzle&quot;
	muzzle.Size = Vector3.new(0.12, 0.12, 0.12)
	muzzle.Transparency = 1
	muzzle.CanCollide = false
	muzzle.CanQuery = false
	muzzle.Massless = true
	muzzle.Parent = root.Parent
	local visual = data.visual
	local z = -(visual.length * 0.5 + (visual.suppressor and visual.length * 0.42 or 0))
	weldTo(root.Parent :: Model, muzzle, root, CFrame.new(0, 0, z))
	return muzzle
end

local function addStock(root: Part, visual, color: Color3)
	if not visual.stock then
		return
	end
	local stock = part(
		&quot;Stock&quot;,
		Vector3.new(0.28, 0.36, visual.length * 0.42),
		CFrame.new(),
		color,
		visual.woodFurniture and Enum.Material.Wood or Enum.Material.Polymer
	)
	stock.Parent = root.Parent
	weldTo(root.Parent :: Model, stock, root, CFrame.new(0, -0.06, visual.length * 0.34))
end

local function addScope(root: Part, visual)
	if not visual.scope or visual.scope == &quot;none&quot; then
		return
	end
	local large = visual.scope == &quot;large&quot;
	local scope = part(
		&quot;Scope&quot;,
		Vector3.new(0.22, 0.22, large and 1.1 or 0.55),
		CFrame.new(),
		Color3.fromRGB(18, 18, 20),
		Enum.Material.Metal
	)
	scope.Parent = root.Parent
	weldTo(root.Parent :: Model, scope, root, CFrame.new(0, 0.32, -0.1))

	if large then
		local lens = part(&quot;Lens&quot;, Vector3.new(0.16, 0.16, 0.05), CFrame.new(), Color3.fromRGB(70, 140, 180), Enum.Material.Glass)
		lens.Transparency = 0.35
		lens.Parent = root.Parent
		weldTo(root.Parent :: Model, lens, scope, CFrame.new(0, 0, -0.55))
	end
end

local function addGrip(root: Part, visual, color: Color3)
	local grip = part(
		&quot;Grip&quot;,
		Vector3.new(0.22, 0.5, 0.26),
		CFrame.new(),
		color,
		visual.woodFurniture and Enum.Material.Wood or Enum.Material.Polymer
	)
	grip.Parent = root.Parent
	weldTo(root.Parent :: Model, grip, root, CFrame.new(0, -0.42, 0.12))

	local trigger = part(&quot;Trigger&quot;, Vector3.new(0.08, 0.16, 0.05), CFrame.new(), Color3.fromRGB(30, 30, 30), Enum.Material.Metal)
	trigger.Parent = root.Parent
	weldTo(root.Parent :: Model, trigger, root, CFrame.new(0, -0.28, 0.05))
end

local function addMagazine(root: Part, data, color: Color3): Part
	local visual = data.visual
	local mag = part(
		&quot;Magazine&quot;,
		Vector3.new(0.2, 0.55, 0.22),
		CFrame.new(),
		color,
		Enum.Material.Metal
	)
	mag.Parent = root.Parent
	weldTo(root.Parent :: Model, mag, root, CFrame.new(0, -0.5, 0.02))
	return mag
end

local function addSights(root: Part, visual)
	local rear = part(&quot;RearSight&quot;, Vector3.new(0.14, 0.08, 0.06), CFrame.new(), Color3.fromRGB(20, 20, 20), Enum.Material.Metal)
	rear.Parent = root.Parent
	weldTo(root.Parent :: Model, rear, root, CFrame.new(0, 0.2, 0.5))

	local front = part(&quot;FrontSight&quot;, Vector3.new(0.05, 0.1, 0.05), CFrame.new(), Color3.fromRGB(20, 20, 20), Enum.Material.Metal)
	front.Parent = root.Parent
	weldTo(root.Parent :: Model, front, root, CFrame.new(0, 0.2, -(visual.length * 0.42)))
end

local function addBolt(root: Part, data): Part
	local bolt = part(&quot;Bolt&quot;, Vector3.new(0.16, 0.16, 0.5), CFrame.new(), data.visual.accentColor, Enum.Material.Metal)
	bolt.Parent = root.Parent
	weldTo(root.Parent :: Model, bolt, root, CFrame.new(0.18, 0.08, 0.1))
	return bolt
end

--- Builds the model. Returns a Model with a &quot;Handle&quot; part (the root).
function WeaponModels.build(data): Model
	local visual = data.visual
	local model = Instance.new(&quot;Model&quot;)
	model.Name = &quot;Weapon_&quot; .. data.id

	local handle = part(
		&quot;Handle&quot;,
		Vector3.new(0.24, 0.3, visual.length),
		CFrame.new(),
		visual.bodyColor,
		visual.woodFurniture and Enum.Material.Wood or Enum.Material.Metal
	)
	handle.Parent = model

	model.PrimaryPart = handle

	if data.category == &quot;Melee&quot; then
		if data.model == &quot;Bat&quot; then
			local bat = part(&quot;Blade&quot;, Vector3.new(0.24, 0.24, visual.length), CFrame.new(), visual.bodyColor, Enum.Material.Wood)
			bat.Parent = model
			weldTo(model, bat, handle, CFrame.new(0, 0, -visual.length * 0.5))
			handle.Size = Vector3.new(0.22, 0.22, visual.length * 0.35)
		else
			local blade = part(&quot;Blade&quot;, Vector3.new(0.06, 0.34, visual.length * 0.62), CFrame.new(), visual.bodyColor, Enum.Material.Metal)
			blade.Parent = model
			weldTo(model, blade, handle, CFrame.new(0, 0.02, -visual.length * 0.45))
			local guard = part(&quot;Guard&quot;, Vector3.new(0.26, 0.08, 0.1), CFrame.new(), visual.accentColor, Enum.Material.Metal)
			guard.Parent = model
			weldTo(model, guard, handle, CFrame.new(0, 0, -visual.length * 0.18))
			handle.Size = Vector3.new(0.18, 0.18, visual.length * 0.5)
		end
	elseif data.category == &quot;Throwable&quot; then
		if data.model == &quot;Bottle&quot; then
			handle.Shape = Enum.PartType.Cylinder
			handle.Size = Vector3.new(visual.length, 0.32, 0.32)
			handle.Material = Enum.Material.Glass
			handle.Transparency = 0.35
			handle.Orientation = Vector3.new(0, 0, 90)
			local rag = part(&quot;Rag&quot;, Vector3.new(0.1, 0.1, 0.3), CFrame.new(), visual.accentColor, Enum.Material.Fabric)
			rag.Parent = model
			weldTo(model, rag, handle, CFrame.new(0, visual.length * 0.5, 0))
		elseif data.model == &quot;Canister&quot; then
			handle.Shape = Enum.PartType.Cylinder
			handle.Size = Vector3.new(visual.length, 0.34, 0.34)
			handle.Orientation = Vector3.new(0, 0, 90)
		else
			handle.Size = Vector3.new(0.5, 0.4, visual.length)
		end
	else
		-- Firearm
		if data.model == &quot;Revolver&quot; then
			local cylinder = part(&quot;Cylinder&quot;, Vector3.new(0.34, 0.34, 0.34), CFrame.new(), visual.bodyColor, Enum.Material.Metal)
			cylinder.Parent = model
			weldTo(model, cylinder, handle, CFrame.new(0, 0.02, 0.05))
		elseif data.model == &quot;Shotgun&quot; then
			addBarrel(handle, visual.length * 0.7, 0.09, visual.bodyColor, false)
			local pump = part(&quot;Pump&quot;, Vector3.new(0.3, 0.3, 0.5), CFrame.new(), visual.accentColor, Enum.Material.Wood)
			pump.Parent = model
			weldTo(model, pump, handle, CFrame.new(0, -0.14, -visual.length * 0.3))
		elseif data.model == &quot;Bow&quot; then
			local limb = part(&quot;Limb&quot;, Vector3.new(0.08, visual.length * 1.4, 0.14), CFrame.new(), visual.bodyColor, Enum.Material.Wood)
			limb.Parent = model
			weldTo(model, limb, handle, CFrame.new(0, 0, -0.2))
			local string = part(&quot;String&quot;, Vector3.new(0.02, visual.length * 1.35, 0.02), CFrame.new(), Color3.fromRGB(220, 220, 220), Enum.Material.SmoothPlastic)
			string.Parent = model
			weldTo(model, string, handle, CFrame.new(0, 0, 0.1))
		else
			local barrelLength = data.model == &quot;SMG&quot; and visual.length * 0.5 or visual.length * 0.62
			addBarrel(handle, barrelLength, 0.06, visual.bodyColor, visual.suppressor)
			addMagazine(handle, data, visual.accentColor)
			addSights(handle, visual)
			if data.fireMode == &quot;Bolt&quot; or data.fireMode == &quot;Auto&quot; then
				addBolt(handle, data)
			end
		end

		addStock(handle, visual, visual.accentColor)
		addScope(handle, visual)
		addGrip(handle, visual, visual.accentColor)
	end

	model:SetAttribute(&quot;WeaponId&quot;, data.id)
	model:SetAttribute(&quot;Category&quot;, data.category)

	-- Every weapon needs a Muzzle attachment for flash/tracer anchoring.
	local muzzle = addMuzzle(handle, data)
	muzzle:SetAttribute(&quot;IsMuzzle&quot;, true)

	-- The grip attachment is where the right hand sits.
	local gripAttachment = Instance.new(&quot;Attachment&quot;)
	gripAttachment.Name = &quot;GripAttachment&quot;
	gripAttachment.Position = Vector3.new(0, -0.42, 0.12)
	gripAttachment.Parent = handle

	local leftAttachment = Instance.new(&quot;Attachment&quot;)
	leftAttachment.Name = &quot;LeftGripAttachment&quot;
	leftAttachment.Position = Vector3.new(0, -0.2, -(data.visual.length * 0.3))
	leftAttachment.Parent = handle

	return model
end

--- Convenience: build a model for a weapon id.
function WeaponModels.buildById(id: string): Model?
	local data = Weapons.get(id)
	if not data then
		return nil
	end
	return WeaponModels.build(data)
end

return WeaponModels
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">Weapons</string><ProtectedString name="Source">--!strict
--[[
	Weapons
	Data table describing every weapon in the pack. The WeaponController
	and the procedural model builder both read from here, so adding a
	weapon is purely a data change.
]]

export type WeaponData = {
	id: string,
	name: string,
	category: string, -- &quot;Firearm&quot; | &quot;Melee&quot; | &quot;Throwable&quot;
	model: string, -- procedural model key

	damage: number,
	fireMode: string, -- &quot;Auto&quot; | &quot;Semi&quot; | &quot;Bolt&quot; | &quot;Pump&quot;
	rpm: number,
	magazine: number,
	reserveMax: number,
	reloadTime: number,
	bulletSpread: number, -- degrees at hip
	aimSpread: number, -- degrees when aiming
	recoil: number,
	range: number,
	pellets: number, -- &gt;1 for shotguns
	silenced: boolean,

	adsTime: number,
	raiseTime: number,

	-- Procedural visual parameters
	visual: {
		bodyColor: Color3,
		accentColor: Color3,
		length: number,
		stock: boolean,
		scope: string?, -- &quot;none&quot; | &quot;small&quot; | &quot;large&quot;
		suppressor: boolean,
		woodFurniture: boolean,
	},

	-- Melee only
	meleeSwing: number?,
	meleeDamage: number?,
	meleeRange: number?,
}

local Weapons: { [string]: WeaponData } = {}

local function gun(partial): WeaponData
	return partial :: any
end

-- Firearms ------------------------------------------------------------
Weapons.Pistol = gun({
	id = &quot;Pistol&quot;,
	name = &quot;9mm Pistol&quot;,
	category = &quot;Firearm&quot;,
	model = &quot;Pistol&quot;,
	damage = 24,
	fireMode = &quot;Semi&quot;,
	rpm = 340,
	magazine = 12,
	reserveMax = 60,
	reloadTime = 1.6,
	bulletSpread = 1.4,
	aimSpread = 0.25,
	recoil = 0.9,
	range = 250,
	pellets = 1,
	silenced = false,
	adsTime = 0.18,
	raiseTime = 0.4,
	visual = {
		bodyColor = Color3.fromRGB(38, 38, 40),
		accentColor = Color3.fromRGB(120, 96, 64),
		length = 1.5,
		stock = false,
		scope = &quot;none&quot;,
		suppressor = false,
		woodFurniture = true,
	},
})

Weapons.Revolver = gun({
	id = &quot;Revolver&quot;,
