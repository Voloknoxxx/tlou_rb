-- Helpers --------------------------------------------------------------
function Weapons.get(id: string): WeaponData?
	return Weapons[id]
end

function Weapons.isFirearm(data: WeaponData): boolean
	return data.category == &quot;Firearm&quot;
end

function Weapons.isMelee(data: WeaponData): boolean
	return data.category == &quot;Melee&quot;
end

function Weapons.isThrowable(data: WeaponData): boolean
	return data.category == &quot;Throwable&quot;
end

function Weapons.defaultLoadout(): { string }
	return { &quot;Pistol&quot;, &quot;HuntingRifle&quot;, &quot;Machete&quot;, &quot;Molotov&quot; }
end

return Weapons
</ProtectedString></Properties></Item></Item></Item></Item><Item class="ServerScriptService" referent="RBX92"><Properties><string name="Name">ServerScriptService</string></Properties><Item class="Folder" referent="RBX91"><Properties><string name="Name">TLoU</string></Properties><Item class="Folder" referent="RBX90"><Properties><string name="Name">Server</string></Properties><Item class="Folder" referent="RBX13"><Properties><string name="Name">Modules</string></Properties><Item class="ModuleScript" referent="RBX8"><Properties><string name="Name">CombatService</string><ProtectedString name="Source">--!strict
--[[
	CombatService
	Authoritative gunplay. The client asks to fire; the server validates
	cooldown, ammo, and the raycast, then applies damage and broadcasts the
	result so every client can render a matching tracer and impact.

	Hit verification walks the ray in small steps and only accepts hits
	whose surface normal faces the shooter, which blocks the classic
	&quot;shoot through a wall corner&quot; exploit.
]]

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local TLoU = ReplicatedStorage:WaitForChild(&quot;TLoU&quot;)
local Shared = TLoU:WaitForChild(&quot;Shared&quot;)

local Config = require(Shared.Config)
local Weapons = require(Shared.Weapons)
local Net = require(Shared.Net)
local Util = require(Shared.Util)

local CombatService = {}

-- player -&gt; last shot timestamp (server clock)
local lastShotAt: { [Player]: number } = {}
-- player -&gt; ammo in magazine
local magazines: { [Player]: { [string]: number } } = {}
-- player -&gt; downed state
local downed: { [Player]: boolean } = {}
-- player -&gt; health (we manage our own, detached from Humanoid.Health)
local health: { [Player]: number } = {}
-- player -&gt; busy flag (reloading/swapping)
local busy: { [Player]: boolean } = {}
-- player -&gt; current weapon id (authoritative)
local equipped: { [Player]: string } = {}

local RNG = Random.new()

local function now(): number
	return os.clock()
end

local function getCharacterParts(character: Model): { BasePart }
	local parts = {}
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA(&quot;BasePart&quot;) then
			table.insert(parts, descendant)
		end
	end
	return parts
end

--- Raycast that ignores the shooter's own character and any accessory parts.
local function castShot(origin: Vector3, direction: Vector3, range: number, ignoreList: { Instance })
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = ignoreList
	params.IgnoreWater = true

	return workspace:Raycast(origin, direction * range, params)
end

--- Verifies a hit is legitimate by stepping the ray and confirming the
--- first blocking surface faces the shooter.
local function verifyHit(origin: Vector3, targetPosition: Vector3, ignoreList: { Instance }): RaycastResult?
	local delta = targetPosition - origin
	local distance = delta.Magnitude
	if distance &lt; 0.01 then
		return nil
	end

	local direction = delta.Unit
	local steps = math.max(1, math.ceil(distance / Config.Combat.HitScanStepStuds))
	local step = distance / steps

	local previous = origin
	for i = 1, steps do
		local point = origin + direction * (step * i)
		local result = castShot(previous, (point - previous).Unit, (point - previous).Magnitude, ignoreList)
		if result then
			return result
		end
		previous = point
	end

	return nil
end

--- Emits a noise ping so stealth-aware listeners (AI, HUD) can react.
local function emitNoise(position: Vector3, radius: number, source: Player)
	Net.toAll(&quot;Noise&quot;, position, radius, source.UserId)
end

function CombatService.init()
	Net.get(&quot;Fire&quot;).OnServerEvent:Connect(function(player: Player, payload)
		CombatService.handleFire(player, payload)
	end)

	Net.get(&quot;Reload&quot;).OnServerEvent:Connect(function(player: Player, weaponId)
		CombatService.handleReload(player, weaponId)
	end)

	Net.get(&quot;Swap&quot;).OnServerEvent:Connect(function(player: Player, weaponId)
		CombatService.handleSwap(player, weaponId)
	end)

	Net.get(&quot;Melee&quot;).OnServerEvent:Connect(function(player: Player, payload)
		CombatService.handleMelee(player, payload)
	end)

	Net.get(&quot;Throw&quot;).OnServerEvent:Connect(function(player: Player, payload)
		CombatService.handleThrow(player, payload)
	end)

	Net.get(&quot;Heal&quot;).OnServerEvent:Connect(function(player: Player)
		CombatService.handleHeal(player)
	end)

	-- The client announces when it is ready and asks for a fresh copy of
	-- its state. This covers the race where the server granted the
	-- loadout before the client had connected its listeners.
	Net.get(&quot;Ready&quot;).OnServerEvent:Connect(function(player: Player)
		CombatService.sendState(player)
	end)

	Players.PlayerAdded:Connect(function(player)
		CombatService.registerPlayer(player)
	end)

	for _, player in ipairs(Players:GetPlayers()) do
		CombatService.registerPlayer(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		lastShotAt[player] = nil
		magazines[player] = nil
		downed[player] = nil
		health[player] = nil
		busy[player] = nil
		equipped[player] = nil
	end)
end

--- Records which weapon a player is holding on their character, as an
--- attribute. Attributes replicate to every client and are replayed to late
--- joiners, so in third person everyone builds the right model in the right
--- hand without any custom networking.
function CombatService.broadcastEquipped(player: Player)
	local character = player.Character
	if character then
		character:SetAttribute(&quot;EquippedWeapon&quot;, equipped[player])
	end
end

function CombatService.registerPlayer(player: Player)
	magazines[player] = {}
	health[player] = Config.Combat.MaxHealth
	downed[player] = false
	busy[player] = false

	-- Reserve ammo lives in an &quot;Ammo&quot; folder of IntValues under the player.
	local backpack = Instance.new(&quot;Folder&quot;)
	backpack.Name = &quot;Ammo&quot;
	backpack.Parent = player

	local loadout = Weapons.defaultLoadout()
	for _, id in ipairs(loadout) do
		local data = Weapons.get(id)
		if data then
			magazines[player][id] = data.magazine
			CombatService.getReserve(player, id)
		end
	end
	equipped[player] = loadout[1]

	-- Tell every client what this player is holding. In third person the
	-- weapon is welded to the character's arm, so every client must build
	-- the right model in the right hand.
	CombatService.broadcastEquipped(player)

	-- Reset health/ammo every time the character respawns, so a player
	-- who was downed and bled out comes back clean.
	player.CharacterAdded:Connect(function(character)
		character:SetAttribute(&quot;EquippedWeapon&quot;, equipped[player])
		task.wait(0.35)
		CombatService.onRespawn(player)
	end)

	CombatService.sendState(player)
end

--- Resets a player's combat state after a respawn.
function CombatService.onRespawn(player: Player)
	health[player] = Config.Combat.MaxHealth
	downed[player] = false
	busy[player] = false

	local loadout = Weapons.defaultLoadout()
	for _, id in ipairs(loadout) do
		local data = Weapons.get(id)
		if data then
			magazines[player][id] = data.magazine
			local reserve = CombatService.getReserve(player, id)
			reserve.Value = math.max(reserve.Value, data.reserveMax)
		end
	end
	equipped[player] = loadout[1]
	CombatService.broadcastEquipped(player)

	CombatService.sendState(player)
end

--- Sends the full authoritative inventory + health to one player.
function CombatService.sendState(player: Player)
	if not magazines[player] then
		return
	end
	Net.toPlayer(player, &quot;Inventory&quot;, {
		slots = Weapons.defaultLoadout(),
		magazines = magazines[player],
		reserves = CombatService.buildReserves(player),
		equipped = equipped[player],
	})
	Net.toPlayer(player, &quot;Health&quot;, health[player] or Config.Combat.MaxHealth, downed[player] == true)
end

function CombatService.buildReserves(player: Player): { [string]: number }
	local reserves = {}
	local backpack = player:FindFirstChild(&quot;Ammo&quot;)
	if not backpack then
		return reserves
	end
	for _, child in ipairs(backpack:GetChildren()) do
		reserves[child.Name] = child.Value
	end
	return reserves
end

function CombatService.getReserve(player: Player, weaponId: string): IntValue
	local backpack = player:FindFirstChild(&quot;Ammo&quot;)
	if not backpack then
		backpack = Instance.new(&quot;Folder&quot;)
		backpack.Name = &quot;Ammo&quot;
		backpack.Parent = player
	end
	local value = backpack:FindFirstChild(weaponId)
	if not value then
		local data = Weapons.get(weaponId)
		value = Instance.new(&quot;IntValue&quot;)
		value.Name = weaponId
		value.Value = data and data.reserveMax or 0
		value.Parent = backpack
	end
	return value :: IntValue
end

function CombatService.isDowned(player: Player): boolean
	return downed[player] == true
end

function CombatService.handleFire(player: Player, payload)
	if downed[player] then
		return
	end

	local character = player.Character
	if not character then
		return
	end
	local humanoid = character:FindFirstChildOfClass(&quot;Humanoid&quot;)
	local root = character:FindFirstChild(&quot;HumanoidRootPart&quot;) :: BasePart?
	local head = character:FindFirstChild(&quot;Head&quot;) :: BasePart?
	if not humanoid or not root or not head then
		return
	end

	local weaponId = payload and payload.weapon
	local data = weaponId and Weapons.get(weaponId)
	if not data or not Weapons.isFirearm(data) then
		return
	end
	if equipped[player] ~= weaponId then
		return -- client claims a weapon it does not have equipped
	end

	local interval = 60 / data.rpm
	if now() - (lastShotAt[player] or 0) &lt; interval then
		return -- fired faster than the weapon allows
	end

	local mag = magazines[player] and magazines[player][weaponId]
	if not mag or mag &lt;= 0 then
		return
	end

	if busy[player] then
		return
	end

	lastShotAt[player] = now()
	magazines[player][weaponId] = mag - 1

	local origin = payload.origin :: Vector3
	local direction = payload.direction :: Vector3
	if typeof(origin) ~= &quot;Vector3&quot; or typeof(direction) ~= &quot;Vector3&quot; then
		return
	end

	-- Guard against absurd client-supplied origins (anti-teleport-shot).
	if (origin - head.Position).Magnitude &gt; 12 then
		origin = head.Position
	end
	direction = direction.Unit

	local ignore = getCharacterParts(character)
	local hitPlayers: { [Player]: boolean } = {}
	local impacts = {}

	local pellets = math.max(1, data.pellets)
	for _ = 1, pellets do
		local spread = math.rad(data.bulletSpread)
		local jitter = Vector3.new(RNG:NextNumber(-spread, spread), RNG:NextNumber(-spread, spread), 0)
		local shotDirection = (direction + jitter).Unit

		local result = verifyHit(origin, origin + shotDirection * data.range, ignore)
		if result then
			local hitPlayer, hitCharacter = Util.playerFromPart(result.Instance :: BasePart)
			table.insert(impacts, {
				position = result.Position,
				normal = result.Normal,
				material = result.Material,
				character = hitPlayer ~= nil,
			})

			if hitPlayer and hitCharacter and hitPlayer ~= player then
				if Config.Combat.FriendlyFire or hitPlayer.Team ~= player.Team then
					local multiplier = Util.locationMultiplier(
						result.Instance :: BasePart,
						Config.Combat.HeadshotMultiplier,
						Config.Combat.LimbMultiplier
					)
					local damage = data.damage * multiplier
					CombatService.applyDamage(hitPlayer, player, damage, result.Instance :: BasePart)
					hitPlayers[hitPlayer] = true
				end
			end
		end
	end

	Net.toAll(&quot;FireResult&quot;, player, {
		weapon = weaponId,
		origin = origin,
		direction = direction,
		impacts = impacts,
		silenced = data.silenced,
		hit = next(hitPlayers) ~= nil,
	})

	emitNoise(
		origin,
		data.silenced and Config.Combat.Noise.Silenced or Config.Combat.Noise.Gunshot,
		player
	)
end

function CombatService.applyDamage(victim: Player, attacker: Player?, amount: number, hitPart: BasePart?)
	if downed[victim] then
		return
	end

	health[victim] = math.max(0, (health[victim] or Config.Combat.MaxHealth) - amount)
	Net.toPlayer(victim, &quot;Health&quot;, health[victim], false)

	if attacker then
		Net.toPlayer(attacker, &quot;HitFeedback&quot;, {
			hitPart = hitPart and Util.partCategory(hitPart) or &quot;Torso&quot;,
			amount = amount,
			lethal = health[victim] &lt;= 0,
			victim = victim.UserId,
		})
	end

	if health[victim] &lt;= 0 then
		CombatService.downPlayer(victim)
	end
end

function CombatService.downPlayer(player: Player)
	downed[player] = true
	Net.toPlayer(player, &quot;Health&quot;, 0, true)
	Net.toAll(&quot;Effect&quot;, &quot;Downed&quot;, player.Character)

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass(&quot;Humanoid&quot;)
	if humanoid then
		humanoid.WalkSpeed = 0
		humanoid.JumpPower = 0
	end
	-- MovementService reads this to keep the player frozen.
	if character then
		character:SetAttribute(&quot;Downed&quot;, true)
	end

	-- Bleed out timer; a revive or heal can cancel it.
	task.delay(Config.Combat.BleedOutTime, function()
		if downed[player] and player.Parent then
			CombatService.killPlayer(player)
		end
	end)
end

function CombatService.revivePlayer(player: Player)
	downed[player] = false
	health[player] = math.max(Config.Combat.MaxHealth * 0.35, 25)

	local character = player.Character
	if character then
		character:SetAttribute(&quot;Downed&quot;, false)
	end
	local humanoid = character and character:FindFirstChildOfClass(&quot;Humanoid&quot;)
	if humanoid then
		humanoid.WalkSpeed = Config.Movement.WalkSpeed
		humanoid.JumpPower = Config.Movement.JumpPower
	end

	Net.toPlayer(player, &quot;Health&quot;, health[player], false)
end

function CombatService.killPlayer(player: Player)
	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass(&quot;Humanoid&quot;)
	if humanoid then
		humanoid.Health = 0
	end
	downed[player] = false
end

function CombatService.handleHeal(player: Player)
	-- A downed player can spend a heal to get back on their feet. This is
	-- the tension valve: you are not dead yet, but you must commit a
	-- resource and expose yourself for several seconds.
	if downed[player] then
		CombatService.revivePlayer(player)
	elseif (health[player] or Config.Combat.MaxHealth) &gt;= Config.Combat.MaxHealth then
		return
	end

	-- Heal over time, server-driven so it cannot be spammed.
	task.spawn(function()
		for _ = 1, 8 do
			if player.Parent == nil then
				return
			end
			local current = math.min(Config.Combat.MaxHealth, (health[player] or 0) + 6)
			health[player] = current
			Net.toPlayer(player, &quot;Health&quot;, current, downed[player])
			task.wait(0.35)
		end
	end)
end

function CombatService.handleReload(player: Player, weaponId: string)
	if downed[player] or busy[player] then
		return
	end
	local data = weaponId and Weapons.get(weaponId)
	if not data or not Weapons.isFirearm(data) or data.magazine &lt;= 0 then
		return
	end

	local mag = magazines[player] and magazines[player][weaponId] or 0
	if mag &gt;= data.magazine then
		return
	end

	local reserve = CombatService.getReserve(player, weaponId)
	if reserve.Value &lt;= 0 then
		return
	end

	busy[player] = true
	task.delay(data.reloadTime, function()
		busy[player] = false
		if not player.Parent or downed[player] then
			return
		end
		local needed = data.magazine - mag
		local taken = math.min(needed, reserve.Value)
		reserve.Value -= taken
		magazines[player][weaponId] = mag + taken

		Net.toPlayer(player, &quot;ReloadResult&quot;, weaponId, magazines[player][weaponId], reserve.Value)
	end)
end

function CombatService.handleSwap(player: Player, weaponId: string)
	if downed[player] then
		return
	end
	local data = weaponId and Weapons.get(weaponId)
	if not data then
		return
	end
	if equipped[player] == weaponId then
		return
	end

	equipped[player] = weaponId
	busy[player] = true
	task.delay(data.raiseTime, function()
		busy[player] = false
	end)
	Net.toPlayer(player, &quot;SwapResult&quot;, weaponId)
	CombatService.broadcastEquipped(player)
end

function CombatService.handleMelee(player: Player, payload)
	if downed[player] or busy[player] then
		return
	end
	local weaponId = payload and payload.weapon
	local data = weaponId and Weapons.get(weaponId)
	if not data or not Weapons.isMelee(data) then
		return
	end

	local character = player.Character
	local root = character and character:FindFirstChild(&quot;HumanoidRootPart&quot;) :: BasePart?
	local head = character and character:FindFirstChild(&quot;Head&quot;) :: BasePart?
	if not root or not head then
		return
	end

	local interval = 60 / data.rpm
	if now() - (lastShotAt[player] or 0) &lt; interval then
		return
	end
	lastShotAt[player] = now()

	busy[player] = true
	task.delay(data.meleeSwing or 0.5, function()
		busy[player] = false
	end)

	-- Cone check in front of the player.
	local origin = head.Position
	local look = root.CFrame.LookVector
	local range = data.meleeRange or 6
	local hitAny = false

	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and not downed[other] then
			local otherChar = other.Character
			local otherRoot = otherChar and otherChar:FindFirstChild(&quot;HumanoidRootPart&quot;) :: BasePart?
			if otherRoot then
				local toTarget = otherRoot.Position - origin
				if toTarget.Magnitude &lt;= range then
					local dot = look:Dot(toTarget.Unit)
					if dot &gt; 0.55 then -- roughly a 55 degree half-cone
						CombatService.applyDamage(other, player, data.meleeDamage or data.damage, otherRoot)
						hitAny = true
					end
				end
			end
		end
	end

	Net.toAll(&quot;Effect&quot;, &quot;Melee&quot;, character, weaponId, hitAny)
	emitNoise(origin, Config.Combat.Noise.Melee, player)
end

function CombatService.handleThrow(player: Player, payload)
	if downed[player] then
		return
	end
	local weaponId = payload and payload.weapon
	local data = weaponId and Weapons.get(weaponId)
	if not data or not Weapons.isThrowable(data) then
		return
	end

	local character = player.Character
	local head = character and character:FindFirstChild(&quot;Head&quot;) :: BasePart?
	if not head then
		return
	end

	-- The client is trusted only for the throw direction; the projectile
	-- itself is simulated server-side so damage is authoritative.
	local direction = (payload.direction :: Vector3)
	if typeof(direction) ~= &quot;Vector3&quot; then
		return
	end
	direction = direction.Unit

	local projectile = Instance.new(&quot;Part&quot;)
	projectile.Name = &quot;TLoUProjectile&quot;
	projectile.Shape = Enum.PartType.Ball
	projectile.Size = Vector3.new(0.7, 0.7, 0.7)
	projectile.CanCollide = true
	projectile.CanQuery = false
	projectile.Material = Enum.Material.SmoothPlastic
	projectile.Color = data.visual.bodyColor
	projectile.CFrame = CFrame.new(head.Position + direction * 2)
	projectile.Parent = workspace

	local velocity = direction * 55 + Vector3.new(0, 12, 0)
	local life = 4
	local start = now()
	local exploded = false

	-- The projectile is a real physical object, so Touched is the reliable
	-- way to detect what it lands on. It explodes on the first non-thrower
	-- contact or when its fuse runs out.
	local function detonate(position: Vector3)
		if exploded then
			return
		end
		exploded = true

		Net.toAll(&quot;Effect&quot;, &quot;Explosion&quot;, position, weaponId)
		projectile:Destroy()

		if data.damage &gt; 0 then
			for _, other in ipairs(Players:GetPlayers()) do
				if other ~= player then
					local otherChar = other.Character
					local otherRoot = otherChar and otherChar:FindFirstChild(&quot;HumanoidRootPart&quot;) :: BasePart?
					if otherRoot then
						local dist = (otherRoot.Position - position).Magnitude
						if dist &lt;= 12 then
							local falloff = 1 - (dist / 12)
							CombatService.applyDamage(other, player, data.damage * falloff, otherRoot)
						end
					end
				end
			end
		end

		emitNoise(position, 90, player)
	end

	projectile.Touched:Connect(function(other)
		if exploded or not other.Parent then
			return
		end
		local hitPlayer = Util.playerFromPart(other)
		if hitPlayer == player then
			return -- ignore the thrower's own body
		end
		detonate(projectile.Position)
	end)

	task.spawn(function()
		while not exploded and now() - start &lt; life do
			local dt = task.wait()
			if not projectile.Parent then
				return
			end
			velocity = velocity + Vector3.new(0, -workspace.Gravity * dt, 0)
			projectile.CFrame = CFrame.new(projectile.Position + velocity * dt)
		end
		if not exploded and projectile.Parent then
			detonate(projectile.Position)
		end
	end)
end

return CombatService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX9"><Properties><string name="Name">InventoryService</string><ProtectedString name="Source">--!strict
--[[
	InventoryService
	Owns the per-player slot list and hands starting gear to the server's
	weapon service. Kept separate from CombatService so loadout rules can
	change (survival mode, arena mode) without touching gunplay.
]]

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local TLoU = ReplicatedStorage:WaitForChild(&quot;TLoU&quot;)
local Shared = TLoU:WaitForChild(&quot;Shared&quot;)

local Config = require(Shared.Config)
local Weapons = require(Shared.Weapons)
local Net = require(Shared.Net)

local InventoryService = {}

-- player -&gt; ordered array of weapon ids
local inventories: { [Player]: { string } } = {}

function InventoryService.init()
	Players.PlayerAdded:Connect(function(player)
		InventoryService.grantLoadout(player)
	end)
	for _, player in ipairs(Players:GetPlayers()) do
		InventoryService.grantLoadout(player)
	end
	Players.PlayerRemoving:Connect(function(player)
		inventories[player] = nil
	end)
end

function InventoryService.grantLoadout(player: Player)
	local loadout = Weapons.defaultLoadout()
	inventories[player] = loadout
	Net.toPlayer(player, &quot;Inventory&quot;, {
		slots = loadout,
		equipped = loadout[1],
	})
end

function InventoryService.get(player: Player): { string }
	return inventories[player] or {}
end

function InventoryService.has(player: Player, weaponId: string): boolean
	local slots = inventories[player]
	if not slots then
		return false
	end
	for _, id in ipairs(slots) do
		if id == weaponId then
			return true
		end
	end
	return false
end

function InventoryService.add(player: Player, weaponId: string): boolean
	local slots = inventories[player]
	if not slots or not Weapons.get(weaponId) then
		return false
	end
	if #slots &gt;= Config.Inventory.MaxSlots then
		return false
	end
	table.insert(slots, weaponId)
	Net.toPlayer(player, &quot;Inventory&quot;, { slots = slots, added = weaponId })
	return true
end

return InventoryService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX10"><Properties><string name="Name">MovementService</string><ProtectedString name="Source">--!strict
--[[
	MovementService
	Server half of the movement system. The client owns the feel (sprint,
	crouch, lean, vault), but the server validates the expensive parts and
	keeps an authoritative record of each player's stance so other systems
	(stealth, noise, combat) can read it.

	Validation strategy: we never reject a stance outright, we just clamp
	it to what the player's current stats allow (e.g. no sprinting while
	exhausted, no proning in mid-air).
]]

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local TLoU = ReplicatedStorage:WaitForChild(&quot;TLoU&quot;)
local Shared = TLoU:WaitForChild(&quot;Shared&quot;)

local Config = require(Shared.Config)
local Net = require(Shared.Net)

local MovementService = {}

export type Stance = &quot;Stand&quot; | &quot;Crouch&quot; | &quot;Prone&quot;

export type MoveState = {
	stance: Stance,
	sprinting: boolean,
	lean: number, -- -1 left .. 1 right
	exhausted: boolean,
	stamina: number,
}

-- player -&gt; authoritative state
local states: { [Player]: MoveState } = {}

local STANCE_SPEEDS = {
	Stand = Config.Movement.WalkSpeed,
	Crouch = Config.Movement.CrouchSpeed,
	Prone = Config.Movement.ProneSpeed,
}

local function defaultState(): MoveState
	return {
		stance = &quot;Stand&quot;,
		sprinting = false,
		lean = 0,
		exhausted = false,
		stamina = Config.Movement.MaxStamina,
	}
end

function MovementService.init()
	Net.get(&quot;StateUpdate&quot;).OnServerEvent:Connect(function(player: Player, payload)
		MovementService.handleState(player, payload)
	end)

	local function registerPlayer(player: Player)
		states[player] = states[player] or defaultState()
		player.CharacterAdded:Connect(function(character)
			MovementService.applyToCharacter(player, character)
		end)
		if player.Character then
			MovementService.applyToCharacter(player, player.Character)
		end
	end

	Players.PlayerAdded:Connect(registerPlayer)
	for _, player in ipairs(Players:GetPlayers()) do
		registerPlayer(player)
	end

	Players.PlayerRemoving:Connect(function(player)
		states[player] = nil
	end)

	-- Periodic stamina reconciliation and movement noise emission. The
	-- client predicts stamina for responsiveness; the server is the source
	-- of truth and gently corrects drift. Movement noise is emitted here
	-- because it depends on the authoritative stance, not on client claims.
	task.spawn(function()
		while true do
			task.wait(0.5)
			for player, state in pairs(states) do
				local character = player.Character
				local humanoid = character and character:FindFirstChildOfClass(&quot;Humanoid&quot;)
				if humanoid then
					local drain = 0
					if state.sprinting and humanoid.MoveDirection.Magnitude &gt; 0.1 then
						drain = Config.Movement.StaminaDrainSprint * 0.5
					end
					state.stamina = math.clamp(state.stamina - drain + (drain == 0 and Config.Movement.StaminaRegen * 0.5 or 0), 0, Config.Movement.MaxStamina)
					state.exhausted = state.stamina &lt;= Config.Movement.ExhaustedThreshold
					if state.exhausted and state.sprinting then
						state.sprinting = false
					end

					-- Movement noise: how loud the player currently is.
					if humanoid.MoveDirection.Magnitude &gt; 0.1 and humanoid.FloorMaterial ~= Enum.Material.Air then
						local radius
						if state.stance == &quot;Prone&quot; then
							radius = Config.Combat.Noise.Prone
						elseif state.stance == &quot;Crouch&quot; then
							radius = Config.Combat.Noise.Crouch
						elseif state.sprinting then
							radius = Config.Combat.Noise.Sprint
						else
							radius = Config.Combat.Noise.Walk
						end
						if radius &gt; 0 then
							local root = character:FindFirstChild(&quot;HumanoidRootPart&quot;) :: BasePart?
							if root then
								Net.toAll(&quot;Noise&quot;, root.Position, radius, player.UserId)
							end
						end
					end
				end
			end
		end
	end)
end

function MovementService.applyToCharacter(player: Player, character: Model)
	local state = states[player] or defaultState()
	states[player] = state

	local humanoid = character:WaitForChild(&quot;Humanoid&quot;, 5) :: Humanoid?
	if not humanoid then
		return
	end

	-- The character's facing is driven by the camera controller, so the
	-- Humanoid's own auto-rotate must stay off to avoid the two fighting
	-- each other.
	humanoid.UseJumpPower = true
	humanoid.JumpPower = Config.Movement.JumpPower
	humanoid.AutoRotate = false
	humanoid.WalkSpeed = MovementService.speedFor(state)
end

function MovementService.speedFor(state: MoveState): number
	local base = STANCE_SPEEDS[state.stance] or Config.Movement.WalkSpeed
	if state.stance == &quot;Stand&quot; and state.sprinting and not state.exhausted then
		base = Config.Movement.SprintSpeed
	end
	return base
end

function MovementService.handleState(player: Player, payload)
	if typeof(payload) ~= &quot;table&quot; then
		return
	end
	local state = states[player]
	if not state then
		return
	end

	local character = player.Character
	local humanoid = character and character:FindFirstChildOfClass(&quot;Humanoid&quot;)
	if not humanoid then
		return
	end

	-- A downed player is frozen until revived or dead. CombatService marks
	-- the character with a &quot;Downed&quot; attribute so this module does not need
	-- a direct dependency on it.
	if character:GetAttribute(&quot;Downed&quot;) then
		humanoid.WalkSpeed = 0
		return
	end

	local requested = payload.stance
	if requested == &quot;Stand&quot; or requested == &quot;Crouch&quot; or requested == &quot;Prone&quot; then
		-- Cannot go prone in mid-air; fall back to crouch.
		if requested == &quot;Prone&quot; and humanoid.FloorMaterial == Enum.Material.Air then
			requested = &quot;Crouch&quot;
		end
		state.stance = requested
	end

	if typeof(payload.lean) == &quot;number&quot; then
		state.lean = math.clamp(payload.lean, -1, 1)
	end

	local wantsSprint = payload.sprinting == true
	state.sprinting = wantsSprint
		and state.stance == &quot;Stand&quot;
		and not state.exhausted
		and humanoid.MoveDirection.Magnitude &gt; 0.1

	-- The owning client drives WalkSpeed (it predicts stance changes every
	-- frame). We only clamp here so a modified client cannot move faster
	-- than its stance allows. Writing the exact value would fight the
	-- client's per-frame update and cause visible speed jitter.
	local maxSpeed = MovementService.speedFor(state)
	if humanoid.WalkSpeed &gt; maxSpeed + 1 then
		humanoid.WalkSpeed = maxSpeed
	end
end

function MovementService.getState(player: Player): MoveState?
	return states[player]
end

function MovementService.setStamina(player: Player, value: number)
	local state = states[player]
	if state then
		state.stamina = math.clamp(value, 0, Config.Movement.MaxStamina)
		state.exhausted = state.stamina &lt;= Config.Movement.ExhaustedThreshold
	end
end

return MovementService
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX11"><Properties><string name="Name">RigService</string><ProtectedString name="Source">--!strict
--[[
	RigService
	Guarantees every player spawns as a classic R6 character.

	The place itself is generated with R6 as the avatar type, so in a normal
	game this service has nothing to do. It exists for the cases where that
	is not enough:

	* The place setting can be overridden per experience, and a player who
	  joined an R15 experience first can carry an R15 body in.
	* Group places, Team Create sessions and cloned places routinely drift
	  away from the intended avatar type.

	So the rule here is simple: whatever arrives, the player leaves with an
	R6 body. We check the rig, and if it is not R6 we rebuild it in place,
	preserving position, velocity and health.

	We also disable the stock &quot;Animate&quot; script. It plays R15-style
	animation tracks that would fight our animator for control of the same
	Motor6Ds.
]]

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local TLoU = ReplicatedStorage:WaitForChild(&quot;TLoU&quot;)
local Shared = TLoU:WaitForChild(&quot;Shared&quot;)

local Config = require(Shared.Config)
local R6Rig = require(Shared.R6Rig)

local RigService = {}

local RIG = Config.Rig

--- Stops Roblox's default animation script from driving the joints.
local function disableDefaultAnimate(character: Model)
	if not RIG.DisableDefaultAnimate then
		return
	end
	local animate = character:FindFirstChild(&quot;Animate&quot;)
	if animate then
		animate:Destroy()
	end
	local animator = character:FindFirstChildOfClass(&quot;Animator&quot;)
	if animator then
		-- Our animator drives Motor6D.Transform. The Animator instance would
		-- keep any playing tracks alive and blend them into the same joints,
		-- so stop them.
		for _, track in ipairs(animator:GetPlayingAnimationTracks()) do
			track:Stop(0)
		end
	end
end

--- Applies R6 rules to a character that is already the right rig.
local function prepareR6(character: Model)
	disableDefaultAnimate(character)

	local humanoid = character:FindFirstChildOfClass(&quot;Humanoid&quot;)
	if humanoid then
		-- R6 keeps its feet on the floor through the part positions alone;
		-- a non-zero HipHeight would float the character.
		humanoid.HipHeight = 0
		humanoid.AutoRotate = false
		humanoid.UseJumpPower = true
		humanoid.JumpPower = Config.Movement.JumpPower
		humanoid.BreakJointsOnDeath = false
	end

	-- Hide accessories and layered clothing that assume an R15 body; on R6
	-- they float around the torso.
	for _, descendant in ipairs(character:GetDescendants()) do
		if descendant:IsA(&quot;Accessory&quot;) or descendant:IsA(&quot;Accoutrement&quot;) then
			descendant:Destroy()
		elseif descendant:IsA(&quot;Shirt&quot;) or descendant:IsA(&quot;Pants&quot;) or descendant:IsA(&quot;ShirtGraphic&quot;) then
			-- These are fine on R6; leave them.
			continue
		end
	end
end

--- Rebuilds a non-R6 character as R6 and hands the player the new body.
local function enforceR6(player: Player, character: Model): Model
	if R6Rig.isR6(character) then
		prepareR6(character)
		return character
	end

	local converted = R6Rig.convertToR6(character)
	if not converted then
		-- Could not convert (a body with no HumanoidRootPart, say). Leave
		-- the character alone rather than deleting it.
		return character
	end

	prepareR6(converted)
	player.Character = converted
	return converted
end

--- Sets the player's character to R6, however it arrives.
function RigService.setupCharacter(player: Player, character: Model)
	-- The rig can be assembled asynchronously, so wait for the Humanoid
	-- before deciding anything.
	local humanoid = character:WaitForChild(&quot;Humanoid&quot;, 5)
	if not humanoid then
		return
	end

	if RIG.ForceR6 then
		character = enforceR6(player, character)
	end

	-- Re-announce the character so controllers that bound to the old model
	-- pick up the new one. Setting player.Character already fires
	-- CharacterAdded, so this is only needed when the model did not change.
	character:SetAttribute(&quot;RigType&quot;, &quot;R6&quot;)
end

function RigService.init()
	if not RIG.ForceR6 then
		return
	end

	local function watch(player: Player)
		player.CharacterAdded:Connect(function(character)
			RigService.setupCharacter(player, character)
		end)
		if player.Character then
			RigService.setupCharacter(player, player.Character)
		end
	end

	Players.PlayerAdded:Connect(watch)
	for _, player in ipairs(Players:GetPlayers()) do
		watch(player)
	end
end

return RigService
</ProtectedString></Properties></Item></Item><Item class="Script" referent="RBX12"><Properties><string name="Name">Bootstrap</string><ProtectedString name="Source">--!strict
--[[
	Bootstrap (ServerScriptService)
	Wires the server services in dependency order and disables the
	default Roblox character controls that would fight our movement
	controller (camera-relative sprint, the built-in shift-to-sprint).

	Put this in ServerScriptService as a Script. It requires the sibling
	&quot;Modules&quot; folder placed next to it.
]]

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local StarterPlayer = game:GetService(&quot;StarterPlayer&quot;)

local TLoU = ReplicatedStorage:WaitForChild(&quot;TLoU&quot;)
local Shared = TLoU:WaitForChild(&quot;Shared&quot;)

local Net = require(Shared.Net)
local Config = require(Shared.Config)
local Weapons = require(Shared.Weapons)

local Modules = script.Parent:WaitForChild(&quot;Modules&quot;)
local CombatService = require(Modules:WaitForChild(&quot;CombatService&quot;))
local MovementService = require(Modules:WaitForChild(&quot;MovementService&quot;))
local InventoryService = require(Modules:WaitForChild(&quot;InventoryService&quot;))
local RigService = require(Modules:WaitForChild(&quot;RigService&quot;))

-- Turn off Roblox's default movement conveniences that conflict with ours.
StarterPlayer.EnableMouseLockOption = false
StarterPlayer.CharacterWalkSpeed = Config.Movement.WalkSpeed
StarterPlayer.CharacterJumpPower = Config.Movement.JumpPower
StarterPlayer.CameraMode = Enum.CameraMode.Classic
-- The pack animates and controls the character itself, so Roblox's
-- auto-loaded character appearance (R15 avatars, layered clothing) is off.
StarterPlayer.LoadCharacterAppearance = false

-- Start the services. RigService goes first: it guarantees an R6 body
-- before anything else looks at the character's parts.
RigService.init()
InventoryService.init()
MovementService.init()
CombatService.init()

-- We run our own health model (so players enter a &quot;downed&quot; state instead
-- of dying instantly). Give the Humanoid a huge pool so only our explicit
-- kill call can ever trigger Died, and hide the default health bar.
local StarterGui = game:GetService(&quot;StarterGui&quot;)
pcall(function()
	StarterGui:SetCoreGuiEnabled(Enum.CoreGuiType.Health, false)
end)

local HUMAN_DUMMY_HEALTH = 1e6

Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(character)
		local humanoid = character:WaitForChild(&quot;Humanoid&quot;, 5) :: Humanoid?
		if humanoid then
			humanoid.MaxHealth = HUMAN_DUMMY_HEALTH
			humanoid.Health = HUMAN_DUMMY_HEALTH
			humanoid.BreakJointsOnDeath = false
			humanoid.HealthDisplayDistance = 0
			humanoid.NameDisplayDistance = 0
		end
		task.wait(0.5)
		Net.toPlayer(player, &quot;Health&quot;, Config.Combat.MaxHealth, false)
	end)
end)

-- Simple visual: dropped weapons stay in the world briefly on death.
Players.PlayerAdded:Connect(function(player)
	player.CharacterAdded:Connect(function(character)
		local humanoid = character:WaitForChild(&quot;Humanoid&quot;, 5) :: Humanoid?
		if not humanoid then
			return
		end
		humanoid.Died:Connect(function()
			if Config.Inventory.DropOnDeath then
				local root = character:FindFirstChild(&quot;HumanoidRootPart&quot;) :: BasePart?
				if root then
					local model = Instance.new(&quot;Model&quot;)
					model.Name = &quot;DroppedWeapon&quot;
					model.Parent = workspace
					local drop = Instance.new(&quot;Part&quot;)
					drop.Size = Vector3.new(1.5, 0.4, 0.4)
					drop.Color = Color3.fromRGB(40, 40, 44)
					drop.Material = Enum.Material.Metal
					drop.CanCollide = true
					drop.CFrame = root.CFrame * CFrame.new(0, 0, -2)
					drop.Parent = model
					model.PrimaryPart = drop
					task.delay(30, function()
						model:Destroy()
					end)
				end
			end
		end)
	end)
end)

print(&quot;[TLoU] Server mechanics online.&quot;)
</ProtectedString></Properties></Item></Item></Item></Item><Item class="StarterPlayer" referent="RBX96"><Properties><string name="Name">StarterPlayer</string><bool name="EnableMouseLockOption">false</bool><float name="CharacterWalkSpeed">14</float><float name="CharacterJumpPower">42</float><token name="CameraMode">0</token><float name="CameraMaxZoomDistance">0.5</float><float name="CameraMinZoomDistance">0.5</float><token name="GameSettingsAvatar">0</token><bool name="LoadCharacterAppearance">false</bool></Properties><Item class="StarterPlayerScripts" referent="RBX95"><Properties><string name="Name">StarterPlayerScripts</string></Properties><Item class="Folder" referent="RBX94"><Properties><string name="Name">TLoU</string></Properties><Item class="Folder" referent="RBX93"><Properties><string name="Name">Client</string></Properties><Item class="Folder" referent="RBX25"><Properties><string name="Name">Controllers</string></Properties><Item class="ModuleScript" referent="RBX14"><Properties><string name="Name">AnimatorController</string><ProtectedString name="Source">--!strict
--[[
	AnimatorController
	Applies the AnimationSystem's poses to real R6 rigs.

	Motor6D.Transform does not replicate, so every client has to run the
	same maths for every character it can see. This controller therefore
	tracks *all* characters in the workspace, not just the local one:

	* Speed and turn rate are derived from each character's own parts, which
	  every client can see, so remote characters animate correctly with no
	  extra network traffic. Deriving speed from real displacement (rather
	  than Humanoid.WalkSpeed) is also what keeps the feet from skating.
	* The richer states (stance, aiming, vaulting, downed, sprinting) are
	  broadcast as attributes on the character, which replicate for free.

	The local player is animated exactly like everyone else, so there is no
	special case that can drift out of sync.
]]

local Players = game:GetService(&quot;Players&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local TLoU = ReplicatedStorage:WaitForChild(&quot;TLoU&quot;)
local Shared = TLoU:WaitForChild(&quot;Shared&quot;)

local Config = require(Shared.Config)
local R6Rig = require(Shared.R6Rig)
local AnimationSystem = require(Shared.AnimationSystem)

local State = require(script.Parent.State)

local AnimatorController = {}

local player = Players.LocalPlayer
local ANIM = Config.Animation

type Tracked = {
	character: Model,
	humanoid: Humanoid,
	root: BasePart,
	anim: any,
	weights: any,
	lastYaw: number,
	lastPosition: Vector3,
	smoothedSpeed: number,
}

local tracked: { [Model]: Tracked } = {}

local function isLocal(character: Model): boolean
	return player.Character == character
end

--- Horizontal position, so speed is measured on the ground plane.
local function groundPosition(root: BasePart): Vector3
	local p = root.Position
	return Vector3.new(p.X, 0, p.Z)
end

local function untrack(character: Model)
	tracked[character] = nil
end

local function track(character: Model)
	untrack(character)

	if not character:IsA(&quot;Model&quot;) then
		return
	end
	local humanoid = character:FindFirstChildOfClass(&quot;Humanoid&quot;)
	local root = character:FindFirstChild(&quot;HumanoidRootPart&quot;)
	if not humanoid or not root or not root:IsA(&quot;BasePart&quot;) then
		return
	end

	local entry: Tracked
	entry = {
		character = character,
		humanoid = humanoid,
		root = root,
		anim = AnimationSystem.newState(),
		weights = AnimationSystem.blendWeights({}, AnimationSystem.EMPTY_WEIGHTS, 1, 1e6),
		lastYaw = R6Rig.yawOf(root.CFrame),
		lastPosition = groundPosition(root),
		smoothedSpeed = 0,
	}

	tracked[character] = entry
end

--- Reads the animation state a character is advertising. Attributes are the
--- replicated source of truth; for the local player we can fall back to
--- State, which is always ahead of the attribute write.
local function readWeights(character: Model, speed: number, grounded: boolean, localPlayer: boolean)
	local function attr(name: string, fallback: any): any
		local value = character:GetAttribute(name)
		if value == nil then
			return fallback
		end
		return value
	end

	local stance = attr(&quot;Stance&quot;, localPlayer and State.stance or &quot;Stand&quot;)
	local aiming = attr(&quot;Aiming&quot;, localPlayer and State.aiming or false)
	local vaulting = attr(&quot;Vaulting&quot;, localPlayer and State.vaulting or false)
	local downed = attr(&quot;Downed&quot;, localPlayer and State.downed or false)
	local sprinting = attr(&quot;Sprinting&quot;, localPlayer and State.sprinting or false)
	-- The local player publishes &quot;Armed&quot; from the weapon controller. For
	-- every other player the server only publishes &quot;EquippedWeapon&quot;, so
	-- derive the carry pose from that. Without this, remote players would
	-- hold a rifle with loose, swinging arms.
	local armed = attr(&quot;Armed&quot;, false) or (character:GetAttribute(&quot;EquippedWeapon&quot;) ~= nil)

	return {
		crouch = stance == &quot;Crouch&quot; and 1 or 0,
		prone = stance == &quot;Prone&quot; and 1 or 0,
		aim = aiming and 1 or 0,
		sprint = (sprinting and speed &gt; Config.Movement.WalkSpeed * 0.8) and 1 or 0,
		air = grounded and 0 or 1,
		vault = vaulting and 1 or 0,
		downed = downed and 1 or 0,
		armed = armed and 1 or 0,
	}
end

local function update(dt: number)
	for character, entry in pairs(tracked) do
		local root = entry.root
		local humanoid = entry.humanoid
		if not character.Parent or not root.Parent or not humanoid.Parent then
			untrack(character)
			continue
		end

		-- Speed from real displacement: correct for remote characters too,
		-- and it never lies about what the body is actually doing.
		local position = groundPosition(root)
		local rawSpeed = (position - entry.lastPosition).Magnitude / math.max(dt, 1e-4)
		entry.lastPosition = position
		entry.smoothedSpeed += (rawSpeed - entry.smoothedSpeed) * math.min(1, 14 * dt)

		local grounded = humanoid.FloorMaterial ~= Enum.Material.Air
		local yaw = R6Rig.yawOf(root.CFrame)
		local turnRate = R6Rig.angleDelta(entry.lastYaw, yaw) / math.max(dt, 1e-4)
		entry.lastYaw = yaw

		local localPlayer = isLocal(character)
		local target = readWeights(character, entry.smoothedSpeed, grounded, localPlayer)
		AnimationSystem.blendWeights(entry.weights, target, dt)

		local pose = AnimationSystem.computePose({
			dt = dt,
			speed = entry.smoothedSpeed,
			turnRate = turnRate,
			grounded = grounded,
			weights = entry.weights,
			anim = entry.anim,
		})

		R6Rig.applyPose(character, pose)

		-- Publish a little state so the camera and the weapon view can read
		-- it without recomputing the same numbers.
		character:SetAttribute(&quot;AnimPhase&quot;, pose.phase)
		character:SetAttribute(&quot;AnimSpeed&quot;, entry.smoothedSpeed)
	end
end

local function onCharacter(character: Model)
	track(character)
end

function AnimatorController.init()
	if not ANIM.Enabled then
		return
	end

	for _, child in ipairs(workspace:GetChildren()) do
		if child:IsA(&quot;Model&quot;) and child:FindFirstChildOfClass(&quot;Humanoid&quot;) then
			onCharacter(child)
		end
	end

	workspace.ChildAdded:Connect(function(child)
		if child:IsA(&quot;Model&quot;) then
			onCharacter(child)
		end
	end)

	Players.PlayerAdded:Connect(function(otherPlayer)
		otherPlayer.CharacterAdded:Connect(onCharacter)
	end)
	for _, otherPlayer in ipairs(Players:GetPlayers()) do
		if otherPlayer.Character then
			onCharacter(otherPlayer.Character)
		end
		otherPlayer.CharacterAdded:Connect(onCharacter)
	end

	RunService.Heartbeat:Connect(update)
end

--- Forces a character to be re-read, e.g. after the server swaps its rig.
function AnimatorController.refresh(character: Model)
	track(character)
end

return AnimatorController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX15"><Properties><string name="Name">CameraController</string><ProtectedString name="Source">--!strict
--[[
	CameraController
	The Last of Us camera: a tight over-the-shoulder third person that the
	mouse drives directly.

	How it behaves
	--------------
	* The camera orbits a pivot above the character's root. Mouse X turns the
	  orbit; mouse Y pitches it. The body yaws to follow the orbit, with a
	  little lag so turns have weight.
	* The camera sits offset to the character's right shoulder, and pulls in
	  tighter over the shoulder when aiming.
	* Sprinting widens the FOV; aiming narrows it.
	* Recoil is a spring that kicks the aim up and back, then recovers.
	* Leaning shifts the camera sideways so you can peek around cover.
	* Collision pulls the camera in so it never ends up inside a wall.

	Because the body follows the camera, the character's own animator sees a
	real turn rate every frame - which is what drives turn-in-place stepping.
]]

local Players = game:GetService(&quot;Players&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local UserInputService = game:GetService(&quot;UserInputService&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local TLoU = ReplicatedStorage:WaitForChild(&quot;TLoU&quot;)
local Shared = TLoU:WaitForChild(&quot;Shared&quot;)

local Config = require(Shared.Config)
local Util = require(Shared.Util)
local AnimationSystem = require(Shared.AnimationSystem)

local State = require(script.Parent.State)

local CameraController = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera
local C = Config.Camera

-- Orbit state ----------------------------------------------------------
local yaw = 0
local pitch = 0
local currentShoulder = C.ShoulderOffset
local currentDistance = C.Distance
local currentFOV = C.FOV

-- Bob / sway -----------------------------------------------------------
local bobPhase = 0
local swayOffset = Vector2.new(0, 0)

-- Recoil spring --------------------------------------------------------
local recoilPitch = 0
local recoilYaw = 0
local recoilPitchVelocity = 0
local recoilYawVelocity = 0

-- Shake ----------------------------------------------------------------
local shakeTime = 0
local shakeIntensity = 0

-- Body follow ----------------------------------------------------------
-- The body's yaw lags the camera slightly. The difference between the two
-- is the turn rate the animator uses to decide when to step in place.
local bodyYaw = 0

local function updateSpring(dt: number)
	local stiffness = C.RecoilRecovery
	local damping = 2 * math.sqrt(stiffness) * 0.6

	recoilPitchVelocity += (-stiffness * recoilPitch - damping * recoilPitchVelocity) * dt
	recoilYawVelocity += (-stiffness * recoilYaw - damping * recoilYawVelocity) * dt

	recoilPitch = math.clamp(recoilPitch + recoilPitchVelocity * dt, -C.MaxRecoil, C.MaxRecoil)
	recoilYaw = math.clamp(recoilYaw + recoilYawVelocity * dt, -C.MaxRecoil, C.MaxRecoil)

	State.recoil = Vector2.new(recoilPitch, recoilYaw)
end

local function addRecoil(pitchKick: number, yawKick: number)
	recoilPitchVelocity -= pitchKick
	recoilYawVelocity += yawKick
end

local function addShake(intensity: number, duration: number)
	shakeIntensity = math.max(shakeIntensity, intensity)
	shakeTime = math.max(shakeTime, duration)
end

local function update(dt: number)
	local character = State.character
	local root = State.rootPart
	local humanoid = State.humanoid
	if not character or not root or not humanoid then
		return
	end

	-- Mouse drives the orbit -------------------------------------------
	local mouseDelta = UserInputService:GetMouseDelta()
	yaw -= mouseDelta.X * 0.0025
	pitch = math.clamp(
		pitch - mouseDelta.Y * 0.0025,
		math.rad(C.MinPitch),
		math.rad(C.MaxPitch)
	)

	updateSpring(dt)

	-- Pose targets ------------------------------------------------------
	local targetShoulder = State.aiming and C.AimOffset or C.ShoulderOffset
	currentShoulder = currentShoulder:Lerp(targetShoulder, Util.damp(dt, 9))

	local targetDistance = State.aiming and C.AimDistance or C.Distance
	currentDistance += (targetDistance - currentDistance) * Util.damp(dt, 8)

	local targetFOV = C.FOV
	if State.aiming then
		targetFOV = C.AimFOV
	elseif State.sprinting then
		targetFOV = C.SprintFOV
	end
	currentFOV += (targetFOV - currentFOV) * Util.damp(dt, C.FOVLerp)
	camera.FieldOfView = currentFOV

	-- Movement bob ------------------------------------------------------
	local moving = humanoid.MoveDirection.Magnitude &gt; 0.1
	local speedFactor = math.clamp(State.moveSpeed / math.max(Config.Movement.SprintSpeed, 1), 0, 1)
	if moving and State.grounded then
		bobPhase += dt * C.BobFrequency * (0.6 + speedFactor)
	else
		bobPhase += dt * C.BobFrequency * 0.25
	end

	local bobVertical = 0
	local bobHorizontal = 0
	if moving and State.grounded then
		bobVertical = math.sin(bobPhase * 2) * C.BobAmplitude * (0.5 + speedFactor)
		bobHorizontal = math.cos(bobPhase) * C.BobAmplitude * 0.6 * (0.5 + speedFactor)
	end

	-- Sway from mouse movement (camera inertia) -------------------------
	local swayTarget = Vector2.new(
		-mouseDelta.X * C.SwayAmount * 0.01,
		mouseDelta.Y * C.SwayAmount * 0.01
	)
	swayOffset = swayOffset:Lerp(swayTarget, Util.damp(dt, C.SwaySmoothing))

	-- Lean shift --------------------------------------------------------
	local leanShift = State.lean * Config.Movement.LeanOffset
	local leanRoll = -State.lean * math.rad(Config.Movement.LeanAngle)

	-- Shake -------------------------------------------------------------
	local shakeOffset = Vector3.new(0, 0, 0)
	if shakeTime &gt; 0 then
		shakeTime -= dt
		local decay = math.clamp(shakeTime / 0.3, 0, 1)
		shakeOffset = Vector3.new(
			(math.random() - 0.5) * shakeIntensity * decay * 0.5,
			(math.random() - 0.5) * shakeIntensity * decay * 0.5,
			0
		)
		if shakeTime &lt;= 0 then
			shakeIntensity = 0
		end
	end

	-- The pivot sits above the root, near the eyes. Prone and crouch lower
	-- it so the framing matches the body.
	local pivotHeight = C.PivotHeight
	if State.stance == &quot;Crouch&quot; then
		pivotHeight -= 0.5
	elseif State.stance == &quot;Prone&quot; then
		pivotHeight -= 1.0
	end
	local subjectPosition = root.Position + Vector3.new(0, pivotHeight, 0)

	local orbit = CFrame.fromEulerAnglesYXZ(pitch, yaw, 0)
	local right = orbit.RightVector
	local up = orbit.UpVector
	local back = orbit.LookVector

	local offset = currentShoulder
	local basePosition = subjectPosition
		+ right * (offset.X + leanShift + bobHorizontal)
		+ up * (offset.Y + bobVertical)

	local desiredPosition = basePosition - back * currentDistance

	-- Collision: keep the camera out of geometry ------------------------
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { character }
	params.IgnoreWater = true
	local collision = workspace:Raycast(subjectPosition, desiredPosition - subjectPosition, params)
	if collision then
		local safe = (collision.Position - subjectPosition).Magnitude - 0.3
		safe = math.max(safe, C.MinDistance)
		desiredPosition = subjectPosition - back * safe
	end

	local finalPosition = desiredPosition + shakeOffset
	local lookRotation = CFrame.fromEulerAnglesYXZ(
		pitch + recoilPitch,
		yaw + recoilYaw,
		leanRoll + math.rad(swayOffset.X * 0.5)
	)

	camera.CFrame = CFrame.new(finalPosition) * lookRotation
	camera.Focus = CFrame.new(subjectPosition)

	-- Turn the body toward the camera -----------------------------------
	-- The body chases the camera's yaw with a short lag. That lag is the
	-- turn rate the animator sees, and it is what makes turning in place
	-- step the feet instead of sliding.
	if not State.vaulting and not State.downed then
		-- While moving, the body snaps around faster so a strafe reads as a
		-- strafe rather than as a slow pirouette.
		local boost = moving and 1.8 or 1
		bodyYaw = AnimationSystem.bodyTurn(bodyYaw, yaw, State.aiming, dt, boost)
		root.CFrame = CFrame.new(root.Position) * CFrame.Angles(0, bodyYaw, 0)
	end
end

function CameraController.init()
	camera = workspace.CurrentCamera
	camera.CameraType = Enum.CameraType.Scriptable
	camera.FieldOfView = C.FOV

	-- Disable only Roblox's default camera script. The rest of the
	-- PlayerModule (the control module) must stay alive or WASD movement
	-- and jumping stop working.
	local cameraScript = player.PlayerScripts:FindFirstChild(&quot;CameraScript&quot;)
	if cameraScript and cameraScript:IsA(&quot;BaseScript&quot;) then
		cameraScript.Disabled = true
	end

	UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	UserInputService.MouseIconEnabled = false

	UserInputService.WindowFocused:Connect(function()
		UserInputService.MouseBehavior = Enum.MouseBehavior.LockCenter
	end)

	RunService:BindToRenderStep(&quot;TLoUCamera&quot;, Enum.RenderPriority.Camera.Value + 1, update)

	State.Signals.Fired:Connect(function(pitchKick, yawKick)
		addRecoil(pitchKick, yawKick)
	end)
	State.Signals.Shake:Connect(function(intensity, duration)
		addShake(intensity, duration)
	end)

	State.Signals.CharacterChanged:Connect(function(character)
		local root = character:WaitForChild(&quot;HumanoidRootPart&quot;, 5) :: BasePart?
		if root then
			local look = root.CFrame.LookVector
			yaw = math.atan2(-look.X, -look.Z)
			pitch = 0
			bodyYaw = yaw
		end
	end)
end

function CameraController.addRecoilImpulse(pitchKick: number, yawKick: number)
	addRecoil(pitchKick, yawKick)
end

return CameraController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX16"><Properties><string name="Name">EffectsController</string><ProtectedString name="Source">--!strict
--[[
	EffectsController
	All cosmetic feedback: tracers, muzzle flashes, ejected shells,
	bullet impacts (decals + sparks + dust), blood, explosions, smoke and
	the camera shake that ties them together.

	Everything here is client-only and disposable - it never affects
	gameplay, so it can be dialled up or down freely for performance.
]]

local Debris = game:GetService(&quot;Debris&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local TLoU = ReplicatedStorage:WaitForChild(&quot;TLoU&quot;)
local Shared = TLoU:WaitForChild(&quot;Shared&quot;)

local Config = require(Shared.Config)

local State = require(script.Parent.State)

local EffectsController = {}

local camera = workspace.CurrentCamera

local MATERIAL_COLORS = {
	[Enum.Material.Metal] = Color3.fromRGB(200, 200, 205),
	[Enum.Material.Concrete] = Color3.fromRGB(170, 170, 165),
	[Enum.Material.Wood] = Color3.fromRGB(120, 90, 55),
	[Enum.Material.Brick] = Color3.fromRGB(150, 80, 66),
	[Enum.Material.Glass] = Color3.fromRGB(190, 220, 230),
	[Enum.Material.Fabric] = Color3.fromRGB(110, 100, 90),
	[Enum.Material.Grass] = Color3.fromRGB(80, 110, 60),
	[Enum.Material.Sand] = Color3.fromRGB(190, 170, 120),
	[Enum.Material.Slate] = Color3.fromRGB(90, 90, 95),
}

local function colorForMaterial(material: Enum.Material?): Color3
	if material and MATERIAL_COLORS[material] then
		return MATERIAL_COLORS[material]
	end
	return Color3.fromRGB(160, 160, 160)
end

--- A bright stretched beam from origin toward target.
function EffectsController.spawnTracer(origin: Vector3, target: Vector3, silenced: boolean)
	local delta = target - origin
	local distance = delta.Magnitude
	if distance &lt; 0.1 then
		return
	end

	local tracer = Instance.new(&quot;Part&quot;)
	tracer.Name = &quot;TLoUTracer&quot;
	tracer.Anchored = true
	tracer.CanCollide = false
	tracer.CanQuery = false
	tracer.Material = Enum.Material.Neon
	tracer.Color = silenced and Color3.fromRGB(120, 160, 200) or Color3.fromRGB(255, 220, 130)
	tracer.Size = Vector3.new(0.06, 0.06, distance)
	tracer.CFrame = CFrame.new(origin + delta * 0.5, target)
	tracer.Transparency = 0.25
	tracer.Parent = workspace

	local light = Instance.new(&quot;PointLight&quot;)
	light.Color = tracer.Color
	light.Range = 6
	light.Brightness = 1
	light.Parent = tracer

	Debris:AddItem(tracer, Config.Visual.TracerTime)
end

--- Short-lived star of neon at the muzzle.
function EffectsController.spawnMuzzleFlash(muzzle: BasePart)
	if not muzzle then
		return
	end

	local flash = Instance.new(&quot;Part&quot;)
	flash.Name = &quot;TLoUMuzzleFlash&quot;
	flash.Anchored = true
	flash.CanCollide = false
	flash.CanQuery = false
	flash.Material = Enum.Material.Neon
	flash.Color = Color3.fromRGB(255, 200, 90)
	flash.Shape = Enum.PartType.Ball
	flash.Size = Vector3.new(0.45, 0.45, 0.45)
	flash.CFrame = muzzle.CFrame
	flash.Transparency = 0.05
	flash.Parent = workspace

	local light = Instance.new(&quot;PointLight&quot;)
	light.Color = Color3.fromRGB(255, 190, 110)
	light.Range = 12
	light.Brightness = 3
	light.Parent = flash

	Debris:AddItem(flash, Config.Visual.MuzzleFlashTime)
end

--- Ejects a small brass shell that tumbles away from the weapon.
function EffectsController.ejectShell(weaponHandle: BasePart?, data): void
	if not weaponHandle or not data then
		return
	end
	-- Only firearms eject brass; bows and melee do not.
	if data.category ~= &quot;Firearm&quot; or data.model == &quot;Bow&quot; then
		return
	end

	local shell = Instance.new(&quot;Part&quot;)
	shell.Name = &quot;TLoUShell&quot;
	shell.Size = Vector3.new(0.06, 0.06, 0.22)
	shell.Color = Color3.fromRGB(200, 165, 70)
	shell.Material = Enum.Material.Metal
	shell.CanCollide = false
	shell.CanQuery = false
	shell.CFrame = weaponHandle.CFrame * CFrame.new(0.25, 0.05, 0.2)
	shell.Parent = workspace

	local bodyVelocity = Instance.new(&quot;BodyVelocity&quot;)
	bodyVelocity.Velocity = weaponHandle.CFrame.RightVector * Config.Visual.ShellEjectSpeed
		+ Vector3.new(0, 6, 0)
	bodyVelocity.MaxForce = Vector3.new(math.huge, math.huge, math.huge)
	bodyVelocity.Parent = shell

	local spin = Instance.new(&quot;BodyAngularVelocity&quot;)
	spin.AngularVelocity = Vector3.new(math.random(-20, 20), math.random(-20, 20), math.random(-20, 20))
	spin.MaxTorque = Vector3.new(math.huge, math.huge, math.huge)
	spin.Parent = shell

	Debris:AddItem(shell, 2)
end

--- Bullet impact: dust puff, spark, decal and a puff of debris.
function EffectsController.spawnImpact(position: Vector3, normal: Vector3, material: Enum.Material?)
	local color = colorForMaterial(material)

	-- Dust puff.
	local puff = Instance.new(&quot;Part&quot;)
	puff.Name = &quot;TLoUImpact&quot;
	puff.Anchored = true
	puff.CanCollide = false
	puff.CanQuery = false
	puff.Material = Enum.Material.SmoothPlastic
	puff.Color = color
	puff.Shape = Enum.PartType.Ball
	puff.Size = Vector3.new(0.35, 0.35, 0.35)
	puff.CFrame = CFrame.new(position + normal * 0.1)
	puff.Transparency = 0.3
	puff.Parent = workspace

	local tween = game:GetService(&quot;TweenService&quot;):Create(puff, TweenInfo.new(0.35), {
		Size = Vector3.new(1.2, 1.2, 1.2),
		Transparency = 1,
	})
	tween:Play()
	Debris:AddItem(puff, 0.4)

	-- Spark flash.
	local spark = Instance.new(&quot;Part&quot;)
	spark.Name = &quot;TLoUSpark&quot;
	spark.Anchored = true
	spark.CanCollide = false
	spark.CanQuery = false
	spark.Material = Enum.Material.Neon
	spark.Color = Color3.fromRGB(255, 230, 150)
	spark.Size = Vector3.new(0.12, 0.12, 0.12)
	spark.CFrame = CFrame.new(position)
	spark.Parent = workspace
	Debris:AddItem(spark, 0.08)

	-- Decal on the hit surface.
	local decal = Instance.new(&quot;Part&quot;)
	decal.Name = &quot;TLoUBulletHole&quot;
	decal.Anchored = true
	decal.CanCollide = false
	decal.CanQuery = false
	decal.Material = Enum.Material.SmoothPlastic
	decal.Color = Color3.fromRGB(20, 18, 16)
	decal.Size = Vector3.new(0.18, 0.18, 0.02)
	decal.CFrame = CFrame.new(position + normal * 0.02, position + normal * 0.02 + normal)
	decal.Transparency = 0.15
	decal.Parent = workspace
	Debris:AddItem(decal, Config.Visual.HitDecalLifetime)
end

--- Blood burst on a character hit.
function EffectsController.spawnBlood(position: Vector3, normal: Vector3)
	local blood = Instance.new(&quot;Part&quot;)
	blood.Name = &quot;TLoUBlood&quot;
	blood.Anchored = true
	blood.CanCollide = false
	blood.CanQuery = false
	blood.Material = Enum.Material.SmoothPlastic
	blood.Color = Color3.fromRGB(120, 20, 18)
	blood.Shape = Enum.PartType.Ball
	blood.Size = Vector3.new(0.4, 0.4, 0.4)
	blood.CFrame = CFrame.new(position + normal * 0.1)
	blood.Transparency = 0.15
	blood.Parent = workspace

	local tween = game:GetService(&quot;TweenService&quot;):Create(blood, TweenInfo.new(Config.Visual.BloodTime), {
		Size = Vector3.new(0.9, 0.9, 0.9),
		Transparency = 1,
	})
	tween:Play()
	Debris:AddItem(blood, Config.Visual.BloodTime + 0.1)
end

--- Fireball + shockwave for explosives.
function EffectsController.spawnExplosion(position: Vector3, weaponId: string)
	local isSmoke = weaponId == &quot;SmokeBomb&quot;

	local core = Instance.new(&quot;Part&quot;)
	core.Name = &quot;TLoUExplosion&quot;
	core.Anchored = true
	core.CanCollide = false
	core.CanQuery = false
	core.Material = Enum.Material.Neon
	core.Shape = Enum.PartType.Ball
	core.Color = isSmoke and Color3.fromRGB(200, 200, 200) or Color3.fromRGB(255, 140, 40)
	core.Size = Vector3.new(2, 2, 2)
	core.CFrame = CFrame.new(position)
	core.Transparency = 0.1
	core.Parent = workspace

	local light = Instance.new(&quot;PointLight&quot;)
	light.Color = core.Color
	light.Range = 24
	light.Brightness = 6
	light.Parent = core

	local tween = game:GetService(&quot;TweenService&quot;):Create(core, TweenInfo.new(isSmoke and 1.2 or 0.5), {
		Size = Vector3.new(isSmoke and 14 or 8, isSmoke and 14 or 8, isSmoke and 14 or 8),
		Transparency = 1,
	})
	tween:Play()
	Debris:AddItem(core, isSmoke and 1.4 or 0.6)

	if isSmoke then
		for _ = 1, 10 do
			local puff = Instance.new(&quot;Part&quot;)
			puff.Anchored = true
			puff.CanCollide = false
			puff.CanQuery = false
			puff.Material = Enum.Material.SmoothPlastic
			puff.Color = Color3.fromRGB(180, 180, 180)
			puff.Shape = Enum.PartType.Ball
			puff.Size = Vector3.new(4, 4, 4)
			puff.CFrame = CFrame.new(position + Vector3.new(math.random(-5, 5), math.random(0, 4), math.random(-5, 5)))
			puff.Transparency = 0.5
			puff.Parent = workspace
			local puffTween = game:GetService(&quot;TweenService&quot;):Create(puff, TweenInfo.new(4), {
				Size = Vector3.new(12, 12, 12),
				Transparency = 1,
			})
			puffTween:Play()
			Debris:AddItem(puff, 4.2)
		end
	end

	-- Camera shake scaled by distance.
	if camera then
		local distance = (camera.CFrame.Position - position).Magnitude
		local intensity = math.clamp(1 - distance / 40, 0, 1) * Config.Visual.CameraShakeIntensity * 3
		if intensity &gt; 0.05 then
			State.Signals.Shake:Fire(intensity, 0.4)
		end
	end
end

--- Melee swing whoosh / hit spark.
function EffectsController.spawnMelee(character: Model?, weaponId: string, hit: boolean)
	local root = character and character:FindFirstChild(&quot;HumanoidRootPart&quot;) :: BasePart?
	if not root then
		return
	end

	local swing = Instance.new(&quot;Part&quot;)
	swing.Name = &quot;TLoUMeleeArc&quot;
	swing.Anchored = true
	swing.CanCollide = false
	swing.CanQuery = false
	swing.Material = Enum.Material.Neon
	swing.Color = hit and Color3.fromRGB(255, 200, 120) or Color3.fromRGB(180, 180, 180)
	swing.Size = Vector3.new(0.1, 0.1, 4)
	swing.CFrame = root.CFrame * CFrame.new(0, 0, -3)
	swing.Transparency = 0.5
	swing.Parent = workspace
	Debris:AddItem(swing, 0.12)
end

function EffectsController.init()
	State.Signals.HitFeedback:Connect(function(payload)
		-- Handled by the HUD for the hitmarker; blood is spawned below
		-- when we know the world position.
	end)
end

return EffectsController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX17"><Properties><string name="Name">HUDController</string><ProtectedString name="Source">--!strict
--[[
	HUDController
	Builds the whole interface in code - no GUI instances needed in the
	place file. The layout mirrors TLoU's diegetic, minimal HUD:
	* Health arc bottom-left that flashes red when hurt.
	* Stamina bar that appears only while sprinting or exhausted.
	* Ammo readout bottom-right: &quot;mag / reserve&quot;.
	* Weapon slot strip showing the four equipped items.
	* A small compass at the top centre.
	* Hitmarker flash on a confirmed hit.
	* A subtle vignette that darkens when health is low.
	* Noise indicator ring that pulses when the player makes noise.
]]

local Players = game:GetService(&quot;Players&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local TweenService = game:GetService(&quot;TweenService&quot;)

local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)
local TLoU = ReplicatedStorage:WaitForChild(&quot;TLoU&quot;)
local Shared = TLoU:WaitForChild(&quot;Shared&quot;)

local Config = require(Shared.Config)
local Weapons = require(Shared.Weapons)

local State = require(script.Parent.State)

local HUDController = {}

local player = Players.LocalPlayer
local playerGui = player:WaitForChild(&quot;PlayerGui&quot;)

local gui: ScreenGui
local healthBar: Frame
local healthLabel: TextLabel
local staminaBar: Frame
local staminaContainer: Frame
local ammoLabel: TextLabel
local weaponNameLabel: TextLabel
local slotButtons: { TextLabel } = {}
local compassLabel: TextLabel
local hitmarker: TextLabel
local vignette: Frame
local noiseRing: Frame
local centerDot: Frame
local downedOverlay: Frame

local hitmarkerAlpha = 0
local hitmarkerTimer = 0
local noiseAlpha = 0
local vignetteAlpha = 0

local COLORS = {
	panel = Color3.fromRGB(12, 12, 14),
	accent = Color3.fromRGB(196, 162, 96),
	health = Color3.fromRGB(180, 60, 50),
	healthLow = Color3.fromRGB(230, 40, 30),
	stamina = Color3.fromRGB(210, 190, 120),
	text = Color3.fromRGB(228, 226, 220),
	dim = Color3.fromRGB(120, 118, 112),
}

local function newFrame(name: string, parent: Instance, size: UDim2, position: UDim2): Frame
	local frame = Instance.new(&quot;Frame&quot;)
	frame.Name = name
	frame.Size = size
	frame.Position = position
	frame.BackgroundColor3 = COLORS.panel
	frame.BackgroundTransparency = 0.35
	frame.BorderSizePixel = 0
	frame.Parent = parent
	return frame
end

local function newLabel(name: string, parent: Instance, text: string, size: UDim2, position: UDim2): TextLabel
	local label = Instance.new(&quot;TextLabel&quot;)
	label.Name = name
	label.Text = text
	label.Size = size
	label.Position = position
	label.BackgroundTransparency = 1
	label.Font = Enum.Font.Gotham
	label.TextColor3 = COLORS.text
	label.TextSize = 16
	label.TextXAlignment = Enum.TextXAlignment.Left
	label.Parent = parent
	return label
end

local function buildGui()
	gui = Instance.new(&quot;ScreenGui&quot;)
	gui.Name = &quot;TLoUHUD&quot;
	gui.ResetOnSpawn = false
	gui.IgnoreGuiInset = true
	gui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
	gui.Parent = playerGui

	-- Vignette (behind everything else) ------------------------------
	vignette = Instance.new(&quot;Frame&quot;)
	vignette.Name = &quot;Vignette&quot;
	vignette.Size = UDim2.fromScale(1, 1)
	vignette.BackgroundColor3 = Color3.fromRGB(120, 0, 0)
	vignette.BackgroundTransparency = 1
	vignette.BorderSizePixel = 0
	vignette.ZIndex = 0
	vignette.Parent = gui

	-- Center dot -----------------------------------------------------
	centerDot = Instance.new(&quot;Frame&quot;)
	centerDot.Name = &quot;CenterDot&quot;
	centerDot.Size = UDim2.fromOffset(4, 4)
	centerDot.Position = UDim2.fromScale(0.5, 0.5)
	centerDot.AnchorPoint = Vector2.new(0.5, 0.5)
	centerDot.BackgroundColor3 = COLORS.text
	centerDot.BackgroundTransparency = 0.3
	centerDot.BorderSizePixel = 0
	centerDot.ZIndex = 2
	centerDot.Parent = gui

	-- Health ---------------------------------------------------------
	local healthContainer = newFrame(&quot;HealthContainer&quot;, gui, UDim2.fromOffset(280, 44), UDim2.new(0, 32, 1, -84))
	healthContainer.BackgroundTransparency = 1

	local healthBack = newFrame(&quot;HealthBack&quot;, healthContainer, UDim2.fromScale(1, 0.45), UDim2.fromScale(0, 0.1))
	healthBack.BackgroundColor3 = Color3.fromRGB(30, 30, 32)
	healthBack.BackgroundTransparency = 0.25

	healthBar = newFrame(&quot;HealthFill&quot;, healthBack, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0))
	healthBar.BackgroundColor3 = COLORS.health
	healthBar.BackgroundTransparency = 0

	healthLabel = newLabel(&quot;HealthLabel&quot;, healthContainer, &quot;100&quot;, UDim2.fromScale(1, 0.5), UDim2.fromScale(0, 0.55))
	healthLabel.TextSize = 22
	healthLabel.Font = Enum.Font.GothamBold

	-- Stamina --------------------------------------------------------
	staminaContainer = newFrame(&quot;StaminaContainer&quot;, gui, UDim2.fromOffset(200, 12), UDim2.new(0, 32, 1, -118))
	staminaContainer.BackgroundColor3 = Color3.fromRGB(30, 30, 32)
	staminaContainer.BackgroundTransparency = 0.4
	staminaContainer.Visible = false

	staminaBar = newFrame(&quot;StaminaFill&quot;, staminaContainer, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0))
	staminaBar.BackgroundColor3 = COLORS.stamina
	staminaBar.BackgroundTransparency = 0

	-- Ammo -----------------------------------------------------------
	ammoLabel = newLabel(&quot;AmmoLabel&quot;, gui, &quot;-- / --&quot;, UDim2.fromOffset(220, 44), UDim2.new(1, -252, 1, -84))
	ammoLabel.TextSize = 34
	ammoLabel.Font = Enum.Font.GothamBold
	ammoLabel.TextXAlignment = Enum.TextXAlignment.Right

	weaponNameLabel = newLabel(&quot;WeaponName&quot;, gui, &quot;&quot;, UDim2.fromOffset(220, 20), UDim2.new(1, -252, 1, -44))
	weaponNameLabel.TextSize = 15
	weaponNameLabel.TextColor3 = COLORS.dim
	weaponNameLabel.TextXAlignment = Enum.TextXAlignment.Right

	-- Weapon slots ---------------------------------------------------
	local slotContainer = newFrame(&quot;SlotContainer&quot;, gui, UDim2.fromOffset(300, 40), UDim2.new(0.5, -150, 1, -60))
	slotContainer.BackgroundTransparency = 1

	for i = 1, Config.Inventory.MaxSlots do
		local slot = newLabel(&quot;Slot&quot; .. i, slotContainer, tostring(i), UDim2.fromOffset(70, 36), UDim2.fromOffset((i - 1) * 74, 2))
		slot.BackgroundColor3 = COLORS.panel
		slot.BackgroundTransparency = 0.4
		slot.TextXAlignment = Enum.TextXAlignment.Center
		slot.TextSize = 13
		slot.TextColor3 = COLORS.dim
		table.insert(slotButtons, slot)
	end

	-- Compass --------------------------------------------------------
	local compassBack = newFrame(&quot;CompassBack&quot;, gui, UDim2.fromOffset(360, 26), UDim2.new(0.5, -180, 0, 18))
	compassBack.BackgroundTransparency = 0.5

	compassLabel = newLabel(&quot;CompassLabel&quot;, compassBack, &quot;N&quot;, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0))
	compassLabel.TextSize = 18
	compassLabel.TextXAlignment = Enum.TextXAlignment.Center

	-- Hitmarker ------------------------------------------------------
	hitmarker = newLabel(&quot;Hitmarker&quot;, gui, &quot;X&quot;, UDim2.fromOffset(40, 40), UDim2.new(0.5, -20, 0.5, -20))
	hitmarker.TextSize = 28
	hitmarker.Font = Enum.Font.GothamBold
	hitmarker.TextColor3 = COLORS.text
	hitmarker.TextTransparency = 1
	hitmarker.TextXAlignment = Enum.TextXAlignment.Center
	hitmarker.ZIndex = 3

	-- Noise ring -----------------------------------------------------
	noiseRing = Instance.new(&quot;Frame&quot;)
	noiseRing.Name = &quot;NoiseRing&quot;
	noiseRing.Size = UDim2.fromOffset(60, 60)
	noiseRing.Position = UDim2.new(0.5, -30, 0.5, -30)
	noiseRing.BackgroundTransparency = 1
	noiseRing.ZIndex = 1
	noiseRing.Parent = gui

	local ringCorner = Instance.new(&quot;UICorner&quot;)
	ringCorner.CornerRadius = UDim.new(0.5, 0)
	ringCorner.Parent = noiseRing

	local ringStroke = Instance.new(&quot;UIStroke&quot;)
	ringStroke.Thickness = 2
	ringStroke.Color = COLORS.accent
	ringStroke.Transparency = 1
	ringStroke.Parent = noiseRing

	-- Downed overlay -------------------------------------------------
	downedOverlay = newFrame(&quot;DownedOverlay&quot;, gui, UDim2.fromScale(1, 1), UDim2.fromScale(0, 0))
	downedOverlay.BackgroundColor3 = Color3.fromRGB(0, 0, 0)
	downedOverlay.BackgroundTransparency = 1
	downedOverlay.Visible = false

	local downedText = newLabel(&quot;DownedText&quot;, downedOverlay, &quot;DOWNED - HOLD ON&quot;, UDim2.fromScale(1, 0.1), UDim2.fromScale(0, 0.6))
	downedText.TextSize = 32
	downedText.Font = Enum.Font.GothamBold
	downedText.TextColor3 = Color3.fromRGB(200, 60, 50)
	downedText.TextXAlignment = Enum.TextXAlignment.Center
end

-- Update helpers -------------------------------------------------------
local function updateHealth()
	local fraction = math.clamp(State.health / Config.Combat.MaxHealth, 0, 1)
	healthBar.Size = UDim2.fromScale(fraction, 1)
	healthLabel.Text = tostring(math.floor(State.health))

	if fraction &lt; 0.35 then
		healthBar.BackgroundColor3 = COLORS.healthLow
		vignetteAlpha = math.clamp(1 - fraction / 0.35, 0, 1) * 0.35
	else
		healthBar.BackgroundColor3 = COLORS.health
		vignetteAlpha = 0
	end
end

local function updateAmmo()
	local weaponId = State.equipped
	if not weaponId then
		ammoLabel.Text = &quot;-- / --&quot;
		weaponNameLabel.Text = &quot;&quot;
		return
	end
	local data = Weapons.get(weaponId)
	if not data then
		return
	end

	if data.category == &quot;Melee&quot; then
		ammoLabel.Text = &quot;∞&quot;
	elseif data.category == &quot;Throwable&quot; then
		ammoLabel.Text = tostring(State.reserves[weaponId] or 0)
	else
		local mag = State.magazines[weaponId] or 0
		local reserve = State.reserves[weaponId] or 0
		ammoLabel.Text = string.format(&quot;%d / %d&quot;, mag, reserve)
		if mag == 0 then
			ammoLabel.TextColor3 = COLORS.healthLow
		else
			ammoLabel.TextColor3 = COLORS.text
		end
	end

	weaponNameLabel.Text = data.name
end

local function updateSlots()
	for i, slot in ipairs(slotButtons) do
		local weaponId = State.slots[i]
		if weaponId then
			local data = Weapons.get(weaponId)
			slot.Text = string.format(&quot;[%d] %s&quot;, i, data and data.name or weaponId)
			slot.TextColor3 = (weaponId == State.equipped) and COLORS.accent or COLORS.dim
			slot.BackgroundTransparency = (weaponId == State.equipped) and 0.15 or 0.5
		else
			slot.Text = string.format(&quot;[%d] -&quot;, i)
			slot.TextColor3 = COLORS.dim
		end
	end
end

local function updateCompass()
	local camera = workspace.CurrentCamera
	if not camera then
		return
	end
	local look = camera.CFrame.LookVector
	local angle = math.deg(math.atan2(-look.X, -look.Z))
	angle = (angle % 360 + 360) % 360

	local directions = { &quot;N&quot;, &quot;NE&quot;, &quot;E&quot;, &quot;SE&quot;, &quot;S&quot;, &quot;SW&quot;, &quot;W&quot;, &quot;NW&quot; }
	local index = math.floor(((angle + 22.5) % 360) / 45) + 1
	local direction = directions[index]

	compassLabel.Text = string.format(&quot;%s  %03d°&quot;, direction, math.floor(angle))
end

local function update(dt: number)
	local camera = workspace.CurrentCamera

	-- Stamina bar visibility: only when relevant.
	local showStamina = State.sprinting or State.exhausted or State.stamina &lt; Config.Movement.MaxStamina - 1
	staminaContainer.Visible = showStamina
	if showStamina then
		staminaBar.Size = UDim2.fromScale(math.clamp(State.stamina / Config.Movement.MaxStamina, 0, 1), 1)
		staminaBar.BackgroundColor3 = State.exhausted and COLORS.healthLow or COLORS.stamina
	end

	-- Vignette.
	vignette.BackgroundTransparency = 1 - vignetteAlpha

	-- Hitmarker fade (time based, so it cannot get stuck on).
	if hitmarkerAlpha &gt; 0 then
		hitmarkerTimer -= dt
		if hitmarkerTimer &lt;= 0 then
			hitmarkerAlpha = 0
		else
			hitmarkerAlpha = math.clamp(hitmarkerTimer / 0.3, 0, 1)
		end
		hitmarker.TextTransparency = 1 - hitmarkerAlpha
	end

	-- Noise ring pulse.
	local ringStroke = noiseRing:FindFirstChildOfClass(&quot;UIStroke&quot;)
	if ringStroke then
		if noiseAlpha &gt; 0 then
			noiseAlpha = math.max(0, noiseAlpha - dt * 1.5)
			ringStroke.Transparency = 1 - noiseAlpha * 0.8
			local scale = 1 + (1 - noiseAlpha) * 0.8
			noiseRing.Size = UDim2.fromOffset(60 * scale, 60 * scale)
			noiseRing.Position = UDim2.new(0.5, -30 * scale, 0.5, -30 * scale)
		else
			ringStroke.Transparency = 1
		end
	end

	-- Aiming tightens the reticle.
	centerDot.Size = State.aiming and UDim2.fromOffset(2, 2) or UDim2.fromOffset(4, 4)
	centerDot.BackgroundTransparency = State.aiming and 0.1 or 0.35

	updateCompass()
end

function HUDController.init()
	buildGui()
	updateHealth()
	updateAmmo()
	updateSlots()

	State.Signals.HealthChanged:Connect(function()
		updateHealth()
	end)

	State.Signals.AmmoChanged:Connect(function()
		updateAmmo()
	end)

	State.Signals.EquippedChanged:Connect(function()
		updateAmmo()
		updateSlots()
	end)

	State.Signals.HitFeedback:Connect(function(payload)
		hitmarkerAlpha = 1
		hitmarkerTimer = 0.3
		hitmarker.TextColor3 = payload.lethal and COLORS.healthLow or COLORS.text
	end)

	State.Signals.Noise:Connect(function()
		noiseAlpha = 1
	end)

	State.Signals.Shake:Connect(function()
		-- Camera shake is handled by the camera controller.
	end)

	RunService.RenderStepped:Connect(update)

	-- Push server state into the HUD state model.
	State.Signals.StanceChanged:Connect(function()
		updateSlots()
	end)
end

function HUDController.showDowned(downed: boolean)
	State.downed = downed
	downedOverlay.Visible = downed
	downedOverlay.BackgroundTransparency = downed and 0.5 or 1
end

return HUDController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX18"><Properties><string name="Name">MovementController</string><ProtectedString name="Source">--!strict
--[[
	MovementController
	The Last of Us movement feel: a heavy, deliberate walk, a limited
	sprint that burns stamina, crouch-walking, prone crawling, and
	contextual vault/climb over low obstacles.

	Design notes:
	* Walk speed is intentionally slow (14). TLoU is about weight, not
	  speed. Sprint is a burst, not a travel mode.
	* Stamina is predicted locally and reconciled by the server so the
	  bar feels instant but cannot be cheated.
	* Crouch and prone no longer touch the Humanoid. On R6 the Humanoid's
	  HipHeight must stay at 0 - raising it lifts the whole character off
	  the floor. Instead the *animator* lowers the torso, so the silhouette
	  drops while the physics stays honest. That also means the crouch
	  pose replicates to every client for free.
	* Vaulting detects a ledge in front of the player and plays a short
	  arc over it instead of the Roblox default mantle.

	Every state change is mirrored onto the character as an attribute.
	Attributes replicate automatically, so the animator on every other
	client can pose this character without any custom networking.
]]

local Players = game:GetService(&quot;Players&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local UserInputService = game:GetService(&quot;UserInputService&quot;)
local ContextActionService = game:GetService(&quot;ContextActionService&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local TLoU = ReplicatedStorage:WaitForChild(&quot;TLoU&quot;)
local Shared = TLoU:WaitForChild(&quot;Shared&quot;)

local Config = require(Shared.Config)
local Net = require(Shared.Net)

local State = require(script.Parent.State)

local MovementController = {}

local player = Players.LocalPlayer
local M = Config.Movement

-- Input snapshot -------------------------------------------------------
local input = {
	sprintHeld = false,
	crouchHeld = false,
	leanLeft = false,
	leanRight = false,
}

-- Runtime --------------------------------------------------------------
local lastDrainAt = 0
local stateSyncAccumulator = 0
local STATE_SYNC_INTERVAL = 1 / 20

local vaultConnection: RBXScriptConnection?
local leanTarget = 0
local currentLean = 0

local function isMoving(): boolean
	local humanoid = State.humanoid
	if not humanoid then
		return false
	end
	return humanoid.MoveDirection.Magnitude &gt; 0.1
end

local function canSprint(): boolean
	return State.stance == &quot;Stand&quot;
		and not State.exhausted
		and State.grounded
		and not State.vaulting
		and not State.aiming
end

--- Mirrors the current state onto the character so every client's animator
--- can read it without extra remote traffic. Only writes on change: an
--- attribute assignment is cheap but still replicates, and this runs every
--- frame.
local published: { [string]: any } = {}

local function publishAttribute(character: Model, name: string, value: any)
	if published[name] ~= value then
		published[name] = value
		character:SetAttribute(name, value)
	end
end

local function publishAttributes()
	local character = State.character
	if not character then
		return
	end
	publishAttribute(character, &quot;Stance&quot;, State.stance)
	publishAttribute(character, &quot;Sprinting&quot;, State.sprinting)
	publishAttribute(character, &quot;Aiming&quot;, State.aiming)
	publishAttribute(character, &quot;Vaulting&quot;, State.vaulting)
	-- Quantised: lean is a continuously moving float, and replicating it
	-- every frame for a cosmetic camera shift is not worth the traffic.
	publishAttribute(character, &quot;Lean&quot;, math.floor(currentLean * 20 + 0.5) / 20)
end

--- Sends the authoritative-ish state to the server (throttled).
local function syncState()
	Net.toServer(&quot;StateUpdate&quot;, {
		stance = State.stance,
		sprinting = State.sprinting,
		lean = currentLean,
		stamina = State.stamina,
	})
end

local function applyStanceToHumanoid()
	local humanoid = State.humanoid
	if not humanoid then
		return
	end

	if State.downed then
		humanoid.WalkSpeed = 0
		return
	end

	local speed = M.WalkSpeed
	if State.stance == &quot;Crouch&quot; then
		speed = M.CrouchSpeed
	elseif State.stance == &quot;Prone&quot; then
		speed = M.ProneSpeed
	elseif State.sprinting then
		speed = M.SprintSpeed
	end

	-- Aiming slows you down to a steady walk.
	if State.aiming and State.stance == &quot;Stand&quot; then
		speed = math.min(speed, M.WalkSpeed * 0.7)
	end

	humanoid.WalkSpeed = speed
	-- R6 keeps HipHeight at 0; the animator supplies the crouch and prone
	-- drop so the character never floats.
	humanoid.HipHeight = 0
end

--- Tries to find a vaultable ledge directly in front of the player.
local function findVaultTarget(): (Vector3?, number)
	local root = State.rootPart
	local humanoid = State.humanoid
	if not root or not humanoid then
		return nil, 0
	end

	local origin = root.Position
	local look = root.CFrame.LookVector

	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { State.character :: any }
	params.IgnoreWater = true

	local forwardHit = workspace:Raycast(origin + Vector3.new(0, 1, 0), look * 3, params)
	if not forwardHit then
		return nil, 0
	end

	local downHit = workspace:Raycast(
		forwardHit.Position + look * 0.6 + Vector3.new(0, 6, 0),
		Vector3.new(0, -14, 0),
		params
	)
	if not downHit then
		return nil, 0
	end

	local height = downHit.Position.Y - origin.Y
	if height &lt; M.VaultMinHeight or height &gt; M.VaultMaxHeight then
		return nil, 0
	end

	local clearance = workspace:Raycast(downHit.Position + Vector3.new(0, 3, 0), Vector3.new(0, 5, 0), params)
	if clearance then
		return nil, 0
	end

	return downHit.Position + look * 2.2, height
end

--- Animated vault: a short arc from the current position to the landing.
local function startVault(landing: Vector3, height: number)
	local root = State.rootPart
	local humanoid = State.humanoid
	if not root or not humanoid or State.vaulting then
		return
	end

	State.vaulting = true
	publishAttributes()
	-- Physics state stops the Humanoid from fighting the root CFrame we set
	-- every frame; we hand control back on landing.
	humanoid:ChangeState(Enum.HumanoidStateType.Physics)

	local startPosition = root.Position
	local duration = math.clamp(height / M.VaultSpeed, 0.25, 0.6)
	local elapsed = 0

	if vaultConnection then
		vaultConnection:Disconnect()
	end

	vaultConnection = RunService.Heartbeat:Connect(function(dt)
		elapsed += dt
		local alpha = math.clamp(elapsed / duration, 0, 1)

		if not root.Parent then
			vaultConnection:Disconnect()
			vaultConnection = nil
			State.vaulting = false
			return
		end

		local flat = startPosition:Lerp(landing, alpha)
		local arc = math.sin(alpha * math.pi) * math.max(height * 0.6, 1.5)
		local target = Vector3.new(flat.X, flat.Y + arc, flat.Z)

		local current = root.CFrame
		root.CFrame = CFrame.new(target) * (current - current.Position)

		if alpha &gt;= 1 then
			vaultConnection:Disconnect()
			vaultConnection = nil
			State.vaulting = false
			publishAttributes()
			humanoid:ChangeState(Enum.HumanoidStateType.Freefall)
		end
	end)
end

--- Central per-frame movement update.
local function update(dt: number)
	local humanoid = State.humanoid
	if not humanoid or not State.character or not State.character.Parent then
		return
	end

	State.grounded = humanoid.FloorMaterial ~= Enum.Material.Air
	State.moveSpeed = humanoid.MoveDirection.Magnitude * humanoid.WalkSpeed

	-- Stamina ---------------------------------------------------------
	local draining = false
	if State.sprinting and isMoving() then
		State.stamina -= M.StaminaDrainSprint * dt
		draining = true
		lastDrainAt = os.clock()
	elseif os.clock() - lastDrainAt &gt; M.StaminaRegenDelay then
		State.stamina += M.StaminaRegen * dt
	end
	State.stamina = math.clamp(State.stamina, 0, M.MaxStamina)

	if State.stamina &lt;= M.ExhaustedThreshold then
		State.exhausted = true
	elseif State.stamina &gt; M.MaxStamina * 0.35 then
		State.exhausted = false
	end

	-- Sprint gating ---------------------------------------------------
	if State.sprinting and not canSprint() then
		State.sprinting = false
	end
	if not input.sprintHeld and State.sprinting then
		State.sprinting = false
	end

	-- Lean ------------------------------------------------------------
	leanTarget = 0
	if input.leanLeft and not input.leanRight then
		leanTarget = -1
	elseif input.leanRight and not input.leanLeft then
		leanTarget = 1
	end
	currentLean += (leanTarget - currentLean) * math.min(1, M.LeanSpeed * dt)
	State.lean = currentLean

	applyStanceToHumanoid()
	publishAttributes()

	-- Throttled server sync -------------------------------------------
	stateSyncAccumulator += dt
	if stateSyncAccumulator &gt;= STATE_SYNC_INTERVAL then
		stateSyncAccumulator = 0
		syncState()
	end
end

-- Input handling -------------------------------------------------------
local function bindInput()
	-- Take over the jump key entirely so we can decide between vaulting
	-- over a ledge and a normal jump. Binding at a high priority sinks
	-- Roblox's default jump action before it can run.
	ContextActionService:BindActionAtPriority(&quot;TLoUJump&quot;, function(_, inputState)
		if inputState ~= Enum.UserInputState.Begin then
			return Enum.ContextActionResult.Pass
		end
		if State.stance ~= &quot;Stand&quot; or State.vaulting or State.downed then
			return Enum.ContextActionResult.Sink
		end
		local landing, height = findVaultTarget()
		if landing and height then
			startVault(landing, height)
			return Enum.ContextActionResult.Sink
		end
		if State.grounded and State.humanoid then
			State.humanoid:ChangeState(Enum.HumanoidStateType.Jumping)
			return Enum.ContextActionResult.Sink
		end
		return Enum.ContextActionResult.Pass
	end, false, 3000, Enum.KeyCode.Space)

	UserInputService.InputBegan:Connect(function(inputObject, processed)
		if processed then
			return
		end

		if inputObject.KeyCode == Config.Keys.Sprint then
			input.sprintHeld = true
			if canSprint() then
				State.sprinting = true
			end
		elseif inputObject.KeyCode == Config.Keys.Crouch then
			input.crouchHeld = true
			if State.stance == &quot;Stand&quot; then
				State.setStance(&quot;Crouch&quot;)
			elseif State.stance == &quot;Crouch&quot; then
				State.setStance(&quot;Stand&quot;)
			end
		elseif inputObject.KeyCode == Config.Keys.Prone then
			if State.stance == &quot;Prone&quot; then
				State.setStance(&quot;Crouch&quot;)
			else
				State.setStance(&quot;Prone&quot;)
			end
		elseif inputObject.KeyCode == Config.Keys.LeanLeft then
			input.leanLeft = true
		elseif inputObject.KeyCode == Config.Keys.LeanRight then
			input.leanRight = true
		end
	end)

	UserInputService.InputEnded:Connect(function(inputObject)
		if inputObject.KeyCode == Config.Keys.Sprint then
			input.sprintHeld = false
			State.sprinting = false
		elseif inputObject.KeyCode == Config.Keys.Crouch then
			input.crouchHeld = false
		elseif inputObject.KeyCode == Config.Keys.LeanLeft then
			input.leanLeft = false
		elseif inputObject.KeyCode == Config.Keys.LeanRight then
			input.leanRight = false
		end
	end)
end

function MovementController.init()
	bindInput()

	RunService.Heartbeat:Connect(update)

	-- Bind to the local character as it spawns.
	local function onCharacter(character: Model)
		State.character = character
		State.humanoid = character:WaitForChild(&quot;Humanoid&quot;, 5) :: Humanoid?
		State.rootPart = character:WaitForChild(&quot;HumanoidRootPart&quot;, 5) :: BasePart?
		State.head = character:WaitForChild(&quot;Head&quot;, 5) :: BasePart?

		State.stamina = M.MaxStamina
		State.setStance(&quot;Stand&quot;)
		State.sprinting = false

		if State.humanoid then
			State.humanoid.UseJumpPower = true
			State.humanoid.JumpPower = M.JumpPower
			-- Facing is camera-driven, so auto-rotate stays off.
			State.humanoid.AutoRotate = false
			State.humanoid.WalkSpeed = M.WalkSpeed
			State.humanoid.HipHeight = 0
		end

		publishAttributes()
		State.Signals.CharacterChanged:Fire(character)
	end

	player.CharacterAdded:Connect(onCharacter)
	if player.Character then
		onCharacter(player.Character)
	end

	-- Keep the replicated attributes in step with aiming, which is toggled
	-- by the weapon controller.
	State.Signals.EquippedChanged:Connect(publishAttributes)
end

return MovementController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX19"><Properties><string name="Name">NetworkController</string><ProtectedString name="Source">--!strict
--[[
	NetworkController
	The single place that translates server remote traffic into client
	State and signals. Keeping it separate means no other controller needs
	to know about remote names.
]]

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local TLoU = ReplicatedStorage:WaitForChild(&quot;TLoU&quot;)
local Shared = TLoU:WaitForChild(&quot;Shared&quot;)

local Net = require(Shared.Net)
local Config = require(Shared.Config)

local State = require(script.Parent.State)

local NetworkController = {}

local player = Players.LocalPlayer

function NetworkController.init()
	Net.get(&quot;Health&quot;).OnClientEvent:Connect(function(value: number, downed: boolean)
		State.health = value
		State.downed = downed
		State.Signals.HealthChanged:Fire(value, downed)
	end)

	Net.get(&quot;Inventory&quot;).OnClientEvent:Connect(function(payload)
		if payload.slots then
			State.slots = payload.slots
		end
		-- Inventory is an authoritative full-state push (join, respawn,
		-- or an explicit Ready request), so always trust its equipped
		-- field. Individual swaps are confirmed separately via SwapResult.
		if payload.equipped then
			State.setEquipped(payload.equipped)
		end
		if payload.magazines then
			for id, count in pairs(payload.magazines) do
				State.magazines[id] = count
			end
		end
		if payload.reserves then
			for id, count in pairs(payload.reserves) do
				State.reserves[id] = count
			end
		end
		State.Signals.AmmoChanged:Fire(State.equipped, 0, 0)
	end)

	Net.get(&quot;HitFeedback&quot;).OnClientEvent:Connect(function(payload)
		State.Signals.HitFeedback:Fire(payload)
	end)

	Net.get(&quot;Noise&quot;).OnClientEvent:Connect(function(position: Vector3, radius: number, sourceUserId: number)
		if sourceUserId == player.UserId then
			State.Signals.Noise:Fire(position, radius, true)
		else
			State.Signals.Noise:Fire(position, radius, false)
		end
	end)

	Net.get(&quot;Effect&quot;).OnClientEvent:Connect(function(kind: string, ...)
		local EffectsController = require(script.Parent.EffectsController)
		if kind == &quot;Explosion&quot; then
			local position, weaponId = ...
			EffectsController.spawnExplosion(position, weaponId)
		elseif kind == &quot;Melee&quot; then
			local character, weaponId, hit = ...
			EffectsController.spawnMelee(character, weaponId, hit)
		elseif kind == &quot;Blood&quot; then
			local position, normal = ...
			EffectsController.spawnBlood(position, normal)
		end
	end)

	State.Signals.HealthChanged:Connect(function(value, downed)
		local HUDController = require(script.Parent.HUDController)
		HUDController.showDowned(downed == true)
	end)

	State.Signals.CharacterChanged:Connect(function()
		State.health = Config.Combat.MaxHealth
		State.downed = false
		local HUDController = require(script.Parent.HUDController)
		HUDController.showDowned(false)
	end)
end

return NetworkController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX20"><Properties><string name="Name">Signal</string><ProtectedString name="Source">--!strict
--[[
	Signal
	Minimal synchronous event emitter. Good enough for intra-client
	controller coordination and has no dependencies.
]]

local Signal = {}
Signal.__index = Signal

export type Connection = { Disconnect: (self: Connection) -&gt; () }
export type Signal = typeof(setmetatable({} :: { _handlers: { (...any) -&gt; () } }, Signal))

function Signal.new()
	return setmetatable({ _handlers = {} }, Signal)
end

function Signal:Connect(handler: (...any) -&gt; ()): Connection
	table.insert(self._handlers, handler)
	local connection
	connection = {
		Disconnect = function()
			local index = table.find(self._handlers, handler)
			if index then
				table.remove(self._handlers, index)
			end
		end,
	}
	return connection
end

function Signal:Fire(...)
	for _, handler in ipairs(self._handlers) do
		task.spawn(handler, ...)
	end
end

return Signal
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX21"><Properties><string name="Name">State</string><ProtectedString name="Source">--!strict
--[[
	State (client)
	A single mutable table that every client controller reads and writes.
	Controllers never require each other directly - they coordinate through
	this state plus a tiny signal bus. That keeps them independently
	replaceable and avoids require cycles.
]]

local Signal = require(script.Parent.Signal)

local State = {}

State.character = nil :: Model?
State.humanoid = nil :: Humanoid?
State.rootPart = nil :: BasePart?
State.head = nil :: BasePart?
State.camera = workspace.CurrentCamera

-- Movement
State.stance = &quot;Stand&quot; :: string -- &quot;Stand&quot; | &quot;Crouch&quot; | &quot;Prone&quot;
State.sprinting = false
State.exhausted = false
State.stamina = 100
State.lean = 0 -- -1 left .. 1 right
State.grounded = true
State.vaulting = false
State.moveSpeed = 0

-- Combat
State.aiming = false
State.reloading = false
State.firing = false
State.equipped = nil :: string?
State.slots = {} :: { string }
State.magazines = {} :: { [string]: number }
State.reserves = {} :: { [string]: number }
State.health = 100
State.downed = false
State.inCombat = false
State.lastDamageAt = 0

-- The weapon model welded into the character's hand (see WeaponController).
State.viewmodel = nil :: Model?
State.recoil = Vector2.new(0, 0)
State.recoilVelocity = Vector2.new(0, 0)

-- Last authoritative hit the local player landed (for the HUD hitmarker).
State.lastHitAt = 0
State.lastHitLethal = false

-- Signals
State.Signals = {
	CharacterChanged = Signal.new(),
	StanceChanged = Signal.new(),
	EquippedChanged = Signal.new(),
	HealthChanged = Signal.new(),
	AmmoChanged = Signal.new(),
	HitFeedback = Signal.new(),
	Noise = Signal.new(),
	Fired = Signal.new(),
	Shake = Signal.new(),
}

function State.setStance(stance: string)
	if State.stance ~= stance then
		State.stance = stance
		State.Signals.StanceChanged:Fire(stance)
	end
end

function State.setEquipped(weaponId: string?)
	if State.equipped ~= weaponId then
		State.equipped = weaponId
		State.Signals.EquippedChanged:Fire(weaponId)
	end
end

return State
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX22"><Properties><string name="Name">WeaponController</string><ProtectedString name="Source">--!strict
--[[
	WeaponController
	Everything the player does with a weapon in hand.

	Third person changes how a weapon is presented. There is no camera
	viewmodel here: the weapon is welded into the character's right hand, so
	you see your own gun in the world exactly as everyone else does. The
	animator carries it - the arm pose it already produces for walking,
	aiming, crouching and vaulting moves the gun with it, so there is only
	one source of truth for where the weapon is.

	That also fixes a whole class of first-person bugs: no camera-parented
	geometry to clip through walls, no viewmodel that has to be hidden from
	other players, and no divergence between what you see and what they see.

	Firing, reloading, swapping, melee and throwing are driven from here and
	validated server-side.
]]

local Players = game:GetService(&quot;Players&quot;)
local RunService = game:GetService(&quot;RunService&quot;)
local UserInputService = game:GetService(&quot;UserInputService&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local TLoU = ReplicatedStorage:WaitForChild(&quot;TLoU&quot;)
local Shared = TLoU:WaitForChild(&quot;Shared&quot;)

local Config = require(Shared.Config)
local Weapons = require(Shared.Weapons)
local WeaponModels = require(Shared.WeaponModels)
local Net = require(Shared.Net)
local Util = require(Shared.Util)

local State = require(script.Parent.State)

local WeaponController = {}

local player = Players.LocalPlayer
local camera = workspace.CurrentCamera

-- Held weapon ----------------------------------------------------------
local weaponModel: Model? = nil
local weaponWeld: Weld? = nil
local handle: BasePart? = nil
local muzzle: BasePart? = nil

-- Runtime --------------------------------------------------------------
local lastShotAt = 0
local nextFireAllowed = 0
local triggerHeld = false
local boltCycling = false
local pumpCycling = false
local reloadStartAt = 0
local swapStartAt = 0
local raiseAlpha = 1

local currentData = nil :: any

--- Where the camera is looking, as a ray. Shots originate from the muzzle
--- so the tracer leaves the barrel, but they are aimed along the camera's
--- centre line so the crosshair tells the truth.
local function getAimRay(): (Vector3, Vector3)
	local origin = camera.CFrame.Position
	local direction = camera.CFrame.LookVector

	local muzzlePos = origin + direction * 1.5
	if muzzle and muzzle.Parent then
		muzzlePos = muzzle.Position
	end

	-- Find what the crosshair is on, then aim the muzzle at that point.
	local params = RaycastParams.new()
	params.FilterType = Enum.RaycastFilterType.Exclude
	params.FilterDescendantsInstances = { State.character :: any }
	params.IgnoreWater = true

	local hit = workspace:Raycast(origin, direction * Config.Combat.MaxRange, params)
	local aimPoint = hit and hit.Position or (origin + direction * Config.Combat.MaxRange)
	local shotDirection = (aimPoint - muzzlePos).Unit

	return muzzlePos, shotDirection
end

--- Applies spread jitter client-side for the visual tracer only. The
--- server independently rolls spread for damage, so cheating the visual
--- does not change hit registration.
local function spreadDirection(direction: Vector3, degrees: number): Vector3
	if degrees &lt;= 0 then
		return direction
	end
	local rad = math.rad(degrees)
	local jitter = Vector3.new(
		(math.random() - 0.5) * 2 * rad,
		(math.random() - 0.5) * 2 * rad,
		0
	)
	return (direction + jitter).Unit
end

-- Weapon attachment ----------------------------------------------------
local function destroyWeapon()
	if weaponWeld then
		weaponWeld:Destroy()
		weaponWeld = nil
	end
	if weaponModel then
		weaponModel:Destroy()
		weaponModel = nil
	end
	handle = nil
	muzzle = nil
	State.viewmodel = nil
end

--- Where the weapon sits in the hand, in the right arm's local space.
--- The R6 right arm points along its own -Y when it hangs, and swings to
--- point forward when the animator raises it. Welding the gun so its barrel
--- runs along the arm's -Y means one offset reads correctly in every pose:
--- muzzle-down at the side when idle, level and forward when aiming.
local function gripOffsetFor(data): CFrame
	local hand = CFrame.new(0, -1, 0)
	local align = CFrame.Angles(math.rad(-90), 0, 0)

	if data.category == &quot;Melee&quot; then
		-- A blade is held further out and angled back a little.
		return CFrame.new(0, -1.1, -0.1) * align * CFrame.Angles(math.rad(-20), 0, 0)
	elseif data.model == &quot;Pistol&quot; or data.model == &quot;Revolver&quot; then
		-- Short guns sit close to the hand.
		return CFrame.new(0, -0.85, 0.05) * align
	end
	return hand * align
end

local function buildWeapon(weaponId: string)
	destroyWeapon()

	local data = Weapons.get(weaponId)
	if not data then
		return
	end
	currentData = data

	-- Throwables are carried in the hand too, but they are not welded: they
	-- leave the hand on throw, so the model is only built when thrown.
	if data.category == &quot;Throwable&quot; then
		return
	end

	local character = State.character
	if not character then
		return
	end
	local arm = character:FindFirstChild(&quot;Right Arm&quot;)
	if not arm or not arm:IsA(&quot;BasePart&quot;) then
		return
	end

	weaponModel = WeaponModels.build(data)
	weaponModel.Parent = character
	handle = weaponModel.PrimaryPart
	muzzle = weaponModel:FindFirstChild(&quot;Muzzle&quot;) :: BasePart?

	local weld = Instance.new(&quot;Weld&quot;)
	weld.Name = &quot;TLoUWeaponWeld&quot;
	weld.Part0 = arm
	weld.Part1 = handle
	weld.C0 = gripOffsetFor(data)
	weld.C1 = CFrame.new()
	weld.Parent = arm
	weaponWeld = weld

	State.viewmodel = weaponModel
	raiseAlpha = 0
end

--- Tells the animator this character is holding something, so the arms are
--- carried in a low-ready pose rather than swinging loose.
local function publishArmed()
	local character = State.character
	if not character then
		return
	end
	local armed = State.equipped ~= nil
	character:SetAttribute(&quot;Armed&quot;, armed)
	character:SetAttribute(&quot;Melee&quot;, armed and currentData ~= nil and Weapons.isMelee(currentData) or false)
end

-- Firing ---------------------------------------------------------------
local function canFire(): boolean
	if not currentData or not Weapons.isFirearm(currentData) then
		return false
	end
	if State.reloading or State.downed or State.vaulting then
		return false
	end
	if State.stance == &quot;Prone&quot; then
		return false -- cannot fire while crawling
	end
	if raiseAlpha &lt; 0.6 then
		return false
	end
	local mag = State.magazines[currentData.id] or 0
	if mag &lt;= 0 then
		return false
	end
	return os.clock() &gt;= nextFireAllowed
end

local function doReload()
	local data = currentData
	if not data or not Weapons.isFirearm(data) then
		return
	end
	if State.reloading then
		return
	end
	local mag = State.magazines[data.id] or 0
	if mag &gt;= data.magazine then
		return
	end
	if (State.reserves[data.id] or 0) &lt;= 0 then
		return
	end

	State.reloading = true
	reloadStartAt = os.clock()
	Net.toServer(&quot;Reload&quot;, data.id)

	task.delay(data.reloadTime + 0.1, function()
		if State.reloading and os.clock() - reloadStartAt &gt;= data.reloadTime then
			State.reloading = false
		end
	end)
end

local function fireOnce()
	local data = currentData
	if not data then
		return
	end

	if not canFire() then
		if (State.magazines[data.id] or 0) &lt;= 0 and not State.reloading then
			doReload()
		end
		return
	end

	if boltCycling or pumpCycling then
		return
	end

	State.magazines[data.id] = (State.magazines[data.id] or 0) - 1
	nextFireAllowed = os.clock() + (60 / data.rpm)
	lastShotAt = os.clock()

	local origin, direction = getAimRay()
	local spread = State.aiming and data.aimSpread or data.bulletSpread
	local shotDirection = spreadDirection(direction, spread)

	Net.toServer(&quot;Fire&quot;, {
		weapon = data.id,
		origin = origin,
		direction = shotDirection,
	})

	-- Immediate local feedback.
	local kickPitch = data.recoil * (State.aiming and 0.6 or 1)
	local kickYaw = (math.random() - 0.5) * data.recoil * 0.5
	State.Signals.Fired:Fire(kickPitch, kickYaw)

	local Effects = require(script.Parent.EffectsController)
	Effects.spawnTracer(origin, origin + shotDirection * data.range, data.silenced)
	if muzzle and muzzle.Parent then
		Effects.spawnMuzzleFlash(muzzle)
	end
	if handle and handle.Parent then
		Effects.ejectShell(handle, data)
	end

	State.Signals.AmmoChanged:Fire(data.id, State.magazines[data.id], State.reserves[data.id] or 0)

	if data.fireMode == &quot;Bolt&quot; then
		boltCycling = true
		task.delay(60 / data.rpm, function()
			boltCycling = false
		end)
	elseif data.fireMode == &quot;Pump&quot; then
		pumpCycling = true
		task.delay(60 / data.rpm * 0.7, function()
			pumpCycling = false
		end)
	end
end

local function doMelee()
	local data = currentData
	if not data or not Weapons.isMelee(data) then
		return
	end
	if State.downed or State.reloading then
		return
	end
	local origin = camera.CFrame.Position
	local direction = camera.CFrame.LookVector
	Net.toServer(&quot;Melee&quot;, { weapon = data.id, origin = origin, direction = direction })
	State.Signals.Shake:Fire(0.25, 0.15)
end

local function doThrow()
	local data = currentData
	if not data or not Weapons.isThrowable(data) then
		return
	end
	local direction = camera.CFrame.LookVector
	Net.toServer(&quot;Throw&quot;, { weapon = data.id, direction = direction })
end

local function swapTo(index: number)
	local slots = State.slots
	if #slots == 0 then
		return
	end
	index = ((index - 1) % #slots) + 1
	local weaponId = slots[index]
	if not weaponId or weaponId == State.equipped then
		return
	end

	State.reloading = false
	swapStartAt = os.clock()
	State.setEquipped(weaponId)
	Net.toServer(&quot;Swap&quot;, weaponId)
end

local function cycleWeapon()
	local slots = State.slots
	if #slots == 0 then
		return
	end
	local currentIndex = table.find(slots, State.equipped) or 0
	swapTo(currentIndex + 1)
end

-- Input ----------------------------------------------------------------
local function bindInput()
	UserInputService.InputBegan:Connect(function(inputObject, processed)
		if processed then
			return
		end

		if inputObject.UserInputType == Config.Keys.Fire then
			triggerHeld = true
			fireOnce()
		elseif inputObject.UserInputType == Config.Keys.Aim then
			if currentData and Weapons.isThrowable(currentData) then
				doThrow()
			else
				State.aiming = true
			end
		elseif inputObject.KeyCode == Config.Keys.Reload then
			doReload()
		elseif inputObject.KeyCode == Config.Keys.Melee then
			doMelee()
		elseif inputObject.KeyCode == Config.Keys.Throw then
			doThrow()
		elseif inputObject.KeyCode == Config.Keys.Swap then
			cycleWeapon()
		elseif inputObject.KeyCode == Config.Keys.Heal then
			Net.toServer(&quot;Heal&quot;)
		elseif inputObject.KeyCode == Enum.KeyCode.One then
			swapTo(1)
		elseif inputObject.KeyCode == Enum.KeyCode.Two then
			swapTo(2)
		elseif inputObject.KeyCode == Enum.KeyCode.Three then
			swapTo(3)
		elseif inputObject.KeyCode == Enum.KeyCode.Four then
			swapTo(4)
		end
	end)

	UserInputService.InputEnded:Connect(function(inputObject)
		if inputObject.UserInputType == Config.Keys.Fire then
			triggerHeld = false
		elseif inputObject.UserInputType == Config.Keys.Aim then
			State.aiming = false
		end
	end)
end

local function update(dt: number)
	-- Raise blend, used to gate firing right after a swap.
	local raiseTarget = 1
	if swapStartAt &gt; 0 and currentData then
		if os.clock() - swapStartAt &lt; currentData.raiseTime then
			raiseTarget = 0
		else
			swapStartAt = 0
		end
	end
	raiseAlpha += (raiseTarget - raiseAlpha) * Util.damp(dt, 9)

	-- Full-auto fire loop.
	if triggerHeld and currentData and currentData.fireMode == &quot;Auto&quot; then
		fireOnce()
	end
end

function WeaponController.init()
	camera = workspace.CurrentCamera
	bindInput()

	Net.get(&quot;ReloadResult&quot;).OnClientEvent:Connect(function(weaponId, mag, reserve)
		State.reloading = false
		State.magazines[weaponId] = mag
		State.reserves[weaponId] = reserve
		State.Signals.AmmoChanged:Fire(weaponId, mag, reserve)
	end)

	Net.get(&quot;SwapResult&quot;).OnClientEvent:Connect(function(weaponId)
		-- Server acknowledged the swap; nothing extra to do client-side.
	end)

	-- The server's FireResult is authoritative. For our own shots we skip
	-- the tracer (already drawn locally for zero-latency feel) but still
	-- draw the impacts, which the server alone knows.
	Net.get(&quot;FireResult&quot;).OnClientEvent:Connect(function(shooter, payload)
		local Effects = require(script.Parent.EffectsController)
		if shooter ~= player then
			Effects.spawnTracer(payload.origin, payload.origin + payload.direction * 200, payload.silenced)
		end
		for _, impact in ipairs(payload.impacts or {}) do
			if impact.character then
				Effects.spawnBlood(impact.position, impact.normal)
			else
				Effects.spawnImpact(impact.position, impact.normal, impact.material)
			end
		end
	end)

	State.Signals.EquippedChanged:Connect(function(weaponId)
		if weaponId then
			buildWeapon(weaponId)
		else
			destroyWeapon()
		end
		publishArmed()
	end)

	State.Signals.CharacterChanged:Connect(function()
		destroyWeapon()
		if State.equipped then
			buildWeapon(State.equipped)
		end
		publishArmed()
	end)

	RunService.RenderStepped:Connect(update)
end

return WeaponController
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX23"><Properties><string name="Name">WeaponVisualController</string><ProtectedString name="Source">--!strict
--[[
	WeaponVisualController
	Puts a weapon model in every other player's hand.

	In first person you only ever see your own gun, so this did not need to
	exist. In third person every character is on screen, and a character
	walking around with empty hands while the server says they are holding a
	rifle breaks the illusion instantly.

	The server records what each player holds as an &quot;EquippedWeapon&quot;
	attribute on their character. Attributes replicate and are replayed to
	players who join later, so this controller needs no networking of its
	own - it just watches the attribute and rebuilds the model when it
	changes.

	The local player's own weapon is handled by WeaponController (which also
	drives firing), so this one skips them.
]]

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local TLoU = ReplicatedStorage:WaitForChild(&quot;TLoU&quot;)
local Shared = TLoU:WaitForChild(&quot;Shared&quot;)

local Weapons = require(Shared.Weapons)
local WeaponModels = require(Shared.WeaponModels)

local State = require(script.Parent.State)

local WeaponVisualController = {}

local player = Players.LocalPlayer

--- character -&gt; { model, weld, connection }
local attached: { [Model]: any } = {}

--- The same grip offset WeaponController uses, so the local player's weapon
--- and everyone else's sit in the hand identically.
local function gripOffsetFor(data): CFrame
	local align = CFrame.Angles(math.rad(-90), 0, 0)
	if data.category == &quot;Melee&quot; then
		return CFrame.new(0, -1.1, -0.1) * align * CFrame.Angles(math.rad(-20), 0, 0)
	elseif data.model == &quot;Pistol&quot; or data.model == &quot;Revolver&quot; then
		return CFrame.new(0, -0.85, 0.05) * align
	end
	return CFrame.new(0, -1, 0) * align
end

local function detach(character: Model)
	local entry = attached[character]
	if not entry then
		return
	end
	if entry.connection then
		entry.connection:Disconnect()
	end
	if entry.model then
		entry.model:Destroy()
	end
	attached[character] = nil
end

local function attach(character: Model, weaponId: string?)
	detach(character)

	if not weaponId then
		return
	end
	local data = Weapons.get(weaponId)
	if not data or data.category == &quot;Throwable&quot; then
		return
	end

	local arm = character:FindFirstChild(&quot;Right Arm&quot;)
	if not arm or not arm:IsA(&quot;BasePart&quot;) then
		return
	end

	local model = WeaponModels.build(data)
	model.Parent = character
	local handle = model.PrimaryPart
	if not handle then
		model:Destroy()
		return
	end

	local weld = Instance.new(&quot;Weld&quot;)
	weld.Name = &quot;TLoUWeaponWeld&quot;
	weld.Part0 = arm
	weld.Part1 = handle
	weld.C0 = gripOffsetFor(data)
	weld.C1 = CFrame.new()
	weld.Parent = arm

	local entry = { model = model, weld = weld, connection = nil }

	-- If the arm is replaced (a respawn or a rig swap), the weld dies with
	-- it. Re-attach rather than leaving the weapon floating.
	entry.connection = arm.Destroying:Connect(function()
		if attached[character] == entry then
			attached[character] = nil
			entry.model:Destroy()
		end
	end)

	attached[character] = entry
end

local function watch(character: Model)
	if not character:IsA(&quot;Model&quot;) then
		return
	end
	if character == player.Character then
		return -- the local player's weapon is WeaponController's job
	end
	if not character:FindFirstChildOfClass(&quot;Humanoid&quot;) then
		return
	end

	-- Wait for the arm to exist before welding anything to it.
	task.spawn(function()
		local arm = character:WaitForChild(&quot;Right Arm&quot;, 5)
		if not arm then
			return
		end
		attach(character, character:GetAttribute(&quot;EquippedWeapon&quot;))

		character:GetAttributeChangedSignal(&quot;EquippedWeapon&quot;):Connect(function()
			if attached[character] then
				detach(character)
			end
			attach(character, character:GetAttribute(&quot;EquippedWeapon&quot;))
		end)
	end)
end

function WeaponVisualController.init()
	for _, other in ipairs(Players:GetPlayers()) do
		if other ~= player and other.Character then
			watch(other.Character)
		end
		other.CharacterAdded:Connect(watch)
	end

	Players.PlayerAdded:Connect(function(other)
		other.CharacterAdded:Connect(watch)
		if other.Character then
			watch(other.Character)
		end
	end)

	Players.PlayerRemoving:Connect(function(other)
		if other.Character then
			detach(other.Character)
		end
	end)

	workspace.ChildRemoved:Connect(function(child)
		if child:IsA(&quot;Model&quot;) and attached[child] then
			detach(child)
		end
	end)
end

return WeaponVisualController
</ProtectedString></Properties></Item></Item><Item class="LocalScript" referent="RBX24"><Properties><string name="Name">Bootstrap</string><ProtectedString name="Source">--!strict
--[[
	Bootstrap (StarterPlayerScripts)
	Starts every client controller in dependency order. Put this in
	StarterPlayerScripts as a LocalScript, with the &quot;Controllers&quot; folder
	as a sibling.

	Order matters: State -&gt; Network -&gt; Movement -&gt; Animator -&gt; Camera -&gt;
	Effects -&gt; Weapon -&gt; HUD. The animator must exist before the camera
	(the camera turns the body, and the animator reads the resulting turn
	rate), and State must exist before anything else.
]]

local Players = game:GetService(&quot;Players&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local TLoU = ReplicatedStorage:WaitForChild(&quot;TLoU&quot;)
local Shared = TLoU:WaitForChild(&quot;Shared&quot;)

local Net = require(Shared.Net) -- ensures remotes exist before use

local Controllers = script.Parent:WaitForChild(&quot;Controllers&quot;)

local State = require(Controllers:WaitForChild(&quot;State&quot;))
local NetworkController = require(Controllers:WaitForChild(&quot;NetworkController&quot;))
local MovementController = require(Controllers:WaitForChild(&quot;MovementController&quot;))
local AnimatorController = require(Controllers:WaitForChild(&quot;AnimatorController&quot;))
local CameraController = require(Controllers:WaitForChild(&quot;CameraController&quot;))
local EffectsController = require(Controllers:WaitForChild(&quot;EffectsController&quot;))
local WeaponController = require(Controllers:WaitForChild(&quot;WeaponController&quot;))
local WeaponVisualController = require(Controllers:WaitForChild(&quot;WeaponVisualController&quot;))
local HUDController = require(Controllers:WaitForChild(&quot;HUDController&quot;))

-- Expose State globally so other scripts (and the console) can inspect it.
_G.TLoUState = State

HUDController.init()
NetworkController.init()
MovementController.init()
AnimatorController.init()
CameraController.init()
EffectsController.init()
WeaponController.init()
WeaponVisualController.init()

-- Tell the server we are ready and ask for a fresh copy of our state.
-- This covers the spawn race where the loadout was sent before our
-- listeners existed.
Net.toServer(&quot;Ready&quot;)

-- Keep the camera reference fresh if the viewport changes.
workspace:GetPropertyChangedSignal(&quot;CurrentCamera&quot;):Connect(function()
	State.camera = workspace.CurrentCamera
end)

print(&quot;[TLoU] Client mechanics online.&quot;)
</ProtectedString></Properties></Item></Item></Item></Item></Item><Item class="Players" referent="RBX97"><Properties><string name="Name">Players</string></Properties><float name="RespawnTime">4</float><float name="CharacterAutoLoads">true</float></Item><Item class="SoundService" referent="RBX98"><Properties><string name="Name">SoundService</string></Properties><bool name="RespectFilteringEnabled">true</bool></Item><Item class="StarterGui" referent="RBX99"><Properties><string name="Name">StarterGui</string></Properties><bool name="ResetPlayerGuiOnSpawn">true</bool></Item></roblox>