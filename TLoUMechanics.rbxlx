/R21><R22>1</R22></CoordinateFrame><Color3 name="Color"><R>0.2901960784313726</R><G>0.2196078431372549</G><B>0.1568627450980392</B></Color3><token name="Material">512</token><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="LeftSurface">0</token><token name="RightSurface">0</token><token name="FrontSurface">0</token><token name="BackSurface">0</token></Properties></Item><Item class="Part" referent="RBX73"><Properties><string name="Name">Canopy</string><Vector3 name="size"><X>18</X><Y>14</Y><Z>18</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>24</Y><Z>150</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3 name="Color"><R>0.18823529411764706</R><G>0.2823529411764706</G><B>0.16470588235294117</B></Color3><token name="Material">1280</token><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="LeftSurface">0</token><token name="RightSurface">0</token><token name="FrontSurface">0</token><token name="BackSurface">0</token></Properties></Item><Item class="Part" referent="RBX74"><Properties><string name="Name">Trunk</string><Vector3 name="size"><X>3</X><Y>20</Y><Z>3</Z></Vector3><CoordinateFrame name="CFrame"><X>0</X><Y>10</Y><Z>-150</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3 name="Color"><R>0.2901960784313726</R><G>0.2196078431372549</G><B>0.1568627450980392</B></Color3><token name="Material">512</token><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="LeftSurface">0</token><token name="RightSurface">0</token><token name="FrontSurface">0</token><token name="BackSurface">0</token></Properties><