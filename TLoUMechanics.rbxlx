ce">0</token><token name="RightSurface">0</token><token name="FrontSurface">0</token><token name="BackSurface">0</token></Properties></Item><Item class="Part" referent="RBX83"><Properties><string name="Name">Canopy</string><Vector3 name="size"><X>18</X><Y>14</Y><Z>18</Z></Vector3><CoordinateFrame name="CFrame"><X>-140</X><Y>24</Y><Z>-40</Z><R00>1</R00><R01>0</R01><R02>0</R02><R10>0</R10><R11>1</R11><R12>0</R12><R20>0</R20><R21>0</R21><R22>1</R22></CoordinateFrame><Color3 name="Color"><R>0.18823529411764706</R><G>0.2823529411764706</G><B>0.16470588235294117</B></Color3><token name="Material">1280</token><bool name="Anchored">true</bool><bool name="CanCollide">true</bool><token name="TopSurface">0</token><token name="BottomSurface">0</token><token name="LeftSurface">0</token><token name="RightSurface">0</token><token name="FrontSurface">0</token><token name="BackSurface">0</token></Properties></Item><Item class="Terrain" referent="RBX84"><Properties><string name="Name">Terrain</string></Properties></Item></Item><Item class="Lighting" referent="RBX86"><Properties><string name="Name">Lighting</string><Color3 name="Ambient"><R>0.22745098039215686</R><G>0.22745098039215686</G><B>0.24313725490196078</B></Color3><Color3 name="OutdoorAmbient"><R>0.3686274509803922</R><G>0.3764705882352941</G><B>0.39215686274509803</B></Color3><Color3 name="ColorShift_Top"><R>0.47058823529411764</R><G>0.4549019607843137</G><B>0.40784313725490196</B></Color3><Color3 name="FogColor"><R>0.47843137254901963</R><G>0.48627450980392156</G><B>0.47058823529411764</B></Color3><float name="Brightness">2</float><float name="ClockTime">16.4</float><float name="GeographicLatitude">41</float><bool name="GlobalShadows">true</bool><float name="FogEnd">620</float><float name="FogStart">120</float><float name="EnvironmentDiffuseScale">0.35</float><float name="EnvironmentSpecularScale">0.35</float><token name="Technology">2</token></Properties></Item><Item class="ReplicatedStorage" referent="RBX89"><Properties><string name="Name">ReplicatedStorage</string></Properties><Item class="Folder" referent="RBX88"><Properties><string name="Name">TLoU</string></Properties><Item class="Folder" referent="RBX87"><Properties><string name="Name">Shared</string></Properties><Item class="ModuleScript" referent="RBX1"><Properties><string name="Name">AnimationSystem</string><ProtectedString name="Source">--!strict
--[[
	AnimationSystem
	The maths behind every character animation in the pack. It is a pure
	function: given how the character is moving, it returns a pose. No
	Roblox state, no instances, no side effects - which makes it testable
	and makes the animator that applies it trivial.

	Why not Roblox animation assets?
	* The pack has to drop into any place with no upload step, so there are
	  no animation ids to reference.
	* We need poses that depend on live state (aim, lean, turn rate, how
	  fast you are actually moving). A fixed clip cannot blend like that.

	A pose is expressed in the character's own frame, in degrees:
	    pitch  rotation about the character's right axis (swing forward)
	    yaw    rotation about the character's up axis (twist)
	    roll   rotation about the character's forward axis (tilt)
	and, for the root, a world-space offset. The animator converts those
	into Motor6D.Transform values. Authoring in degrees in the character's
	frame is what keeps a walk cycle readable no matter which way you face.
]]

local Config = require(script.Parent.Config)

local AnimationSystem = {}

local ANIM = Config.Animation
local MOVE = Config.Movement

-- Stance weights are 0..1 blends the caller smooths over time.
AnimationSystem.EMPTY_WEIGHTS = {
	crouch = 0,
	prone = 0,
	aim = 0,
	sprint = 0,
	air = 0,
	vault = 0,
	downed = 0,
	armed = 0,
}

local function clamp01(v: number): number
	return math.max(0, math.min(1, v))
end

local function lerp(a: number, b: number, t: number): number
	return a + (b - a) * t
end

--- A fresh set of animation accumulators. The caller owns one of these per
--- character and passes it back on every call.
function AnimationSystem.newState()
	return {
		phase = 0, -- walk cycle, in radians
		turnPhase = 0, -- turn-in-place stepping, in radians
		breath = 0, -- idle breathing timer, in seconds
		lastYaw = nil, -- previous body yaw, for measuring turn rate
	}
end

--- One pose channel. Everything starts at rest so a pose is just data.
local function channel(): { pitch: number, yaw: number, roll: number }
	return { pitch = 0, yaw = 0, roll = 0 }
end

--- How fast the walk cycle should advance this frame, in radians.
--- Driving the phase from distance travelled is what stops the feet from
--- skating: walk slower and the legs cycle slower, automatically.
function AnimationSystem.strideAdvance(speed: number, sprinting: boolean, dt: number): number
	local perStud = (math.pi * 2) / math.max(ANIM.StrideLength, 0.1)
	local boost = sprinting and ANIM.SprintStrideBoost or 1
	return speed * perStud * boost * dt
end

--- How much the body should yaw this frame toward the camera, plus the
--- resulting turn rate. Turn rate is what feeds turn-in-place stepping, so
--- this is the single place that decides how heavy a turn feels.
---
--- `boost` scales the turn speed. The camera uses it while the player is
--- moving, so a strafe snaps the body around rather than turning it with a
--- slow pirouette.
function AnimationSystem.bodyTurn(currentYaw: number, targetYaw: number, aiming: boolean, dt: number, boost: number?): (number, number)
	local delta = math.atan2(math.sin(targetYaw - currentYaw), math.cos(targetYaw - currentYaw))
	local speed = (aiming and MOVE.TurnSpeedAiming or MOVE.TurnSpeed) * (boost or 1)
	local step = delta * (1 - math.exp(-speed * dt))
	return currentYaw + step, step / math.max(dt, 1e-4)
end

--- Computes the pose for this frame.
---
--- input fields:
---   dt         delta time
---   speed      horizontal speed in studs/second
---   turnRate   signed yaw rate in radians/second
---   grounded   standing on something
---   weights    stance blend weights (see EMPTY_WEIGHTS)
---   anim       accumulator from newState() (mutated in place)
function AnimationSystem.computePose(input)
	local dt = input.dt
	local speed = input.speed or 0
	local turnRate = input.turnRate or 0
	local grounded = input.grounded ~= false
	local w = input.weights or AnimationSystem.EMPTY_WEIGHTS
	local anim = input.anim

	local crouch = clamp01(w.crouch or 0)
	local prone = clamp01(w.prone or 0)
	local aim = clamp01(w.aim or 0)
	local sprint = clamp01(w.sprint or 0)
	local air = clamp01(w.air or 0)
	local vault = clamp01(w.vault or 0)
	local downed = clamp01(w.downed or 0)
	local armed = clamp01(w.armed or 0)

	-- Grounded locomotion only counts while actually on the floor.
	local moving = speed &gt; 0.6 and grounded
	local speedFactor = math.clamp(speed / math.max(MOVE.WalkSpeed, 1), 0, 1.8)
	local cycleFactor = math.min(speedFactor, 1.35)

	-- Advance the walk cycle by distance travelled.
	local phase = anim.phase or 0
	if moving then
		phase = (phase + AnimationSystem.strideAdvance(speed, sprint &gt; 0.5, dt)) % (math.pi * 2)
	end
	anim.phase = phase

	-- Turn-in-place: when the body yaws but the feet are not travelling,
	-- step them. This is the detail that makes a third-person character
	-- read as &quot;turning&quot; rather than pivoting like a turret.
	local turnPhase = anim.turnPhase or 0
	local turning = grounded and speed &lt; ANIM.TurnMinSpeed and math.abs(turnRate) &gt; ANIM.TurnDeadzone
	local turnDir = 0
	if turning then
		turnDir = turnRate &gt; 0 and 1 or -1
		turnPhase = turnPhase + math.abs(turnRate) * ANIM.TurnStepRate * dt
	end
	anim.turnPhase = turnPhase

	-- Idle breathing timer.
	local breath = (anim.breath or 0) + dt
	anim.breath = breath

	-- ------------------------------------------------------------------
	-- Base walk cycle
	-- ------------------------------------------------------------------
	local legAmp = lerp(ANIM.LegSwing, ANIM.RunLegSwing, sprint) * cycleFactor
	local armAmp = lerp(ANIM.ArmSwing, ANIM.RunArmSwing, sprint) * cycleFactor
	-- Aiming pins the arms to the weapon.
	armAmp = armAmp * (1 - aim * 0.85)

	local swing = math.sin(phase)
	local swingAbs = math.abs(swing)

	local leftLeg = channel()
	local rightLeg = channel()
	local leftArm = channel()
	local rightArm = channel()
	local torso = channel()
	local head = channel()
	local root = channel()

	leftLeg.pitch = swing * legAmp
	rightLeg.pitch = -swing * legAmp
	-- Arms swing opposite the legs.
	rightArm.pitch = swing * armAmp
	leftArm.pitch = -swing * armAmp

	-- Shoulders counter-rotate against the hips.
	torso.yaw = -swing * ANIM.TorsoYaw * cycleFactor
	torso.roll = -math.cos(phase) * ANIM.TorsoRoll * cycleFactor
	-- Sprinting pitches the torso forward.
	torso.pitch = ANIM.LeanForward * sprint * cycleFactor

	-- Feet leave the ground slightly at the peak of the stride.
	local footLift = swingAbs * cycleFactor
	leftLeg.pitch = leftLeg.pitch - footLift * 4
	rightLeg.pitch = rightLeg.pitch - footLift * 4

	-- Body bob: up at mid-stride, plus a little lateral sway.
	local bobY = swingAbs * ANIM.BobAmplitude * (0.6 + cycleFactor * 0.5)
	local bobX = math.cos(phase) * ANIM.BobLateral * cycleFactor

	-- ------------------------------------------------------------------
	-- Turn-in-place stepping
	-- ------------------------------------------------------------------
	if turning then
		local step = math.sin(turnPhase) * ANIM.TurnStepSwing
		-- The leading foot depends on which way we are turning.
		leftLeg.pitch = leftLeg.pitch + step * turnDir
		rightLeg.pitch = rightLeg.pitch - step * turnDir
		torso.yaw = torso.yaw + step * 0.25 * turnDir
		bobY = bobY + math.abs(math.sin(turnPhase)) * ANIM.BobAmplitude * 0.5
	else
		-- Let the stepping phase decay to zero so it does not pop.
		anim.turnPhase = turnPhase * (1 - math.min(1, 6 * dt))
	end

	-- ------------------------------------------------------------------
	-- Idle breathing (only when not moving, so it never fights the stride)
	-- ------------------------------------------------------------------
	local idleWeight = (1 - clamp01(speedFactor)) * (1 - prone) * (1 - downed)
	if idleWeight &gt; 0 then
		local breathCycle = math.sin(breath * math.pi * 2 * ANIM.IdleBreath)
		torso.pitch = torso.pitch + breathCycle * ANIM.IdleBreathAmp * idleWeight
		leftArm.pitch = leftArm.pitch + breathCycle * ANIM.IdleBreathAmp * 0.5 * idleWeight
		rightArm.pitch = rightArm.pitch + breathCycle * ANIM.IdleBreathAmp * 0.5 * idleWeight
	end

	-- ------------------------------------------------------------------
	-- Armed: carry the weapon at the hip, or raise it to aim
	-- ------------------------------------------------------------------
	if armed &gt; 0 then
		-- Blend from a free-swinging arm to a braced, weapon-carrying arm.
		-- Even while walking the arms stay mostly braced, which is what
		-- reads as &quot;carrying a gun&quot; rather than &quot;walking hands free&quot;.
		local brace = armed * (1 - aim * 0.15)
		leftArm.pitch = lerp(leftArm.pitch, ANIM.ReadyLeftArmPitch, brace)
		rightArm.pitch = lerp(rightArm.pitch, ANIM.ReadyArmPitch, brace)
		leftArm.yaw = lerp(leftArm.yaw, -ANIM.ReadyArmYaw, brace)
		rightArm.yaw = lerp(rightArm.yaw, ANIM.ReadyArmYaw, brace)
		torso.yaw = lerp(torso.yaw, torso.yaw * 0.4, brace)
	end

	-- ------------------------------------------------------------------
	-- Aiming: raise both arms to the weapon and bring them together
	-- ------------------------------------------------------------------
	if aim &gt; 0 then
		leftArm.pitch = lerp(leftArm.pitch, ANIM.AimArmPitch, aim)
		rightArm.pitch = lerp(rightArm.pitch, ANIM.AimArmPitch, aim)
		leftArm.yaw = lerp(leftArm.yaw, -ANIM.AimArmYaw, aim)
		rightArm.yaw = lerp(rightArm.yaw, ANIM.AimArmYaw, aim)
		torso.yaw = lerp(torso.yaw, 0, aim * 0.7)
	end

	-- ------------------------------------------------------------------
	-- Stances: crouch, prone, downed, air, vault
	-- ------------------------------------------------------------------
	local drop = 0

	if crouch &gt; 0 then
		torso.pitch = lerp(torso.pitch, ANIM.CrouchTorsoPitch, crouch)
		leftLeg.pitch = lerp(leftLeg.pitch, ANIM.CrouchLegPitch, crouch)
		rightLeg.pitch = lerp(rightLeg.pitch, ANIM.CrouchLegPitch, crouch)
		-- Knees bend outward a touch so the pose does not look flat.
		leftLeg.roll = lerp(leftLeg.roll, -6, crouch)
		rightLeg.roll = lerp(rightLeg.roll, 6, crouch)
		drop = drop + ANIM.CrouchDrop * crouch
	end

	if prone &gt; 0 or downed &gt; 0 then
		local lie = math.max(prone, downed)
		root.pitch = lerp(root.pitch, ANIM.ProneTorsoPitch, lie)
		leftLeg.pitch = lerp(leftLeg.pitch, ANIM.ProneLegPitch, lie)
		rightLeg.pitch = lerp(rightLeg.pitch, ANIM.ProneLegPitch, lie)
		leftArm.pitch = lerp(leftArm.pitch, ANIM.ProneArmPitch, lie * 0.7)
		rightArm.pitch = lerp(rightArm.pitch, ANIM.ProneArmPitch, lie * 0.7)
		drop = drop + ANIM.ProneDrop * lie
		bobX = 0
		bobY = 0
	end

	if air &gt; 0 then
		-- Legs tuck up and arms come out for balance.
		leftLeg.pitch = lerp(leftLeg.pitch, ANIM.AirLegPitch, air)
		rightLeg.pitch = lerp(rightLeg.pitch, -ANIM.AirLegPitch * 0.4, air)
		leftArm.pitch = lerp(leftArm.pitch, ANIM.AirArmPitch, air * (1 - aim))
		rightArm.pitch = lerp(rightArm.pitch, ANIM.AirArmPitch, air * (1 - aim))
		torso.pitch = lerp(torso.pitch, ANIM.LeanForward * 0.5, air)
		bobY = 0
	end

	if vault &gt; 0 then
		-- One leg swings over, the other trails, arms reach forward.
		leftLeg.pitch = lerp(leftLeg.pitch, ANIM.VaultLegPitch, vault)
		rightLeg.pitch = lerp(rightLeg.pitch, -ANIM.VaultLegPitch * 0.5, vault)
		leftArm.pitch = lerp(leftArm.pitch, ANIM.VaultArmPitch, vault)
		rightArm.pitch = lerp(rightArm.pitch, ANIM.VaultArmPitch, vault)
		torso.pitch = lerp(torso.pitch, ANIM.LeanForward, vault)
		bobY = 0
	end

	-- ------------------------------------------------------------------
	-- Head: stabilise against torso motion so the gaze stays level.
	-- ------------------------------------------------------------------
	head.pitch = -torso.pitch * ANIM.HeadStabilise
	head.yaw = -torso.yaw * ANIM.HeadStabilise
	head.roll = -torso.roll * ANIM.HeadStabilise

	local pose = {
		root = root,
		torso = torso,
		head = head,
		leftArm = leftArm,
		rightArm = rightArm,
		leftLeg = leftLeg,
		rightLeg = rightLeg,
		offset = Vector3.new(bobX, bobY - drop, 0),
		phase = phase,
		moving = moving,
	}

	return pose
end

--- Smoothly moves a set of stance weights toward a target set. Called once
--- per frame by the animator so stance changes ease instead of snapping.
function AnimationSystem.blendWeights(current, target, dt: number, speed: number?)
	local alpha = 1 - math.exp(-(speed or ANIM.BlendSpeed) * dt)
	for key in pairs(AnimationSystem.EMPTY_WEIGHTS) do
		local from = current[key] or 0
		local to = target[key] or 0
		current[key] = from + (to - from) * alpha
	end
	return current
end

return AnimationSystem
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX2"><Properties><string name="Name">Config</string><ProtectedString name="Source">--!strict
--[[
	Config
	Central tuning table for the TLoU-style mechanics pack.
	Every value here is data only - no logic - so designers can tweak
	feel without touching controllers.
]]

local Config = {}

-- Movement -------------------------------------------------------------
Config.Movement = {
	WalkSpeed = 14,
	RunSpeed = 22,
	CrouchSpeed = 7,
	ProneSpeed = 3,
	SprintSpeed = 24,

	JumpPower = 42,

	-- Stamina is a 0..100 resource.
	MaxStamina = 100,
	StaminaDrainSprint = 14, -- per second
	StaminaDrainJump = 12, -- flat cost
	StaminaRegen = 10, -- per second
	StaminaRegenDelay = 1.1, -- seconds after last drain
	ExhaustedThreshold = 5, -- cannot sprint below this

	-- Lean / peek
	LeanAngle = 18, -- degrees
	LeanSpeed = 9,
	LeanOffset = 1.4, -- studs sideways camera shift

	-- Vault / climb
	VaultMinHeight = 2.5,
	VaultMaxHeight = 7,
	VaultSpeed = 22,
	ClimbSpeed = 16,

	-- How fast the body yaws toward the camera. The TLoU character turns
	-- with weight, so this is deliberately not instant.
	TurnSpeed = 9,
	TurnSpeedAiming = 14,
}

-- Camera ---------------------------------------------------------------
Config.Camera = {
	-- Over-the-shoulder third person, the way TLoU frames combat.
	ThirdPerson = true,
	ShoulderOffset = Vector3.new(1.7, 1.7, 0), -- right, up, forward
	AimOffset = Vector3.new(1.15, 1.5, 0),
	Distance = 4.6,
	AimDistance = 2.5,
	MinDistance = 1.2,

	FOV = 76,
	AimFOV = 50,
	SprintFOV = 84,
	FOVLerp = 7,

	BobFrequency = 8.5,
	BobAmplitude = 0.12,
	SwayAmount = 0.55,
	SwaySmoothing = 6,

	RecoilKick = 1.5, -- degrees per shot
	RecoilRecovery = 9,
	MaxRecoil = 6,

	MinPitch = -70,
	MaxPitch = 70,

	-- The camera pivots around this point on the character, in studs above
	-- the root. R6 torsos are 2 tall, so the eyes sit near the top.
	PivotHeight = 1.5,
}

-- Animation ------------------------------------------------------------
-- All of this drives our own R6 animator (Motor6D.Transform). No asset
-- ids are involved, so it works in any place with no upload step.
Config.Animation = {
	Enabled = true,

	-- Stride: the walk cycle advances with distance travelled, so the feet
	-- do not skate. StrideLength is the studs covered by one full cycle
	-- (two steps).
	StrideLength = 6.0,
	SprintStrideBoost = 1.25, -- feet cycle faster than the body when sprinting

	-- Amplitudes in degrees.
	LegSwing = 40,
	RunLegSwing = 58,
	ArmSwing = 24,
	RunArmSwing = 40,
	TorsoYaw = 6, -- shoulders counter-rotate against the hips
	TorsoRoll = 3,
	LeanForward = 7, -- torso pitch while sprinting
	HeadStabilise = 0.55, -- how much the head counter-rotates

	-- Vertical bob, in studs.
	BobAmplitude = 0.13,
	BobLateral = 0.05,

	-- Turn-in-place: stepping feet when the body yaws without moving.
	TurnStepSwing = 24,
	TurnStepRate = 0.9, -- steps per radian of turn
	TurnMinSpeed = 0.6, -- below this movement speed, turning steps play
	TurnDeadzone = 0.12, -- radians/sec before stepping starts

	-- Idle breathing.
	IdleBreath = 1.6, -- cycles per second
	IdleBreathAmp = 1.2, -- degrees of torso pitch

	-- Poses.
	BlendSpeed = 9, -- how fast we blend between stance poses
	AimArmPitch = 78, -- arms raised to hold the weapon
	AimArmYaw = 12,
	-- Low ready: weapon carried at the hip, not raised to the eye. This is
	-- the resting pose whenever something is held, and it is what makes a
	-- third-person character read as &quot;armed&quot; while walking.
	ReadyArmPitch = 34,
	ReadyArmYaw = 8,
	ReadyLeftArmPitch = 44,
	CrouchTorsoPitch = 24,
	CrouchLegPitch = 26,
	CrouchDrop = 0.7, -- torso lowered, in studs
	ProneTorsoPitch = 70,
	ProneLegPitch = -62,
	ProneDrop = 1.45,
	ProneArmPitch = 84,

	-- Vault / climb pose.
	VaultLegPitch = 46,
	VaultArmPitch = 62,

	-- Jump / fall.
	AirLegPitch = 26,
	AirArmPitch = 20,
}

-- Rig ------------------------------------------------------------------
-- The pack targets the classic R6 body: six parts, six joints, simple
-- animation maths, and the blocky silhouette TLoU's survivors have.
Config.Rig = {
	ForceR6 = true, -- the place is generated as R6 and the server enforces it
	RebuildIfNotR6 = true, -- swap in a canonical R6 rig if the player is R15
	DisableDefaultAnimate = true, -- Roblox's Animate script would fight ours

	-- Classic R6 part sizes (studs).
	HeadSize = Vector3.new(2, 1, 1),
	TorsoSize = Vector3.new(2, 2, 1),
	LimbSize = Vector3.new(1, 2, 1),
	RootSize = Vector3.new(2, 2, 1),

	-- Fallback rig palette, used only when we have to build a body.
	BodyColor = Color3.fromRGB(224, 178, 150),
	ShirtColor = Color3.fromRGB(72, 78, 66),
	PantsColor = Color3.fromRGB(58, 54, 48),
}

-- Combat ---------------------------------------------------------------
Config.Combat = {
	HeadshotMultiplier = 2.5,
	LimbMultiplier = 0.75,
	MaxRange = 400,

	HitScanStepStuds = 0.6, -- raycast resolution for hit verification
	FriendlyFire = false,

	BleedOutTime = 12,
	DownedHealth = 100,
	DownedReviveTime = 3.5,
	MaxHealth = 100,

	-- Noise made by actions, drives stealth AI interest
	Noise = {
		Walk = 8,
		Run = 26,
		Sprint = 40,
		Crouch = 2,
		Prone = 0,
		Gunshot = 120,
		Silenced = 18,
		Melee = 12,
	},
}

-- Inventory ------------------------------------------------------------
Config.Inventory = {
	MaxSlots = 4,
	MaxThrowables = 3,
	SwapTime = 0.45,
	DropOnDeath = true,
}

-- Input ----------------------------------------------------------------
Config.Keys = {
	Fire = Enum.UserInputType.MouseButton1,
	Aim = Enum.UserInputType.MouseButton2,
	Reload = Enum.KeyCode.R,
	Melee = Enum.KeyCode.F,
	Throw = Enum.KeyCode.G,
	Sprint = Enum.KeyCode.LeftShift,
	Crouch = Enum.KeyCode.LeftControl,
	Prone = Enum.KeyCode.Z,
	LeanLeft = Enum.KeyCode.Q,
	LeanRight = Enum.KeyCode.E,
	Swap = Enum.KeyCode.Tab,
	Heal = Enum.KeyCode.H,
}

-- Visual ---------------------------------------------------------------
Config.Visual = {
	MuzzleFlashTime = 0.045,
	TracerTime = 0.06,
	HitDecalLifetime = 12,
	BloodTime = 0.5,
	ShellEjectSpeed = 18,
	CameraShakeIntensity = 0.6,
}

return Config
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX3"><Properties><string name="Name">Net</string><ProtectedString name="Source">--!strict
--[[
	Net
	Thin wrapper over a folder of RemoteEvents. The server creates them
	on demand; the client waits for them. This keeps the wire protocol in
	one place instead of scattered Instance lookups.
]]

local RunService = game:GetService(&quot;RunService&quot;)
local ReplicatedStorage = game:GetService(&quot;ReplicatedStorage&quot;)

local IS_SERVER = RunService:IsServer()

local EVENTS = {
	&quot;Ready&quot;, -- client -&gt; server: client finished loading, resend state
	&quot;Fire&quot;, -- client -&gt; server: request shot
	&quot;FireResult&quot;, -- server -&gt; client: confirmed shot (for tracer/recoil)
	&quot;Reload&quot;, -- client -&gt; server
	&quot;ReloadResult&quot;, -- server -&gt; client
	&quot;Swap&quot;, -- client -&gt; server
	&quot;SwapResult&quot;, -- server -&gt; client
	&quot;Melee&quot;, -- client -&gt; server
	&quot;Throw&quot;, -- client -&gt; server
	&quot;StateUpdate&quot;, -- client -&gt; server: movement state (crouch/lean/etc.)
	&quot;HitFeedback&quot;, -- server -&gt; client: damage numbers / hitmarker
	&quot;Health&quot;, -- server -&gt; client: health &amp; downed state
	&quot;Noise&quot;, -- server -&gt; client: noise ping for stealth UI
	&quot;Effect&quot;, -- server -&gt; all: cosmetic effect request
	&quot;Inventory&quot;, -- server -&gt; client: authoritative inventory sync
	&quot;Heal&quot;, -- client -&gt; server
}

local Net = {}

local folder: Folder

if IS_SERVER then
	folder = ReplicatedStorage:FindFirstChild(&quot;TLoUNet&quot;) :: Folder
	if not folder then
		folder = Instance.new(&quot;Folder&quot;)
		folder.Name = &quot;TLoUNet&quot;
		folder.Parent = ReplicatedStorage
	end

	for _, name in ipairs(EVENTS) do
		if not folder:FindFirstChild(name) then
			local remote = Instance.new(&quot;RemoteEvent&quot;)
			remote.Name = name
			remote.Parent = folder
		end
	end
else
	folder = ReplicatedStorage:WaitForChild(&quot;TLoUNet&quot;) :: Folder
end

function Net.get(name: string): RemoteEvent
	local remote = folder:WaitForChild(name, 10)
	assert(remote, &quot;Missing RemoteEvent: &quot; .. name)
	return remote :: RemoteEvent
end

-- Convenience: server -&gt; one player
function Net.toPlayer(player: Player, name: string, ...)
	Net.get(name):FireClient(player, ...)
end

-- Convenience: server -&gt; everyone
function Net.toAll(name: string, ...)
	Net.get(name):FireAllClients(...)
end

-- Convenience: client -&gt; server
function Net.toServer(name: string, ...)
	Net.get(name):FireServer(...)
end

return Net
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX4"><Properties><string name="Name">R6Rig</string><ProtectedString name="Source">--!strict
--[[
	R6Rig
	Everything about the classic R6 body in one place: the six parts, the
	six Motor6D joints, their canonical offsets, and the maths that turns a
	pose (degrees, in character space) into a joint rotation.

	Pose convention
	---------------
	Angles are authored in *character space*, where
	    X = right, Y = up, Z = back (Roblox's forward is -Z).

	* pitch  rotation about X. For a limb that hangs down, positive swings
	         the far end forward. For the torso and head, which point up,
	         positive would tilt them backward - so the sign is flipped for
	         those two joints, and &quot;positive pitch&quot; always means &quot;lean or
	         look forward&quot; everywhere in the pack.
	* yaw    rotation about Y (turn).
	* roll   rotation about Z (tilt sideways).

	The joints
	----------
	    HumanoidRootPart --RootJoint-- Torso
	    Torso --Neck-- Head
	    Torso --Left/Right Shoulder-- Left/Right Arm
	    Torso --Left/Right Hip-- Left/Right Leg

	Because an R6 limb is an axis-aligned box whose local axes line up with
	the torso's, rotating a limb is just a rotation about the matching
	character axis. That is why this module can stay small.
]]

local Config = require(script.Parent.Config)

local R6Rig = {}

local RAD = math.pi / 180

-- Rotation matrices for the canonical R6 joints, as the 9 numbers that
-- CFrame.new takes after the position (R00 R01 R02 R10 R11 R12 R20 R21 R22).
local NECK_R = { -1, 0, 0, 0, 0, 1, 0, 1, 0 }
local LEFT_R = { 0, 0, -1, 0, 1, 0, 1, 0, 0 }
local RIGHT_R = { 0, 0, 1, 0, 1, 0, -1, 0, 0 }

local function cf(px: number, py: number, pz: number, r): CFrame
	return CFrame.new(px, py, pz, r[1], r[2], r[3], r[4], r[5], r[6], r[7], r[8], r[9])
end

--- The canonical R6 skeleton. Order matters: parts are created in this
--- order so every parent exists before its children.
R6Rig.PARTS = {
	{ name = &quot;Head&quot;, size = Config.Rig.HeadSize },
	{ name = &quot;Torso&quot;, size = Config.Rig.TorsoSize },
	{ name = &quot;Left Arm&quot;, size = Config.Rig.LimbSize },
	{ name = &quot;Right Arm&quot;, size = Config.Rig.LimbSize },
	{ name = &quot;Left Leg&quot;, size = Config.Rig.LimbSize },
	{ name = &quot;Right Leg&quot;, size = Config.Rig.LimbSize },
}

--- Joint definitions. &quot;kind&quot; selects the pitch sign convention.
R6Rig.JOINTS = {
	{
		name = &quot;RootJoint&quot;,
		kind = &quot;torso&quot;,
		part0 = &quot;HumanoidRootPart&quot;,
		part1 = &quot;Torso&quot;,
		c0 = cf(0, 0, 0, NECK_R),
		c1 = cf(0, 0, 0, NECK_R),
	},
	{
		name = &quot;Neck&quot;,
		kind = &quot;head&quot;,
		part0 = &quot;Torso&quot;,
		part1 = &quot;Head&quot;,
		c0 = cf(0, 1, 0, NECK_R),
		c1 = cf(0, -0.5, 0, NECK_R),
	},
	{
		name = &quot;Left Shoulder&quot;,
		kind = &quot;limb&quot;,
		part0 = &quot;Torso&quot;,
		part1 = &quot;Left Arm&quot;,
		c0 = cf(-1, 0.5, 0, LEFT_R),
		c1 = cf(0.5, 0.5, 0, LEFT_R),
	},
	{
		name = &quot;Right Shoulder&quot;,
		kind = &quot;limb&quot;,
		part0 = &quot;Torso&quot;,
		part1 = &quot;Right Arm&quot;,
		c0 = cf(1, 0.5, 0, RIGHT_R),
		c1 = cf(-0.5, 0.5, 0, RIGHT_R),
	},
	{
		name = &quot;Left Hip&quot;,
		kind = &quot;limb&quot;,
		part0 = &quot;Torso&quot;,
		part1 = &quot;Left Leg&quot;,
		c0 = cf(-1, -1, 0, LEFT_R),
		c1 = cf(-0.5, 1, 0, LEFT_R),
	},
	{
		name = &quot;Right Hip&quot;,
		kind = &quot;limb&quot;,
		part0 = &quot;Torso&quot;,
		part1 = &quot;Right Leg&quot;,
		c0 = cf(1, -1, 0, RIGHT_R),
		c1 = cf(0.5, 1, 0, RIGHT_R),
	},
}

--- Which pose channel drives each joint. The root joint also carries the
--- torso twist, which is why it is handled specially in applyPose.
R6Rig.channelFor = {
	RootJoint = &quot;root&quot;,
	Neck = &quot;head&quot;,
	[&quot;Left Shoulder&quot;] = &quot;leftArm&quot;,
	[&quot;Right Shoulder&quot;] = &quot;rightArm&quot;,
	[&quot;Left Hip&quot;] = &quot;leftLeg&quot;,
	[&quot;Right Hip&quot;] = &quot;rightLeg&quot;,
}

--- Joint lookup by name, and the channel each joint reads, built once.
R6Rig.jointByName = {}
for _, joint in ipairs(R6Rig.JOINTS) do
	joint.channel = R6Rig.channelFor[joint.name]
	R6Rig.jointByName[joint.name] = joint
end

--- The pitch sign for a joint kind: limbs swing forward on positive pitch,
--- the upright parts (torso, head) lean forward on negative, so we flip
--- them here and the rest of the pack never has to think about it.
function R6Rig.pitchSign(kind: string): number
	return (kind == &quot;torso&quot; or kind == &quot;head&quot;) and -1 or 1
end

--- Builds the rotation to apply to a joint, from a pose channel.
function R6Rig.rotationFor(kind: string, pitch: number, yaw: number, roll: number): CFrame
	return CFrame.fromEulerAnglesYXZ(
		(pitch or 0) * R6Rig.pitchSign(kind) * RAD,
		(yaw or 0) * RAD,
		(roll or 0) * RAD
	)
end

--- True when an instance looks like a complete R6 character.
function R6Rig.isR6(character: Instance): boolean
	if not character or not character:IsA(&quot;Model&quot;) then
		return false
	end
	for _, part in ipairs(R6Rig.PARTS) do
		local child = character:FindFirstChild(part.name)
		if not child or not child:IsA(&quot;BasePart&quot;) then
			return false
		end
	end
	-- Joints are not direct children of the character in R6: RootJoint
	-- lives under HumanoidRootPart and the rest under Torso. Search the
	-- whole model so both layouts are accepted.
	for _, joint in ipairs(R6Rig.JOINTS) do
		local child = character:FindFirstChild(joint.name, true)
		if not child or not child:IsA(&quot;Motor6D&quot;) then
			return false
		end
	end
	return true
end

--- Every R6 Motor6D joint on a character, by name.
function R6Rig.collectJoints(character: Instance): { [string]: Motor6D }
	local found = {}
	for _, joint in ipairs(R6Rig.JOINTS) do
		local child = character:FindFirstChild(joint.name, true)
		if child and child:IsA(&quot;Motor6D&quot;) then
			found[joint.name] = child
		end
	end
	return found
end

--- Applies a pose to a character's rig.
--- `pose` is the table AnimationSystem.computePose returns.
---
--- We write Motor6D.Transform rather than C0. Transform is an extra
--- transform composed on top of C0/C1, and it is what it exists for:
--- * it is not replicated, so every client can pose every character
---   independently without the server seeing a stream of joint writes;
--- * it leaves C0/C1 as the rig's rest pose, so the character returns to
---   rest the moment we stop, with nothing to restore;
--- * it does not move the parts physically, so it cannot fight the
---   Humanoid's own physics or make the character fall over.
function R6Rig.applyPose(character: Instance, pose)
local joints = R6Rig.collectJoints(character)
for _, joint in ipairs(R6Rig.JOINTS) do
local motor = joints[joint.name]
if motor then
local channel = pose[joint.channel]
if channel then
motor.Transform = R6Rig.rotationFor(joint.kind, channel.pitch, channel.yaw, channel.roll)
end
end
end

-- The root joint carries the torso twist as well as the vertical offset
-- (bob, crouch and prone drop). Applying the offset here keeps the drop
-- in the joint rather than moving the character, so the physics stays
-- honest and the silhouette still lowers.
local rootMotor = joints.RootJoint
if rootMotor and pose.root and pose.torso then
local joint = R6Rig.jointByName.RootJoint
local rotation = R6Rig.rotationFor(
joint.kind,
(pose.root.pitch or 0) + (pose.torso.pitch or 0),
(pose.root.yaw or 0) + (pose.torso.yaw or 0),
(pose.root.roll or 0) + (pose.torso.roll or 0)
)
local offset = pose.offset or Vector3.new(0, 0, 0)
rootMotor.Transform = CFrame.new(offset) * rotation
end
end

--- Returns every joint to its rest pose by clearing the transform.
function R6Rig.resetPose(character: Instance)
for _, motor in pairs(R6Rig.collectJoints(character)) do
motor.Transform = CFrame.new()
end
end

--- Builds a canonical R6 character. Used to replace an R15 body, and by the
--- test harness to exercise the pose maths without a Roblox runtime.
function R6Rig.build(name: string): Model
	local model = Instance.new(&quot;Model&quot;)
	model.Name = name or &quot;R6Rig&quot;

	local root = Instance.new(&quot;Part&quot;)
	root.Name = &quot;HumanoidRootPart&quot;
	root.Size = Config.Rig.RootSize
	root.Transparency = 1
	root.CanCollide = false
	root.Parent = model
	model.PrimaryPart = root

	local torso = Instance.new(&quot;Part&quot;)
	torso.Name = &quot;Torso&quot;
	torso.Size = Config.Rig.TorsoSize
	torso.Color = Config.Rig.ShirtColor
	torso.Parent = model

	local head = Instance.new(&quot;Part&quot;)
	head.Name = &quot;Head&quot;
	head.Size = Config.Rig.HeadSize
	head.Color = Config.Rig.BodyColor
	head.Parent = model

	for _, limbName in ipairs({ &quot;Left Arm&quot;, &quot;Right Arm&quot;, &quot;Left Leg&quot;, &quot;Right Leg&quot; }) do
		local limb = Instance.new(&quot;Part&quot;)
		limb.Name = limbName
		limb.Size = Config.Rig.LimbSize
		limb.Color = (limbName:find(&quot;Leg&quot;) and Config.Rig.PantsColor) or Config.Rig.BodyColor
		limb.Parent = model
	end

	local humanoid = Instance.new(&quot;Humanoid&quot;)
	humanoid.RigType = Enum.HumanoidRigType.R6
	humanoid.Parent = model

	for _, joint in ipairs(R6Rig.JOINTS) do
		local motor = Instance.new(&quot;Motor6D&quot;)
		motor.Name = joint.name
		motor.Part0 = model:FindFirstChild(joint.part0)
		motor.Part1 = model:FindFirstChild(joint.part1)
		motor.C0 = joint.c0
		motor.C1 = joint.c1
		motor.Parent = model:FindFirstChild(joint.part0)
	end

	return model
end

--- Rebuilds a character as R6 in place, keeping its position and identity.
--- Returns the new model, or nil if the swap could not be done.
function R6Rig.convertToR6(character: Model): Model?
	local humanoid = character:FindFirstChildOfClass(&quot;Humanoid&quot;)
	local root = character:FindFirstChild(&quot;HumanoidRootPart&quot;)
	if not humanoid or not root or not root:IsA(&quot;BasePart&quot;) then
		return nil
	end

	local player = game:GetService(&quot;Players&quot;):GetPlayerFromCharacter(character)
	local rig = R6Rig.build(player and player.Name or character.Name)

	local newRoot = rig:FindFirstChild(&quot;HumanoidRootPart&quot;) :: BasePart
	local newHumanoid = rig:FindFirstChildOfClass(&quot;Humanoid&quot;) :: Humanoid

	-- Carry over everything that defines who this character is.
	newRoot.CFrame = root.CFrame
	newHumanoid.WalkSpeed = humanoid.WalkSpeed
	newHumanoid.JumpPower = humanoid.JumpPower
	newHumanoid.UseJumpPower = humanoid.UseJumpPower
	newHumanoid.AutoRotate = humanoid.AutoRotate
	newHumanoid.MaxHealth = humanoid.MaxHealth
	newHumanoid.Health = humanoid.Health
	newHumanoid.BreakJointsOnDeath = humanoid.BreakJointsOnDeath
	newHumanoid.HipHeight = humanoid.HipHeight

	rig.Parent = character.Parent
	if player then
		player.Character = rig
	end
	character:Destroy()

	return rig
end

--- The yaw (rotation about world up) of a CFrame, in radians.
function R6Rig.yawOf(cframe: CFrame): number
	local look = cframe.LookVector
	return math.atan2(-look.X, -look.Z)
end

--- Shortest signed difference between two angles, in radians.
function R6Rig.angleDelta(from: number, to: number): number
	return math.atan2(math.sin(to - from), math.cos(to - from))
end

return R6Rig
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX5"><Properties><string name="Name">Util</string><ProtectedString name="Source">--!strict
--[[
	Util
	Shared helpers used by both server and client controllers.
]]

local Players = game:GetService(&quot;Players&quot;)

local Util = {}

local HEAD_NAMES = { Head = true }
local LIMB_NAMES = { [&quot;Left Arm&quot;] = true, [&quot;Right Arm&quot;] = true, [&quot;Left Leg&quot;] = true, [&quot;Right Leg&quot;] = true, [&quot;LeftHand&quot;] = true, [&quot;RightHand&quot;] = true, [&quot;LeftFoot&quot;] = true, [&quot;RightFoot&quot;] = true }

--- Returns the body-part category for a hit part: &quot;Head&quot; | &quot;Limb&quot; | &quot;Torso&quot;
function Util.partCategory(part: BasePart): string
	local name = part.Name
	if HEAD_NAMES[name] then
		return &quot;Head&quot;
	elseif LIMB_NAMES[name] then
		return &quot;Limb&quot;
	end
	return &quot;Torso&quot;
end

--- Applies the right damage multiplier for a hit location.
function Util.locationMultiplier(part: BasePart, headMul: number, limbMul: number): number
	local cat = Util.partCategory(part)
	if cat == &quot;Head&quot; then
		return headMul
	elseif cat == &quot;Limb&quot; then
		return limbMul
	end
	return 1
end

--- Walks up from an instance to the player who owns the character, if any.
function Util.playerFromPart(part: BasePart?): (Player?, Model?)
	if not part then
		return nil, nil
	end
	local character = part:FindFirstAncestorOfClass(&quot;Model&quot;)
	while character do
		local humanoid = character:FindFirstChildOfClass(&quot;Humanoid&quot;)
		if humanoid then
			local player = Players:GetPlayerFromCharacter(character)
			return player, character
		end
		character = character:FindFirstAncestorOfClass(&quot;Model&quot;)
	end
	return nil, nil
end

--- Deep-copies a table (arrays/maps of primitives and nested tables).
function Util.deepCopy&lt;T&gt;(source: T): T
	if type(source) ~= &quot;table&quot; then
		return source
	end
	local copy = {}
	for key, value in pairs(source :: any) do
		copy[key] = Util.deepCopy(value)
	end
	return copy :: T
end

--- Linearly interpolates between two Vector3s.
function Util.lerpVector(a: Vector3, b: Vector3, alpha: number): Vector3
	return a + (b - a) * alpha
end

--- Frame-rate independent smoothing factor.
function Util.damp(deltaTime: number, speed: number): number
	return 1 - math.exp(-speed * deltaTime)
end

--- Clamps a number between min and max.
function Util.clamp(value: number, min: number, max: number): number
	return math.max(min, math.min(max, value))
end

--- Converts a mouse/keyboard keycode list into a readable prompt.
function Util.keyLabel(key: Enum.KeyCode): string
	return key.Name
end

return Util
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX6"><Properties><string name="Name">WeaponModels</string><ProtectedString name="Source">--!strict
--[[
	WeaponModels
	Builds every weapon out of plain Parts at runtime. No imported meshes,
	no asset ids - so the pack drops into any place and works immediately.
	The same builder is used for the world models and for anything welded to
	a character's hand, which keeps them consistent.

	Conventions
	-----------
	* The weapon points along its local -Z, which is Roblox's forward.
	* &quot;Handle&quot; is the receiver and the model's PrimaryPart. Everything else
	  is welded to it, so the whole model moves as one rigid unit and can be
	  attached to a hand with a single weld.
	* &quot;Muzzle&quot; is an invisible part sitting exactly at the barrel (or
	  suppressor) tip. Effects anchor to it, so its position must match the
	  visible barrel end - a mismatch is what makes a muzzle flash appear
	  inside the gun.

	Part orientation notes
	----------------------
	A Part with Shape = Cylinder runs along its local X axis. To lay a
	barrel along -Z it is rotated 90 degrees about Y; to stand a bottle up
	it is rotated 90 degrees about Z. Getting this wrong is the classic
	&quot;cylinder points the wrong way&quot; bug, so every cylinder here goes
	through the helpers below rather than being rotated inline.
]]

local Weapons = require(script.Parent.Weapons)

local WeaponModels = {}

local DEFAULT_METAL = Enum.Material.Metal
local DEFAULT_POLYMER = Enum.Material.Polymer

local function materialFor(visual): Enum.Material
	return visual.woodFurniture and Enum.Material.Wood or DEFAULT_POLYMER
end

--- Creates a part parented to the model. Never collidable, never queryable:
--- a weapon must not block movement or soak up its own raycasts.
local function newPart(
	model: Model,
	name: string,
	size: Vector3,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?
): Part
	local p = Instance.new(&quot;Part&quot;)
	p.Name = name
	p.Size = size
	p.Shape = shape or Enum.PartType.Block
	p.Color = color
	p.Material = material or DEFAULT_METAL
	p.TopSurface = Enum.SurfaceType.Smooth
	p.BottomSurface = Enum.SurfaceType.Smooth
	p.CanCollide = false
	p.CanQuery = false
	p.Massless = true
	p.Parent = model
	return p
end

--- Welds a part to the handle at a fixed offset from it. The offset is
--- relative to the handle, so the whole weapon is defined in one frame.
local function weldTo(handle: BasePart, part: BasePart, offset: CFrame)
	part.CFrame = handle.CFrame * offset
	local weld = Instance.new(&quot;WeldConstraint&quot;)
	weld.Part0 = handle
	weld.Part1 = part
	weld.Parent = part
end

--- A part welded to the handle in one call.
local function piece(
	model: Model,
	handle: BasePart,
	name: string,
	size: Vector3,
	offset: CFrame,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?
): Part
	local p = newPart(model, name, size, color, material, shape)
	weldTo(handle, p, offset)
	return p
end

--- A cylinder lying along the weapon's forward (-Z) axis. Size is
--- (length, diameter, diameter).
local function barrelPiece(
	model: Model,
	handle: BasePart,
	name: string,
	length: number,
	diameter: number,
	offset: CFrame,
	color: Color3,
	material: Enum.Material?
): Part
	local size = Vector3.new(length, diameter, diameter)
	local oriented = offset * CFrame.Angles(0, math.rad(90), 0)
	return piece(model, handle, name, size, oriented, color, material, Enum.PartType.Cylinder)
end

--- A cylinder standing along the weapon's up (+Y) axis. Size is
--- (height, diameter, diameter).
local function uprightPiece(
	model: Model,
	handle: BasePart,
	name: string,
	height: number,
	diameter: number,
	offset: CFrame,
	color: Color3,
	material: Enum.Material?,
	shape: Enum.PartType?
): Part
	local size = Vector3.new(height, diameter, diameter)
	local oriented = offset * CFrame.Angles(0, 0, math.rad(90))
	return piece(model, handle, name, size, oriented, color, material, shape or Enum.PartType.Cylinder)
end

--- The invisible anchor effects fire from. It must sit at the very tip of
--- whatever is at the front of the gun.
local function addMuzzle(model: Model, handle: BasePart, tipZ: number): Part
	local muzzle = newPart(model, &quot;Muzzle&quot;, Vector3.new(0.14, 0.14, 0.14), Color3.fromRGB(255, 255, 255), DEFAULT_METAL)
	muzzle.Transparency = 1
	weldTo(handle, muzzle, CFrame.new(0, 0, tipZ))
	muzzle:SetAttribute(&quot;IsMuzzle&quot;, true)
	return muzzle
end

-- ---------------------------------------------------------------------
-- Firearms
-- ---------------------------------------------------------------------

--- The common furniture shared by rifles, SMGs and shotguns.
local function addStock(model, handle, visual, color, zBack: number)
	if not visual.stock then
		return
	end
	local stock = piece(
		model,
		handle,
		&quot;Stock&quot;,
		Vector3.new(0.26, 0.34, 0.55),
		CFrame.new(0, -0.04, zBack),
		color,
		materialFor(visual)
	)
	-- A small comb on top of the stock reads as a cheek rest.
	piece(model, handle, &quot;CheekRest&quot;, Vector3.new(0.2, 0.1, 0.4), CFrame.new(0, 0.16, zBack), color, materialFor(visual))
	return stock
end

local function addGrip(model, handle, visual, color, z: number)
	piece(
		model,
		handle,
		&quot;Grip&quot;,
		Vector3.new(0.2, 0.46, 0.22),
		CFrame.new(0, -0.42, z) * CFrame.Angles(math.rad(12), 0, 0),
		color,
		materialFor(visual)
	)
	piece(model, handle, &quot;Trigger&quot;, Vector3.new(0.07, 0.14, 0.05), CFrame.new(0, -0.28, z - 0.16), Color3.fromRGB(30, 30, 32), DEFAULT_METAL)
end

local function addMagazine(model, handle, visual, color, size: Vector3, z: number, tilt: number)
	return piece(
		model,
		handle,
		&quot;Magazine&quot;,
		size,
		CFrame.new(0, -(size.Y * 0.5 + 0.16), z) * CFrame.Angles(math.rad(tilt), 0, 0),
		color,
		DEFAULT_METAL
	)
end

local function addSights(model, handle, frontZ: number, rearZ: number, top: number)
	piece(model, handle, &quot;RearSight&quot;, Vector3.new(0.14, 0.09, 0.06), CFrame.new(0, top, rearZ), Color3.fromRGB(20, 20, 22), DEFAULT_METAL)
	piece(model, handle, &quot;FrontSight&quot;, Vector3.new(0.05, 0.11, 0.05), CFrame.new(0, top, frontZ), Color3.fromRGB(20, 20, 22), DEFAULT_METAL)
end

local function addScope(model, handle, visual, top: number, z: number)
	if not visual.scope or visual.scope == &quot;none&quot; then
		return
	end
	local large = visual.scope == &quot;large&quot;
	local length = large and 1.15 or 0.6
	barrelPiece(model, handle, &quot;Scope&quot;, length, 0.22, CFrame.new(0, top + 0.14, z), Color3.fromRGB(18, 18, 20), DEFAULT_METAL)
	if large then
		barrelPiece(
			model,
			handle,
			&quot;Lens&quot;,
			0.06,
			0.17,
			CFrame.new(0, top + 0.14, z - length * 0.5),
			Color3.fromRGB(70, 140, 180),
			Enum.Material.Glass
		).Transparency = 0.35
	end
end

local function addBolt(model, handle, visual, data, z: number)
	if data.fireMode ~= &quot;Bolt&quot; and data.fireMode ~= &quot;Auto&quot; then
		return
	end
	piece(model, handle, &quot;Bolt&quot;, Vector3.new(0.14, 0.14, 0.44), CFrame.new(0.17, 0.06, z), data.visual.accentColor, DEFAULT_METAL)
end

--- Builds a long gun. `profile` carries the few numbers that differ
--- between a rifle, an SMG and a shotgun.
local function buildLongGun(model: Model, handle: BasePart, data, profile)
	local visual = data.visual
	local L = visual.length
	local bodyColor = visual.bodyColor
	local accent = visual.accentColor
	local furniture = materialFor(visual)

	local receiverLength = L * profile.receiver
	local receiverZ = -L * 0.06
	handle.Size = Vector3.new(0.2, 0.28, receiverLength)
	handle.Color = bodyColor
	handle.Material = furniture
	handle.CFrame = CFrame.new()

	piece(model, handle, &quot;Receiver&quot;, Vector3.new(0.24, 0.3, receiverLength), CFrame.new(0, 0, receiverZ), bodyColor, furniture)
	-- Handguard along the barrel.
	local guardLength = L * profile.guard
	local guardZ = receiverZ - receiverLength * 0.5 - guardLength * 0.5
	piece(model, handle, &quot;Handguard&quot;, Vector3.new(0.22, 0.22, guardLength), CFrame.new(0, 0.02, guardZ), accent, furniture)

	-- Barrel: starts at the front of the handguard and runs to the tip.
	local barrelLength = L * profile.barrel
	local barrelStart = guardZ - guardLength * 0.5
	local barrelZ = barrelStart - barrelLength * 0.5
	barrelPiece(model, handle, &quot;Barrel&quot;, barrelLength, profile.bore, CFrame.new(0, 0.02, barrelZ), bodyColor, DEFAULT_METAL)

	local tipZ = barrelStart - barrelLength
	if visual.suppressor then
		local supLength = L * 0.3
		barrelPiece(
			model,
			handle,
			&quot;Suppressor&quot;,
			supLength,
			profile.bore * 2.6,
			CFrame.new(0, 0.02, tipZ - supLength * 0.5),
			Color3.fromRGB(24, 24, 26),
			DEFAULT_METAL
		)
		tipZ = tipZ - supLength
	end

	if profile.pump then
		piece(
			model,
			handle,
			&quot;Pump&quot;,
			Vector3.new(0.26, 0.26, L * 0.2),
			CFrame.new(0, -0.13, guardZ - L * 0.02),
			accent,
			furniture
		)
		barrelPiece(model, handle, &quot;TubeMagazine&quot;, L * 0.42, 0.1, CFrame.new(0, -0.13, barrelZ + L * 0.05), bodyColor, DEFAULT_METAL)
	end

	if profile.magazine then
		addMagazine(model, handle, visual, accent, profile.magazine, receiverZ - receiverLength * 0.25, profile.magTilt or 0)
	end

	addStock(model, handle, visual, accent, receiverZ + receiverLength * 0.5 + 0.3)
	addGrip(model, handle, visual, accent, receiverZ + receiverLength * 0.3)
	addSights(model, handle, tipZ + L * 0.06, receiverZ + receiverLength * 0.4, 0.24)
	addScope(model, handle, visual, 0.24, receiverZ - L * 0.05)
	addBolt(model, handle, visual, data, receiverZ + L * 0.06)

	return tipZ
end

--- A pistol: short slide, angled grip, no stock.
local function buildPistol(model: Model, handle: BasePart, data)
	local visual = data.visual
	local L = visual.length
	local bodyColor = visual.bodyColor
	local accent = visual.accentColor

	local slideLength = L * 0.62
	handle.Size = Vector3.new(0.16, 0.2, slideLength)
	handle.Color = bodyColor
	handle.Material = DEFAULT_METAL
	handle.CFrame = CFrame.new()

	piece(model, handle, &quot;Slide&quot;, Vector3.new(0.18, 0.22, slideLength), CFrame.new(0, 0.02, -L * 0.08), bodyColor, DEFAULT_METAL)
	piece(model, handle, &quot;Frame&quot;, Vector3.new(0.16, 0.14, slideLength * 0.85), CFrame.new(0, -0.13, -L * 0.06), accent, DEFAULT_POLYMER)

	local barrelLength = L * 0.34
	local barrelZ = -L * 0.08 - slideLength * 0.5 - barrelLength * 0.5
	barrelPiece(model, handle, &quot;Barrel&quot;, barrelLength, 0.075, CFrame.new(0, 0.02, barrelZ), bodyColor, DEFAULT_METAL)

	local tipZ = barrelZ - barrelLength * 0.5
	if visual.suppressor then
		local supLength = L * 0.32
		barrelPiece(model, handle, &quot;Suppressor&quot;, supLength, 0.19, CFrame.new(0, 0.02, tipZ - supLength * 0.5), Color3.fromRGB(24, 24, 26), DEFAULT_METAL)
		tipZ = tipZ - supLength
	end

	piece(
		model,
		handle,
		&quot;Grip&quot;,
		Vector3.new(0.16, 0.44, 0.2),
		CFrame.new(0, -0.4, L * 0.12) * CFrame.Angles(math.rad(14), 0, 0),
		accent,
		DEFAULT_POLYMER
	)
	addMagazine(model, handle, visual, accent, Vector3.new(0.12, 0.4, 0.14), L * 0.12, 14)
	piece(model, handle, &quot;Trigger&quot;, Vector3.new(0.06, 0.12, 0.05), CFrame.new(0, -0.26, L * 0.02), Color3.fromRGB(30, 30, 32), DEFAULT_METAL)
	addSights(model, handle, tipZ + 0.05, -L * 0.08 + slideLength * 0.42, 0.18)

	return tipZ
end

--- A revolver: a rotating cylinder in front of the frame.
local function buildRevolver(model: Model, handle: BasePart, data)
	local visual = data.visual
	local L = visual.length
	local bodyColor = visual.bodyColor
	local accent = visual.accentColor

	handle.Size = Vector3.new(0.14, 0.18, L * 0.5)
	handle.Color = bodyColor
	handle.CFrame = CFrame.new()

	piece(model, handle, &quot;Frame&quot;, Vector3.new(0.16, 0.2, L * 0.42), CFrame.new(0, 0.02, -L * 0.02), bodyColor, DEFAULT_METAL)

	-- The cylinder is the revolver's signature: a fat drum in front of the
	-- frame, running along the barrel axis.
	local cylZ = -L * 0.24
	barrelPiece(model, handle, &quot;Cylinder&quot;, L * 0.2, 0.34, CFrame.new(0, 0.02, cylZ), Color3.fromRGB(58, 58, 62), DEFAULT_METAL)

	local barrelLength = L * 0.4
	local barrelZ = cylZ - L * 0.1 - barrelLength * 0.5
	barrelPiece(model, handle, &quot;Barrel&quot;, barrelLength, 0.09, CFrame.new(0, 0.02, barrelZ), bodyColor, DEFAULT_METAL)
	-- A vent rib on top of the barrel.
	piece(model, handle, &quot;Rib&quot;, Vector3.new(0.06, 0.05, barrelLength), CFrame.new(0, 0.12, barrelZ), bodyColor, DEFAULT_METAL)

	piece(
		model,
		handle,
		&quot;Grip&quot;,
		Vector3.new(0.16, 0.42, 0.22),
		CFrame.new(0, -0.36, L * 0.16) * CFrame.Angles(math.rad(18), 0, 0),
		accent,
		materialFor(visual)
	)
	piece(model, handle, &quot;Trigger&quot;, Vector3.new(0.06, 0.12, 0.05), CFrame.new(0, -0.24, L * 0.06), Color3.fromRGB(30, 30, 32), DEFAULT_METAL)

	local tipZ = barrelZ - barrelLength * 0.5
	addSights(model, handle, tipZ + 0.06, -L * 0.12, 0.16)
	return tipZ
end

--- A compound bow: two limbs along the character's up axis, a riser, and a
--- string between the limb tips.
local function buildBow(model: Model, handle: BasePart, data)
	local visual = data.visual
	local L = visual.length
	local bodyColor = visual.bodyColor
	local accent = visual.accentColor

	handle.Size = Vector3.new(0.12, 0.6, 0.14)
	handle.Color = accent
	handle.Material = Enum.Material.Wood
	handle.CFrame = CFrame.new()

	-- Riser: the part the hand holds, standing vertically.
	uprightPiece(model, handle, &quot;Riser&quot;, 0.7, 0.13, CFrame.new(0, 0, 0), accent, Enum.Material.Wood, Enum.PartType.Block)

	local limbLength = L * 0.62
	uprightPiece(model, handle, &quot;Limb&quot;, limbLength, 0.1, CFrame.new(0, 0.34 + limbLength * 0.5, -0.06), bodyColor, Enum.Material.Wood, Enum.PartType.Block)
	uprightPiece(model, handle, &quot;LimbLower&quot;, limbLength, 0.1, CFrame.new(0, -(0.34 + limbLength * 0.5), -0.06), bodyColor, Enum.Material.Wood, Enum.PartType.Block)

	-- The string runs between the limb tips, a little behind them.
	local stringHeight = limbLength * 2 + 0.7
	uprightPiece(model, handle, &quot;String&quot;, stringHeight, 0.03, CFrame.new(0, 0, -0.02), Color3.fromRGB(220, 220, 220), Enum.Material.SmoothPlastic, Enum.PartType.Block)

	-- Arrow rest and sight pin.
	piece(model, handle, &quot;ArrowRest&quot;, Vector3.new(0.1, 0.06, 0.2), CFrame.new(0, 0.06, -0.16), Color3.fromRGB(40, 40, 42), DEFAULT_METAL)
	piece(model, handle, &quot;SightPin&quot;, Vector3.new(0.06, 0.06, 0.2), CFrame.new(0.12, 0.18, -0.18), Color3.fromRGB(40, 40, 42), DEFAULT_METAL)

	-- The arrow sits where the muzzle would be: bows fire from the rest.
	return -0.5
end

-- ---------------------------------------------------------------------
-- Melee
-- ---------------------------------------------------------------------

local function buildBat(model: Model, handle: BasePart, data)
	local visual = data.visual
	local L = visual.length

	handle.Size = Vector3.new(0.14, 0.14, L * 0.34)
	handle.Color = visual.accentColor
	handle.Material = Enum.Material.Wood
	handle.CFrame = CFrame.new()

	-- The barrel of the bat is thicker than the grip and tapers forward.
	barrelPiece(model, handle, &quot;Blade&quot;, L * 0.62, 0.3, CFrame.new(0, 0, -(L * 0.17 + L * 0.31)), visual.bodyColor, Enum.Material.Wood)
	barrelPiece(model, handle, &quot;Knob&quot;, 0.08, 0.2, CFrame.new(0, 0, L * 0.19), visual.accentColor, Enum.Material.Wood)
	return -(L * 0.17 + L * 0.62)
end

local function buildMachete(model: Model, handle: BasePart, data)
	local visual = data.visual
	local L = visual.length

	handle.Size = Vector3.new(0.1, 0.12, L * 0.3)
	handle.Color = visual.accentColor
	handle.Material = Enum.Material.Wood
	handle.CFrame = CFrame.new()

	-- The blade is a flat slab: wide in Y, thin in X.
	local bladeLength = L * 0.66
	piece(model, handle, &quot;Blade&quot;, Vector3.new(0.05, 0.3, bladeLength), CFrame.new(0, 0.02, -(L * 0.15 + bladeLength * 0.5)), visual.bodyColor, DEFAULT_METAL)
	piece(model, handle, &quot;Guard&quot;, Vector3.new(0.16, 0.09, 0.1), CFrame.new(0, 0, -L * 0.15), visual.accentColor, DEFAULT_METAL)
	return -(L * 0.15 + bladeLength)
end

-- ---------------------------------------------------------------------
-- Throwables
-- ---------------------------------------------------------------------

local function buildBottle(model: Model, handle: BasePart, data)
	local visual = data.visual
	local height = visual.length
	handle.Size = Vector3.new(height, 0.3, 0.3)
	handle.Shape = Enum.PartType.Cylinder
	handle.Color = visual.bodyColor
	handle.Material = Enum.Material.Glass
	handle.Transparency = 0.35
	-- The cylinder's axis must point up, which is a rotation about Z.
	handle.CFrame = CFrame.Angles(0, 0, math.rad(90))

	uprightPiece(model, handle, &quot;Neck&quot;, height * 0.3, 0.14, CFrame.new(0, height * 0.5 + height * 0.15, 0), visual.bodyColor, Enum.Material.Glass)
	uprightPiece(model, handle, &quot;Rag&quot;, 0.26, 0.13, CFrame.new(0, height * 0.5 + height * 0.3 + 0.13, 0), visual.accentColor, Enum.Material.Fabric)
	return -height * 0.5
end

local function buildCanister(model: Model, handle: BasePart, data)
	local visual = data.visual
	local height = visual.length
	handle.Size = Vector3.new(height, 0.34, 0.34)
	handle.Shape = Enum.PartType.Cylinder
	handle.Color = visual.bodyColor
	handle.CFrame = CFrame.Angles(0, 0, math.rad(90))

	uprightPiece(model, handle, &quot;Cap&quot;, 0.1, 0.22, CFrame.new(0, height * 0.5 + 0.05, 0), visual.accentColor, DEFAULT_METAL, Enum.PartType.Block)
	piece(model, handle, &quot;Band&quot;, Vector3.new(0.36, 0.08, 0.36), CFrame.new(0, 0, 0), visual.accentColor, DEFAULT_METAL)
	return -height * 0.5
end

local function buildBrick(model: Model, handle: BasePart, data)
	local visual = data.visual
	local size = Vector3.new(0.34, 0.22, visual.length)
	handle.Size = size
	handle.Color = visual.bodyColor
	handle.Material = Enum.Material.Brick
	handle.CFrame = CFrame.new()
	return -visual.length * 0.5
end

-- ---------------------------------------------------------------------
-- Assembly
-- ---------------------------------------------------------------------

local LONG_GUN_PROFILES = {
	Rifle = {
		receiver = 0.5,
		guard = 0.24,
		barrel = 0.34,
		bore = 0.09,
		magazine = Vector3.new(0.16, 0.4, 0.2),
		magTilt = 0,
	},
	SMG = {
		receiver = 0.44,
		guard = 0.14,
		barrel = 0.22,
		bore = 0.07,
		magazine = Vector3.new(0.15, 0.5, 0.18),
		magTilt = 0,
	},
	Shotgun = {
		receiver = 0.42,
		guard = 0.3,
		barrel = 0.44,
		bore = 0.11,
		pump = true,
		magazine = nil,
	},
}

--- Builds the model. Returns a Model whose PrimaryPart is &quot;Handle&quot;.
function WeaponModels.build(data): Model
	local visual = data.visual
	local model = Instance.new(&quot;Model&quot;)
	model.Name = &quot;Weapon_&quot; .. data.id

	local handle = newPart(model, &quot;Handle&quot;, Vector3.new(0.2, 0.28, visual.length * 0.5), visual.bodyColor, DEFAULT_METAL)
	model.PrimaryPart = handle

	local tipZ = -visual.length * 0.5

	if data.category == &quot;Melee&quot; then
		if data.model == &quot;Bat&quot; then
			tipZ = buildBat(model, handle, data)
		else
			tipZ = buildMachete(model, handle, data)
		end
	elseif data.category == &quot;Throwable&quot; then
		if data.model == &quot;Bottle&quot; then
			tipZ = buildBottle(model, handle, data)
		elseif data.model == &quot;Canister&quot; then
			tipZ = buildCanister(model, handle, data)
		else
			tipZ = buildBrick(model, handle, data)
		end
	else
		-- Firearm
		if data.model == &quot;Pistol&quot; then
			tipZ = buildPistol(model, handle, data)
		elseif data.model == &quot;Revolver&quot; then
			tipZ = buildRevolver(model, handle, data)
		elseif data.model == &quot;Bow&quot; then
			tipZ = buildBow(model, handle, data)
		else
			local profile = LONG_GUN_PROFILES[data.model] or LONG_GUN_PROFILES.Rifle
			tipZ = buildLongGun(model, handle, data, profile)
		end
	end

	model:SetAttribute(&quot;WeaponId&quot;, data.id)
	model:SetAttribute(&quot;Category&quot;, data.category)

	-- Every weapon needs a Muzzle for flash/tracer anchoring, sitting at the
	-- actual tip of the model.
	local muzzle = addMuzzle(model, handle, tipZ)
	muzzle:SetAttribute(&quot;IsMuzzle&quot;, true)

	-- Attachment points for a character's hands in third person.
	local gripAttachment = Instance.new(&quot;Attachment&quot;)
	gripAttachment.Name = &quot;GripAttachment&quot;
	gripAttachment.Position = Vector3.new(0, -0.42, 0.12)
	gripAttachment.Parent = handle

	local leftAttachment = Instance.new(&quot;Attachment&quot;)
	leftAttachment.Name = &quot;LeftGripAttachment&quot;
	leftAttachment.Position = Vector3.new(0, -0.1, tipZ * 0.45)
	leftAttachment.Parent = handle

	return model
end

--- Convenience: build a model for a weapon id.
function WeaponModels.buildById(id: string): Model?
	local data = Weapons.get(id)
	if not data then
		return nil
	end
	return WeaponModels.build(data)
end

return WeaponModels
</ProtectedString></Properties></Item><Item class="ModuleScript" referent="RBX7"><Properties><string name="Name">Weapons</string><ProtectedString name="Source">--!strict
--[[
	Weapons
	Data table describing every weapon in the pack. The WeaponController
	and the procedural model builder both read from here, so adding a
	weapon is purely a data change.
]]

export type WeaponData = {
	id: string,
	name: string,
	category: string, -- &quot;Firearm&quot; | &quot;Melee&quot; | &quot;Throwable&quot;
	model: string, -- procedural model key

	damage: number,
	fireMode: string, -- &quot;Auto&quot; | &quot;Semi&quot; | &quot;Bolt&quot; | &quot;Pump&quot;
	rpm: number,
	magazine: number,
	reserveMax: number,
	reloadTime: number,
	bulletSpread: number, -- degrees at hip
	aimSpread: number, -- degrees when aiming
	recoil: number,
	range: number,
	pellets: number, -- &gt;1 for shotguns
	silenced: boolean,

	adsTime: number,
	raiseTime: number,

	-- Procedural visual parameters
	visual: {
		bodyColor: Color3,
		accentColor: Color3,
		length: number,
		stock: boolean,
		scope: string?, -- &quot;none&quot; | &quot;small&quot; | &quot;large&quot;
		suppressor: boolean,
		woodFurniture: boolean,
	},

	-- Melee only
	meleeSwing: number?,
	meleeDamage: number?,
	meleeRange: number?,
}

local Weapons: { [string]: WeaponData } = {}

local function gun(partial): WeaponData
	return partial :: any
end

-- Firearms ------------------------------------------------------------
